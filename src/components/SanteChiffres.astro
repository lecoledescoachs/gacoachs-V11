---
// Quatre chiffres officiels en anneaux : un coup d'oeil avant de lire. Sources citées et cliquables.
const stats = [
  { v: '48,8 %', p: 48.8, t: 'des adultes sont en surpoids ou obèses', d: 'dont 18,1 % en situation d\'obésité, soit près de 10 millions de personnes.', s: 'OFÉO, Ligue contre l\'obésité, 2024', u: 'https://www.gazettelabo.fr/diagnostic/385Obesite-France-OFEO-2024.html' },
  { v: '95 %', p: 95, t: 'des adultes sont exposés à un risque pour leur santé', d: 'par manque d\'activité physique ou trop de temps passé assis.', s: 'ANSES, 2022', u: 'https://www.anses.fr/fr/content/manque-dactivite-physique-et-exces-de-sedentarite-une-priorite-de-sante-publique' },
  { v: '4/5', p: 80, t: 'des personnes auront mal au dos au cours de leur vie', d: 'et le mal de dos coûte près de 900 millions d\'euros par an à l\'Assurance Maladie.', s: 'Assurance Maladie', u: 'https://rhumatologie.lequotidiendumedecin.fr/actus-medicales/politique-de-sante/lombalgies-la-cnam-cible-les-generalistes-et-le-grand-public-pour-prevenir-le-passage-la-chronicite' },
  { v: '4/10', p: 40, t: 'des cancers sont liés à nos habitudes de vie', d: 'dont le manque d\'activité physique, sur environ 433 000 nouveaux cas par an.', s: 'INCa', u: 'https://pediatrie.lequotidiendumedecin.fr/actu-medicale/40-des-cancers-pourraient-etre-evites-en-france' },
];
const { titre = 'Pourquoi bouger avec un coach', intro = 'Les chiffres officiels, en un coup d\'oeil.' } = Astro.props;
---
<section class="sec sch" aria-labelledby="sch-t">
  <div class="inner">
    <h2 class="h2" id="sch-t">{titre}</h2>
    <p class="sch-intro">{intro}</p>
    <ul class="sch-grid">
      {stats.map((s) => (
        <li class="sch-c">
          <div class="sch-ring" role="img" aria-label={`${s.v} ${s.t}`} style={`--p:${s.p}`}><b>{s.v}</b></div>
          <p class="sch-t">{s.t}</p>
          <p class="sch-d">{s.d}</p>
          <a class="sch-s" href={s.u} target="_blank" rel="noopener noreferrer">Source : {s.s}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sch-intro { margin: 6px 0 18px; color: #3E4A66; font-size: 16px; }
  .sch-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sch-c { background: #fff; border: 1px solid #DCE6FB; border-radius: 18px; padding: 16px 12px 8px; text-align: center; color: #13203B; display: flex; flex-direction: column; align-items: center; }
  .sch-ring { --p: 50; width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center;
    background: conic-gradient(#2F6BF0 calc(var(--p) * 1%), #E3EBFD 0); position: relative; margin-bottom: 10px; }
  .sch-ring::before { content: ''; position: absolute; inset: 11px; border-radius: 50%; background: #fff; }
  .sch-ring b { position: relative; font-size: 22px; color: #0B1E3D; font-family: var(--font-display); }
  .sch-t { margin: 0 0 4px; font-weight: 700; font-size: 15px; line-height: 1.3; color: #0B1E3D; }
  .sch-d { margin: 0 0 6px; font-size: 14px; line-height: 1.4; color: #3E4A66; }
  .sch-s { margin-top: auto; display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; color: #1F55C9; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 900px) { .sch-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } .sch-ring { width: 120px; height: 120px; } .sch-ring b { font-size: 26px; } }
</style>
