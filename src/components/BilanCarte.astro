    .bg-xp i { height: max(10px, 3cqw); }
    .bg-vp { margin-top: 4cqw; }
    .bg-lv { gap: 4cqw; }
    .bcard .bg-q { font-size: max(18px, 7cqw); }
    .bg-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.4cqw; padding-bottom: 1.6cqw; }
    .bg-t-salle { grid-template-columns: minmax(0, 1fr); }
    .bcard .bg-t-salle .bg-tile:nth-child(n):nth-last-child(n) { grid-column: auto; }
    .bcard .bg-t-salle .bg-tile { flex-direction: row; justify-content: flex-start; gap: 3cqw; padding: 0 4cqw; text-align: left; }
    .bg-t-dispo { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 27cqw; }
    .bg-lv[data-lv="contact"] { gap: 6.5cqw; }
    .bcard .bg-t-dispo .bg-tile:last-child:nth-child(odd) { grid-column: span 2; }
    .bcard .bg-t-dispo .bg-tile[aria-pressed="true"]::after { top: 2cqw; right: 2cqw; width: 6cqw; height: 6cqw; }
    .bcard .bg-q small { display: block; margin: 1.6cqw 0 0; font-size: max(11px, 3.3cqw); }
    .bcard .bg-tile { gap: 1.6cqw; border-radius: 3cqw; font-size: max(13px, 4.2cqw); box-shadow: 0 1.2cqw 0 var(--ciel2); }
    .bcard .bg-tile svg { width: 8cqw; height: 8cqw; }
    .bcard .bg-tile small { font-size: max(9px, 2.6cqw); }
    .bcard .bg-tile[aria-pressed="true"] { box-shadow: 0 1.2cqw 0 var(--nv2), 0 0 0 1cqw rgba(255, 255, 255, .75); }
    .bg-chips, .bg-via { gap: 3cqw; }
    .bcard .bg-chip { min-height: 12cqw; padding: 0 5cqw; font-size: max(14px, 4.4cqw); box-shadow: 0 1cqw 0 var(--ciel2); }
    .bcard .bg-ok, .bcard .bg-vote { min-height: 13cqw; padding: 0 6cqw; border-radius: 2.6cqw; font-size: max(11px, 3.2cqw); box-shadow: 0 1.2cqw 0 var(--nv2); }
    .bcard .bg-vote { box-shadow: 0 1.2cqw 0 var(--ciel2); }
    .bg-play { width: 3cqw; height: 3cqw; }
    .bc-line { grid-template-columns: 28cqw minmax(0, 1fr); }
    .bc-line > span { font-size: max(15px, 4.8cqw); }
    .bcard .bc-line input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]) { font-size: max(21px, 6.6cqw); }
    .bcard .bc-line input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"])::placeholder { font-size: max(12px, 3.6cqw); }
    .bg-bas { flex-direction: column; align-items: stretch; gap: 5cqw; }
    .bg-bas .bg-ok { align-self: flex-end; }
