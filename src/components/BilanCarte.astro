  .bcard .bg-perso { position: relative; width: 19cqw; display: flex; flex-direction: column; align-items: center; gap: .8cqw; padding: .8cqw .8cqw 1cqw; border: 0; border-radius: 1.6cqw; background: rgba(255, 255, 255, .22); color: var(--nv); font: 700 max(12px, 1.9cqw)/1.1 var(--bc-font); text-align: center; cursor: pointer; transition: transform .15s ease, background .15s ease, box-shadow .15s ease; }
