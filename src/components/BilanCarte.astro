  .bcard .bg-ok, .bcard .bg-vote { flex: none; align-self: flex-end; margin-top: auto; display: inline-flex; align-items: center; gap: 1.2cqw; min-height: max(40px, 6.6cqw); padding: 0 3.4cqw; border: 0; border-radius: 1.2cqw; background: var(--nv); color: #fff; font: 400 max(10px, 1.6cqw)/1 var(--bc-px); cursor: pointer; box-shadow: 0 .6cqw 0 var(--nv2); transition: transform .12s ease, box-shadow .12s ease, opacity .2s ease; }
  .bcard .bg-vote { background: #fff; color: var(--nv); box-shadow: 0 .6cqw 0 var(--ciel2); }
  .bcard .bg-vote:not(:disabled) { animation: none; }
