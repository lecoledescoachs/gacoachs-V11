  .bg-play { width: max(9px, 1.4cqw); height: max(9px, 1.4cqw); }
  .bcard .bg-prev:focus-visible, .bcard .bg-tile:focus-visible, .bcard .bg-chip:focus-visible, .bcard .bg-ok:focus-visible, .bcard .bg-vote:focus-visible, .bcard .bg-perso:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .bg-bas { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.6cqw; margin-top: auto; }
