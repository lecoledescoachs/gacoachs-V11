  .bcz .bcz-foot a { color: #0037B6; font-weight: 700; }
  .bcz-rare { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #0B2A7A; }
  .bcz-rare i { width: 9px; height: 9px; border-radius: 50%; background: #0037B6; animation: bc-dot 1.8s ease-out infinite; }

  @keyframes bc-blink { 50% { opacity: 0; } }
  @keyframes bc-balaye { 0%, 55% { background-position: -160% 0; } 100% { background-position: 260% 0; } }
  @keyframes bc-flotte { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes bc-ring { 0% { opacity: .9; transform: scale(.96); } 100% { opacity: 0; transform: scale(1.14); } }
  @keyframes bc-shake { 0%, 100% { transform: none; } 20% { transform: translateX(-6px); } 40% { transform: translateX(5px); } 60% { transform: translateX(-3px); } 80% { transform: translateX(2px); } }
  @keyframes bc-dot { 0% { box-shadow: 0 0 0 0 rgba(0, 55, 182, .5); } 100% { box-shadow: 0 0 0 10px rgba(0, 55, 182, 0); } }
  @keyframes bg-pop { 0% { transform: scale(.82); } 60% { transform: scale(1.08); } 100% { transform: scale(1); } }
  @keyframes bg-glow { 0%, 100% { box-shadow: 0 .6cqw 0 var(--ciel2), 0 0 0 0 rgba(255, 255, 255, .8); } 50% { box-shadow: 0 .6cqw 0 var(--ciel2), 0 0 0 1cqw rgba(255, 255, 255, 0); } }
  @keyframes bg-pts { 0% { opacity: 0; transform: translate(-50%, 0) scale(.6); } 20% { opacity: 1; transform: translate(-50%, -30%) scale(1.15); } 100% { opacity: 0; transform: translate(-50%, -260%) scale(1); } }
  @keyframes bg-bulletin {
    0% { transform: translate(-50%, -50%) scale(1); }
    34% { transform: translate(-50%, var(--b-up)) scale(var(--b-s)); }
    52% { transform: translate(-50%, var(--b-up)) scale(var(--b-s), calc(var(--b-s) / 2)); }
    70% { transform: translate(-50%, var(--b-hov)) scale(var(--b-s), calc(var(--b-s) / 2)); }
    100% { transform: translate(-50%, var(--b-in)) scale(var(--b-s), calc(var(--b-s) / 2)); }
  }
  @keyframes bg-pli { to { opacity: 1; } }
  @keyframes bg-efface { to { opacity: 0; } }
  @keyframes bg-urne { from { transform: translate(-50%, 130%); } to { transform: translate(-50%, 0); } }
  @keyframes bg-secoue { 0%, 100% { rotate: 0deg; } 25% { rotate: -3deg; } 50% { rotate: 2.5deg; } 75% { rotate: -1.5deg; } }
  @keyframes bg-sort { to { transform: translate(-50%, 140%); opacity: 0; } }
  @keyframes bg-avote { 0% { opacity: 0; transform: scale(.3); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes bg-confetti {
    0% { opacity: 1; transform: translate(0, 0) rotate(0deg); }
    55% { opacity: 1; transform: translate(calc(var(--x) * .75), var(--y)) rotate(calc(var(--r) * .6)); }
    100% { opacity: 0; transform: translate(var(--x), calc(var(--y) + 9cqw)) rotate(var(--r)); }
  }
  @keyframes bg-glow2 { 0%, 100% { box-shadow: 0 .6cqw 0 var(--nv2), 0 0 0 0 rgba(255, 255, 255, .8); } 50% { box-shadow: 0 .6cqw 0 var(--nv2), 0 0 0 1cqw rgba(255, 255, 255, 0); } }
  @keyframes bg-curseur { from { transform: translateY(0); } to { transform: translateY(45%); } }
  @keyframes bg-rayons { to { transform: rotate(360deg); } }
  @keyframes bg-sort-coach { 0% { opacity: 0; transform: translateY(60%) scale(.3); } 100% { opacity: 1; transform: none; } }
  @keyframes bg-monte { from { opacity: 0; transform: translateY(1.5cqw); } to { opacity: 1; transform: none; } }

  /* Mobile : la carte passe à la verticale, comme un bulletin de vote */
  @media (max-width: 560px) {
    .bcz { max-width: 380px; }
    .bcard { --r: 2.6cqw; --uw: 72%; --uh: 34%; --b-s: .42; --b-up: -74%; --b-hov: -52%; --b-in: -16%; aspect-ratio: 600 / 1050; }
    .bcard-front, .bg-bulletin { padding: 10cqw 7cqw 6cqw; }
