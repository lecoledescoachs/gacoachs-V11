  .bcard .bc-line input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]) { width: 100%; min-height: 0; margin: 0; padding: .3cqw .6cqw .1cqw; border: 0; border-radius: 0; box-shadow: none; outline: none; background: linear-gradient(#fff, #fff) left bottom / 0 max(2px, .3cqw) no-repeat; color: var(--nv); font: 600 max(18px, 3.4cqw)/1.05 'Caveat', 'Segoe Print', cursive; transition: background-size .55s cubic-bezier(.2, .8, .2, 1) calc(var(--k, 0) * 80ms + .2s); }
