  .bcard.is-vote .bcard-in { visibility: hidden; }
  .bcard.is-vote .bcard-sh { opacity: 0; }
  .bg-bulletin { position: absolute; z-index: 2; left: 50%; top: 50%; width: 100%; height: 100%; border-radius: var(--r); box-shadow: 0 1cqw 3cqw -1cqw rgba(0, 30, 90, .55); transform: translate(-50%, -50%); }
  .bg-bulletin::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.4cqw; margin-top: -.7cqw; background: linear-gradient(180deg, transparent, rgba(0, 52, 122, .35), transparent); opacity: 0; }
  .bcard.is-vote .bg-bulletin { animation: bg-bulletin 1.6s cubic-bezier(.55, 0, .3, 1) forwards, bg-efface .3s ease 2.6s forwards; }
  .bcard.is-vote .bg-bulletin::after { animation: bg-pli .3s ease .55s forwards; }
  .bg-urne-dos, .bg-urne-face { position: absolute; left: 50%; bottom: 1.5%; width: var(--uw); height: var(--uh); border-radius: 0 0 2cqw 2cqw; transform: translate(-50%, 130%); }
  .bg-urne-dos { z-index: 1; background: linear-gradient(180deg, rgba(0, 55, 182, .3), rgba(0, 55, 182, .12)); }
  .bg-urne-face { z-index: 3; display: grid; place-items: end center; padding-bottom: 2cqw; background: linear-gradient(115deg, rgba(255, 255, 255, .55) 0 18%, rgba(255, 255, 255, .18) 18% 34%, rgba(255, 255, 255, .3) 34%); box-shadow: inset 0 0 0 .55cqw #0037B6; }
  .bg-urne-face::before { content: ''; position: absolute; left: -3%; right: -3%; top: -2.6cqw; height: 3cqw; border-radius: 1cqw 1cqw .4cqw .4cqw; background: #0037B6; box-shadow: inset 0 -.5cqw 0 #00287F; }
  .bg-urne-face::after { content: ''; position: absolute; left: 30%; right: 30%; top: -1.7cqw; height: .9cqw; border-radius: 1cqw; background: #001B42; }
  .bg-urne-face span { padding: .6cqw 1.6cqw; border-radius: .8cqw; background: #fff; color: #0037B6; font: 700 max(9px, 1.6cqw)/1 var(--bc-font); letter-spacing: .02em; }
  .bcard.is-vote .bg-urne-dos, .bcard.is-vote .bg-urne-face { animation: bg-urne .6s cubic-bezier(.2, 1.3, .4, 1) .12s forwards, bg-secoue .5s ease 1.55s, bg-sort .5s cubic-bezier(.5, 0, .7, .2) 2.6s forwards; }
  .bg-avote { position: absolute; z-index: 5; left: 0; right: 0; top: 7%; margin: 0; text-align: center; font: 400 max(16px, 4.4cqw)/1 var(--bc-px); color: var(--nv); text-shadow: 0 .45cqw 0 #fff, .3cqw 0 0 #fff, -.3cqw 0 0 #fff, 0 -.3cqw 0 #fff; opacity: 0; transform: scale(.3); }
  .bcard.is-vote .bg-avote { animation: bg-avote .55s cubic-bezier(.2, 1.8, .4, 1) 1.65s forwards; }
  .bg-confetti { position: absolute; z-index: 4; left: 50%; top: calc(100% - var(--uh) - 1.5%); width: 0; height: 0; }
  .bg-confetti i { position: absolute; left: 0; top: 0; width: 1.1cqw; height: 1.6cqw; border-radius: 2px; background: var(--c, #2F6FED); box-shadow: 0 0 0 1px rgba(0, 55, 182, .12); opacity: 0; }
  .bcard.is-vote .bg-confetti i { animation: bg-confetti 1.3s cubic-bezier(.2, .7, .4, 1) calc(1.55s + var(--i) * 12ms) forwards; }
  .bg-fin { z-index: 6; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.8cqw; padding: 13cqw 4cqw 4cqw; text-align: center; }
  .bcard.is-fin .bg-fin { visibility: visible; }
  .bg-fin-av { position: relative; z-index: 0; display: flex; justify-content: center; opacity: 0; transform: translateY(40%) scale(.3); }
  /* rayons qui tournent derrière le coach, comme un personnage débloqué */
  .bg-fin-av::before { content: ''; position: absolute; z-index: -1; left: 50%; top: 50%; width: 46cqw; height: 46cqw; margin: -23cqw 0 0 -23cqw; border-radius: 50%; background: repeating-conic-gradient(rgba(0, 171, 255, .42) 0 9deg, rgba(0, 171, 255, 0) 9deg 22.5deg); -webkit-mask: radial-gradient(circle, #000 22%, transparent 68%); mask: radial-gradient(circle, #000 22%, transparent 68%); animation: bg-rayons 9s linear infinite; }
  .bg-fin-av img, .bg-fin-av .bg-any { width: 17cqw; height: 17cqw; border-radius: 2cqw; object-fit: cover; box-shadow: 0 0 0 .6cqw #fff, 0 0 0 1.1cqw #0037B6, 0 2cqw 4cqw -1cqw rgba(0, 30, 90, .6); }
  .bg-fin-av img + img { margin-left: -4cqw; }
  .bcard.is-fin .bg-fin-av { animation: bg-sort-coach .7s cubic-bezier(.2, 1.6, .4, 1) .15s forwards; }
  .bcard .bg-fin-t { margin: 0; font: 700 max(16px, 3.2cqw)/1.15 var(--bc-font); color: #003882; opacity: 0; }
  .bcard .bg-fin-s { margin: 0; display: inline-flex; gap: .7cqw; padding: 1cqw 2.4cqw; border-radius: 999px; background: #0037B6; color: #fff; font: 700 max(12px, 1.9cqw)/1 var(--bc-font); opacity: 0; }
  .bcard.is-fin .bg-fin-t { animation: bg-monte .45s ease .55s forwards; }
  .bcard.is-fin .bg-fin-s { animation: bg-monte .45s ease .75s forwards; }

  /* Sous la carte */
  .bcz-ctl { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .bcz .bcz-go { position: relative; display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 26px; border: 0; border-radius: 999px; background: #0037B6; color: #fff; font: 700 16px/1 var(--bc-ui); cursor: pointer; box-shadow: 0 12px 24px -12px rgba(0, 55, 182, .9); transition: transform .2s ease, background .2s ease; }
