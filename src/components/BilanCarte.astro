  .bcard .bc-line input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]):focus-visible { background-color: rgba(255, 255, 255, .16); background-size: 100% max(3px, .45cqw); border-radius: 6px 6px 0 0; }
  .bc-line.bc-bad { animation: bc-shake .42s ease; }
  .bcard .bc-line.bc-bad input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]) { background-image: linear-gradient(#003882, #003882); background-size: 100% max(3px, .45cqw); }
  /* le coach : choix du personnage */
  .bg-salle-ok { display: inline-flex; align-items: center; gap: .6cqw; margin-left: 1.2cqw; padding: .5cqw 1.6cqw; border-radius: 999px; background: rgba(255, 255, 255, .35); font: 700 max(11px, 1.7cqw)/1 var(--bc-ui); vertical-align: middle; }
  .bg-salle-ok[hidden] { display: none; }
