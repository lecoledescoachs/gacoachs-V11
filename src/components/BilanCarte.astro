  .bg-any { display: grid; place-items: center; background: var(--nv); color: #fff; font: 400 max(16px, 4cqw)/1 var(--bc-px); }
  .bcard .bg-perso[aria-pressed="true"] { background: #fff; box-shadow: 0 0 0 .45cqw var(--nv), 0 0 3.6cqw rgba(255, 255, 255, .95); animation: bg-pop .5s cubic-bezier(.3, 1.7, .5, 1); }
  .bcard .bg-perso[aria-pressed="true"] img, .bcard .bg-perso[aria-pressed="true"] .bg-any { box-shadow: 0 0 0 .35cqw var(--nv); }
  /* curseur de jeu au-dessus du coach choisi */
  .bcard .bg-perso[aria-pressed="true"]::before { content: ''; position: absolute; left: 50%; top: -2.7cqw; width: 2.5cqw; height: 1.5cqw; margin-left: -1.25cqw; background: #fff; clip-path: polygon(0 0, 100% 0, 100% 34%, 80% 34%, 80% 67%, 60% 67%, 60% 100%, 40% 100%, 40% 67%, 20% 67%, 20% 34%, 0 34%); animation: bg-curseur .5s steps(2, jump-none) infinite alternate; }
  .bg-pts { position: absolute; z-index: 9; pointer-events: none; font: 400 max(9px, 1.5cqw)/1 var(--bc-px); color: #fff; text-shadow: 0 2px 0 var(--nv), 0 0 8px rgba(0, 52, 122, .6); animation: bg-pts .9s ease-out forwards; white-space: nowrap; }

  /* Finale : le bulletin plié tombe dans l'urne, puis le coach apparaît */
  .bg-scene, .bg-fin { position: absolute; inset: 0; pointer-events: none; visibility: hidden; }
  .bg-scene { z-index: 4; }
