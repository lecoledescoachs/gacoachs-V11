    .bcard .bc-s { margin-top: 9cqw; font-size: max(11px, 3.5cqw); }
    .bcard .bc-go { bottom: 9cqw; gap: 2.4cqw; font-size: max(10px, 3.1cqw); }
    .bcard-back { padding: 5.6cqw 5.6cqw 6cqw; }
    .bg-hud { gap: 3cqw; min-height: 9cqw; }
