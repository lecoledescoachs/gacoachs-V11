<script>
  // Effets partagés de la nouvelle identité : copier un lien, déplier les villes, apparitions et compteurs
  document.querySelectorAll<HTMLButtonElement>('.rb [data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); b.textContent = 'Lien copié ✓'; } catch { b.textContent = 'Copie impossible'; }
      setTimeout(() => { b.textContent = 'Copier le lien'; }, 2200);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.rb .zone-more').forEach((b) => {
    b.addEventListener('click', () => b.closest('.zone')?.classList.remove('is-short'));
  });
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduit && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('rb-anim');
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      el.classList.add('in');
      el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
        const cible = parseInt(n.dataset.count || '0', 10), t0 = performance.now();
        const tick = (t: number) => { const p = Math.min((t - t0) / 1200, 1); n.textContent = String(Math.round((p === 1 ? 1 : 1 - Math.pow(2, -10 * p)) * cible)); if (p < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
      });
      io.unobserve(el);
    }), { threshold: 0.12 });
    document.querySelectorAll('.rb [data-up]').forEach((el) => io.observe(el));
  }
</script>
