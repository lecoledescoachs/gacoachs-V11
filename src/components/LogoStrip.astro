---
interface LogoItem {
  nom: string;
  href?: string;
  logo?: string;
}
interface Props {
  title?: string;
  items: LogoItem[];
}
const { title, items } = Astro.props;
import dims from '../data/image-dims.json';
---
<div class="logo-strip">
  {title && <p class="logo-strip__title">{title}</p>}
  <div class="logo-strip__track">
    {items.map((item) => (
      item.href ? (
        <a href={item.href} class={`logo-strip__item ${item.logo ? 'logo-strip__item--framed' : ''}`} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {item.logo ? <img src={item.logo} alt={item.nom} width={((dims as Record<string, number[]>)[item.logo] || [])[0]} height={((dims as Record<string, number[]>)[item.logo] || [])[1]} loading="lazy" /> : item.nom}
        </a>
      ) : (
        <span class={`logo-strip__item ${item.logo ? 'logo-strip__item--framed' : ''}`}>
          {item.logo ? <img src={item.logo} alt={item.nom} width={((dims as Record<string, number[]>)[item.logo] || [])[0]} height={((dims as Record<string, number[]>)[item.logo] || [])[1]} loading="lazy" /> : item.nom}
        </span>
      )
    ))}
  </div>
</div>

<style>
  .logo-strip { display: flex; flex-direction: column; gap: 18px; }
  .logo-strip__title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: none;
    color: var(--text-muted);
    text-align: center;
  }
  .logo-strip__track {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 20px;
  }
  .logo-strip__item {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--navy);
    opacity: 0.5;
    transition: opacity .25s var(--ease), color .25s var(--ease), transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  /* Cadre blanc pour les vrais logos */
  .logo-strip__item--framed {
    opacity: 1;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 14px 22px;
    justify-content: center;
  }
  .logo-strip__item--framed img {
    height: 32px;
    width: auto;
    max-width: 110px;
    object-fit: contain;
  }
  a.logo-strip__item--framed:hover {
    border-color: var(--blue);
    box-shadow: 0 12px 24px -16px rgba(47, 111, 237, 0.4);
    transform: translateY(-3px);
  }

  a.logo-strip__item:not(.logo-strip__item--framed):hover { opacity: 1; color: var(--blue); transform: translateY(-2px); }

  @media (min-width: 768px) {
    .logo-strip__item { font-size: 20px; }
    .logo-strip__item--framed { padding: 16px 26px; }
    .logo-strip__item--framed img { height: 38px; max-width: 130px; }
  }
</style>
