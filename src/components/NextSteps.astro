---
interface Etape { texte: string; }
interface Props {
  etapes: Etape[];
  titre?: string;
}
const { etapes, titre = 'Et maintenant ?' } = Astro.props;
---
<div class="next-steps">
  <h2>{titre}</h2>
  <ol class="next-steps__list">
    {etapes.map((e, i) => (
      <li>
        <span class="next-steps__num">{i + 1}</span>
        <span>{e.texte}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .next-steps {
    margin-top: 40px;
    padding: 24px;
    background: var(--ice);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: left;
  }
  .next-steps h2 { font-size: 16px; }
  .next-steps__list { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .next-steps__list li { display: flex; gap: 14px; align-items: flex-start; font-size: 14.5px; color: var(--text-muted); }
  .next-steps__num {
    flex-shrink: 0;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
