---
interface Props {
  villeSlug: string;
  villeNom: string;
  villeLat: number;
  villeLng: number;
  salleNom: string;
  salleSlug: string;
  salleLat: number;
  salleLng: number;
}
const { villeSlug, villeNom, villeLat, villeLng, salleNom, salleSlug, salleLat, salleLng } = Astro.props;
const mapId = `ga-mini-carte-${villeSlug}`;
---
<div class="mini-carte">
  <div id={mapId} class="mini-carte__map" role="application" aria-label={`Carte de ${villeNom} et de ${salleNom}`}></div>
  <p class="mini-carte__credit">© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a></p>
</div>

<style>
  .mini-carte { display: flex; flex-direction: column; gap: 6px; margin-top: 24px; }
  .mini-carte__map {
    width: 100%;
    height: 280px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ice);
  }
  .mini-carte__credit { font-size: 12px; color: #3E4A66; text-align: right; }
  .mini-carte__credit { width: fit-content; margin-left: auto; padding: 2px 8px; border-radius: 6px; background: #fff; }
  .mini-carte__credit a { color: #3E4A66; text-decoration: underline; }
</style>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script is:inline src="/vendor/leaflet/leaflet.js"></script>
<script define:vars={{ mapId, villeNom, villeLat, villeLng, salleNom, salleSlug, salleLat, salleLng }}>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById(mapId);
    if (!el || typeof L === 'undefined') return;

    const bounds = L.latLngBounds([villeLat, villeLng], [salleLat, salleLng]);
    const map = L.map(mapId, { scrollWheelZoom: false }).fitBounds(bounds, { padding: [40, 40] });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; contributeurs OpenStreetMap',
    }).addTo(map);

    const villeIcon = L.divIcon({ className: 'ga-mm ga-mm--ville', html: '<span></span>', iconSize: [14, 14] });
    const salleIcon = L.divIcon({ className: 'ga-mm ga-mm--salle', html: '<span></span>', iconSize: [20, 20] });

    L.marker([villeLat, villeLng], { icon: villeIcon, title: villeNom, alt: villeNom }).addTo(map).bindPopup(villeNom);
    L.marker([salleLat, salleLng], { icon: salleIcon, title: salleNom, alt: salleNom })
      .addTo(map)
      .bindPopup(`<strong>${salleNom}</strong><br/><a href="/salles/${salleSlug}/">Voir la salle</a>`);

    L.polyline([[villeLat, villeLng], [salleLat, salleLng]], {
      color: '#2F6FED',
      weight: 2,
      opacity: 0.55,
      dashArray: '4 5',
    }).addTo(map);
  });
</script>

<style is:global>
  .ga-mm--salle span {
    display: block; width: 20px; height: 20px; border-radius: 50%;
    background: #0B1E3D; border: 3px solid #fff; box-shadow: 0 2px 8px rgba(11,30,61,.4);
  }
  .ga-mm--ville span {
    display: block; width: 14px; height: 14px; border-radius: 50%;
    background: #2F6FED; border: 2px solid #fff; box-shadow: 0 1px 4px rgba(47,111,237,.5);
  }
</style>
