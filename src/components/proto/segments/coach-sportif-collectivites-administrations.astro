---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-collectivites-administrations')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Mairies, administrations et organismes publics</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST ENTREPRISE™ · Organismes publics</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🏛️</span></span> <span class="w"><span style="--i: 1;">Du</span></span> <span class="w"><span style="--i: 2;">sport</span></span> <span class="w"><span style="--i: 3;">encadré</span></span> <span class="w"><span style="--i: 4;">pour</span></span> <span class="w"><span style="--i: 5;">vos</span></span> <span class="w"><span style="--i: 6;">agents</span></span> <span class="w"><span style="--i: 7;">et</span></span> <span class="w"><span style="--i: 8;">vos</span></span> <span class="w"><span style="--i: 9;">habitants.</span></span></h1><p class="phero-lead" data-a="up">Mairies, préfectures, URSSAF, CAF, intercommunalités : un coach diplômé intervient auprès de vos agents ou de vos publics, avec un devis détaillé utilisable dans votre procédure d'achat.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Pour vos agents ou vos habitants</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un devis détaillé pour votre procédure d'achat</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Des actions ponctuelles ou régulières</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=collectivite#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> un coach sportif diplômé pour vos agents ou pour vos habitants.</li><li><b>Pour qui :</b> mairies, intercommunalités, préfectures, URSSAF, CAF et organismes publics du Loiret.</li><li><b>Comment :</b> un échange, puis un devis détaillé utilisable dans votre procédure d'achat, pour des actions ponctuelles ou régulières.</li><li><b>Ce que vous y gagnez :</b> des agents en meilleure forme et des actions de sport santé concrètes pour votre territoire.</li></ul></div></div></section>
<BoostOffre id="entreprise" cta="/services-sur-mesure/?pour=collectivite#sm-contact" texte="30 minutes pour faire bouger vos équipes, sur site. Testez avec BOOST 30, une séance découverte offerte." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Dans</span></span> <span class="w"><span style="--i: 1;">les</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">publics</span></span> <span class="w"><span style="--i: 4;">aussi,</span></span> <span class="w"><span style="--i: 5;">on</span></span> <span class="w"><span style="--i: 6;">bouge</span></span> <span class="w"><span style="--i: 7;">trop</span></span> <span class="w"><span style="--i: 8;">peu.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🖥️</span><h3>Des journées entières devant un écran</h3><p>Travail de bureau, accueil du public, réunions : la sédentarité pèse sur le dos et sur l'énergie de vos agents.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📋</span><h3>Une démarche de qualité de vie au travail à faire vivre</h3><p>Les intentions sont là ; il manque souvent des actions concrètes, régulières et faciles à organiser.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🧾</span><h3>Des règles d'achat à respecter</h3><p>Toute prestation doit entrer dans votre procédure, avec un devis clair et un interlocuteur identifié.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qu'un</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">apporte</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">votre</span></span> <span class="w"><span style="--i: 6;">structure.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Des agents qui bougent plus</h3><p>Sédentarité, travail sur écran, postures : des séances courtes et régulières, sur le lieu de travail, pour vos équipes.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Des actions pour vos habitants</h3><p>Séances pour les seniors, journées sport santé, actions de quartier : un coach anime vos projets auprès du public.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Un cadre clair</h3><p>Un interlocuteur unique, un devis détaillé et un bilan de chaque action pour vos rapports.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">⏱️</span> Pauses actives</h3><p>15 à 30 minutes sur site, en tenue de travail, pour vos agents.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🪑</span> Ateliers de prévention</h3><p>Postures, mal de dos, gestes du quotidien au bureau.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">👵</span> Séances pour vos publics</h3><p>Seniors, habitants d'un quartier, publics accompagnés par vos services.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🎉</span> Événements</h3><p>Journée sport santé, challenge entre services, semaine de la qualité de vie au travail.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Des actions ponctuelles et vite oubliées</span><span class="cb-ap">Un cycle complet, du lancement au bilan</span></div><div class="cb-r"><span class="cb-av">Des agents qui n'osent pas participer</span><span class="cb-ap">Des pauses actives en tenue de travail, accessibles à tous</span></div><div class="cb-r"><span class="cb-av">Peu d'éléments pour vos rapports</span><span class="cb-ap">Un bilan écrit avec la participation</span></div><div class="cb-r"><span class="cb-av">Un prestataire difficile à cadrer</span><span class="cb-ap">Un devis détaillé, intégrable à votre procédure d'achat</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🏛️</span><div><h2 class="h2">AGENTS EN FORME</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un cycle complet pour faire bouger vos agents, du lancement au bilan.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Un cycle complet : lancement, 2 pauses actives par semaine, 1 atelier postures par mois, challenge final et bilan écrit.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Une politique durable : 4 cycles de 12 semaines, un thème par trimestre, un bilan annuel pour vos rapports.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Une réunion de lancement avec les services</li><li>2 pauses actives par semaine, sur site et en tenue de travail</li><li>1 atelier postures par mois</li><li>Un challenge entre services pour clôturer le cycle</li><li>Un bilan écrit avec la participation, utile pour vos rapports</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Une action de qualité de vie au travail visible et mesurée</li><li>Un devis détaillé, intégrable à votre procédure d'achat</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=collectivite#sm-contact">Demander le programme AGENTS EN FORME</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur le coach sportif pour les collectivités.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/activite-physique-agents-collectivite/" data-a="up"><b>Activité physique des agents : ce qu'une collectivité peut mettre en place</b><span>Pauses actives, ateliers postures, challenges entre services : des actions simples pour faire bouger les agents d'une mairie ou d'une administration.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=collectivite#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

<style>
  .sg-bref-sec { padding-top: 28px; padding-bottom: 8px; }
  .sg-bref { border-left: 4px solid #1D5BD8; background: #fff; border-radius: 0 18px 18px 0; padding: 18px 22px; box-shadow: 0 12px 30px -24px rgba(11,30,61,.5); }
  .sg-bref-k { margin: 0 0 8px; font-weight: 700; text-transform: none; letter-spacing: .02em; font-size: 12px; color: #1D5BD8; }
  .sg-bref ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; color: #0B1E3D; line-height: 1.5; }
</style>
