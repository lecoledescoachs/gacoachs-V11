---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-hotel')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Hôtels</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST TOURISME · Hôtels</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🏨</span></span> <span class="w"><span style="--i: 1;">Un</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">sportif</span></span> <span class="w"><span style="--i: 4;">pour</span></span> <span class="w"><span style="--i: 5;">les</span></span> <span class="w"><span style="--i: 6;">clients</span></span> <span class="w"><span style="--i: 7;">de</span></span> <span class="w"><span style="--i: 8;">votre</span></span> <span class="w"><span style="--i: 9;">hôtel.</span></span></h1><p class="phero-lead" data-a="up">Proposez à vos clients des séances encadrées par un coach diplômé : en chambre, dans votre salle de fitness ou en extérieur. Un service en plus, sans recrutement à gérer.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un service premium pour vos clients</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Séances privées ou collectives</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Aucun recrutement à gérer</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=hotel#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> un coach sportif diplômé pour les clients de votre hôtel, en séance privée ou collective.</li><li><b>Pour qui :</b> hôtels, résidences hôtelières et hôtels de séminaire à Orléans et dans le Loiret.</li><li><b>Comment :</b> un échange, une visite de votre établissement, puis des séances en chambre, en salle de fitness ou en extérieur.</li><li><b>Ce que vous y gagnez :</b> un service premium à valoriser, sans recrutement à gérer.</li></ul></div></div></section>
<BoostOffre id="tourisme" cta="/services-sur-mesure/?pour=hotel#sm-contact" texte="Des séances encadrées pour vos clients, sans recrutement à gérer : un vrai service en plus pendant leur séjour." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">que</span></span> <span class="w"><span style="--i: 2;">beaucoup</span></span> <span class="w"><span style="--i: 3;">d'hôtels</span></span> <span class="w"><span style="--i: 4;">constatent.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🏋️</span><h3>Une salle de fitness peu utilisée</h3><p>Elle figure dans la description de l'hôtel, mais peu de clients s'en servent vraiment.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">⭐</span><h3>Des clients qui comparent tout</h3><p>Sur les plateformes de réservation, ce sont les services en plus qui font la différence et les bons avis.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">💼</span><h3>Des séminaires qui se ressemblent</h3><p>Les groupes d'affaires cherchent des lieux qui proposent plus qu'une salle de réunion et un buffet.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">proposer</span></span> <span class="w"><span style="--i: 2;">un</span></span> <span class="w"><span style="--i: 3;">coach</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">vos</span></span> <span class="w"><span style="--i: 6;">clients.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Un séjour qui se distingue</h3><p>Un coach à disposition, c'est un service que vos clients retiennent et qu'ils peuvent citer dans leurs avis.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Votre salle de fitness mieux utilisée</h3><p>Avec un coach sur des créneaux fixes, votre espace de fitness devient un vrai service, pas seulement une ligne dans la description de l'hôtel.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Un atout pour vos séminaires</h3><p>Réveil musculaire, pause active entre deux sessions : de quoi enrichir vos offres pour les groupes d'affaires.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🛎️</span> Séances privées à la demande</h3><p>Votre réception propose la séance, le coach intervient en chambre, en salle ou dehors.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">⏰</span> Créneaux collectifs réguliers</h3><p>Par exemple un réveil musculaire chaque matin ou plusieurs fois par semaine.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">💼</span> Animation de séminaire</h3><p>Pauses actives, séance d'ouverture, challenge sportif pour vos groupes.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🧘</span> Séjour bien-être</h3><p>Un programme de plusieurs séances sur la durée du séjour, à intégrer à vos forfaits.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Une salle de fitness vide</span><span class="cb-ap">Un réveil musculaire à jours fixes, annoncé à la réception</span></div><div class="cb-r"><span class="cb-av">Un service sport inexistant</span><span class="cb-ap">Des séances privées réservables depuis la chambre</span></div><div class="cb-r"><span class="cb-av">Des séminaires classiques</span><span class="cb-ap">Pauses actives et séances d'ouverture pour vos groupes</span></div><div class="cb-r"><span class="cb-av">Un recrutement à gérer</span><span class="cb-ap">Un coach diplômé du réseau, sans embauche</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🏨</span><div><h2 class="h2">SÉJOUR ACTIF</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un service sport clé en main pour vos clients, sans recrutement à gérer.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Une saison test : réveil musculaire à jours fixes, séances privées à la demande et point de participation à la fin.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Le service sport de l'hôtel toute l'année : planning adapté aux saisons, offres séminaire, point chaque trimestre.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Un réveil musculaire collectif, à jours fixes, annoncé à la réception</li><li>Des séances privées à la demande, en chambre, en salle ou dehors</li><li>Un support à poser en chambre (QR code) pour réserver une séance</li><li>Une offre séminaire : séance d'ouverture et pauses actives</li><li>Un point chaque trimestre sur la participation</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Un service que vos clients retiennent</li><li>Votre espace fitness enfin utilisé</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=hotel#sm-contact">Demander le programme SÉJOUR ACTIF</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur le coach sportif à l'hôtel.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/coach-sportif-hotel-comment-proposer-le-service/" data-a="up"><b>Proposer un coach sportif dans son hôtel : formats et mise en place</b><span>Séances privées, créneaux collectifs, séminaires : comment un hôtel peut proposer un coach sportif diplômé à ses clients, sans recruter.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=hotel#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

