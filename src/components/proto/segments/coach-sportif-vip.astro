ired><option value="">Choisir</option><option>Football ou sport professionnel</option><option>Cinéma, séries, théâtre</option><option>Télévision, radio, journalisme</option><option>Musique</option><option>Humour</option><option>Création de contenu</option><option>Politique</option><option>Entreprise</option><option>Autre</option></select></label><label>Formule envisagée<select name="formule" required><option value="">Choisir</option><option>PRIVÉ 12 : 12 semaines</option><option>PRIVÉ 12 : 1 an</option><option>Préparation d'une échéance (rôle, saison, campagne)</option><option>Je ne sais pas encore</option></select></label><label class="full">Ville et rythme souhaité<textarea name="dates" rows="3" required placeholder="Ex. : Paris 16e, 2 séances par semaine, tôt le matin"></textarea></label><label>Une échéance ? (facultatif)<input name="premiere" type="text" placeholder="Ex. : tournage le 3 mars, reprise le 10 juillet" /></label><label>Langue de l'échange<select name="langue"><option>Français</option><option>English</option></select></label><label class="full">Vos disponibilités pour l'échange confidentiel (facultatif)<input name="dispo" type="text" placeholder="Ex. : en semaine, après 14 h" /></label><label class="full">Un mot sur votre objectif (facultatif)<textarea name="message" rows="3"></textarea></label><label class="tr-chk full"><input type="checkbox" name="consentement" required /><span>J'accepte que GA Coachs utilise ces informations pour me recontacter au sujet de ma demande.</span></label><button type="submit" class="btn btn-primary full">Réserver mon échange confidentiel</button><p class="tr-n full">Vos informations restent confidentielles et servent uniquement à répondre à votre demande.</p></form></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur BOOST PRIVÉ.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details 