---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'evjf-evg-activite-sportive')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>EVJF et EVG</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST EVENT · EVJF et EVG</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🎉</span></span> <span class="w"><span style="--i: 1;">Un</span></span> <span class="w"><span style="--i: 2;">EVJF</span></span> <span class="w"><span style="--i: 3;">ou</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">EVG</span></span> <span class="w"><span style="--i: 6;">sportif,</span></span> <span class="w"><span style="--i: 7;">encadré</span></span> <span class="w"><span style="--i: 8;">par</span></span> <span class="w"><span style="--i: 9;">un</span></span> <span class="w"><span style="--i: 10;">coach.</span></span></h1><p class="phero-lead" data-a="up">Bootcamp en plein air, défis par équipes, mini course façon Hyrox : un coach diplômé anime une activité sportive qui fait rire, transpirer et laisse de beaux souvenirs.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Tous niveaux, tous âges</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Défis par équipes et fous rires</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>En plein air ou en salle</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=evjf-evg#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> une activité sportive animée par un coach diplômé pour votre EVJF ou votre EVG.</li><li><b>Pour qui :</b> les groupes d'amis, tous niveaux et tous âges, à Orléans et dans le Loiret.</li><li><b>Comment :</b> bootcamp, défis par équipes ou mini course façon Hyrox, en une à deux heures.</li><li><b>Ce que vous y gagnez :</b> des fous rires, de beaux souvenirs et zéro organisation sportive à gérer.</li></ul></div></div></section>
<BoostOffre id="event" cta="/services-sur-mesure/?pour=evjf-evg#sm-contact" texte="Un run club, une séance avant le brunch, un défi entre amis : le sport qui rassemble, avant la fête." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Organiser</span></span> <span class="w"><span style="--i: 1;">un</span></span> <span class="w"><span style="--i: 2;">EVJF</span></span> <span class="w"><span style="--i: 3;">ou</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">EVG,</span></span> <span class="w"><span style="--i: 6;">c'est</span></span> <span class="w"><span style="--i: 7;">tout</span></span> <span class="w"><span style="--i: 8;">un</span></span> <span class="w"><span style="--i: 9;">défi.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🧩</span><h3>Des invités qui ne se connaissent pas</h3><p>Amis d'enfance, collègues, famille : il faut une activité qui mélange tout le monde dès le début.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">⚖️</span><h3>Des niveaux très différents</h3><p>Certains sont sportifs, d'autres pas du tout. Personne ne doit se sentir mis de côté.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📅</span><h3>Beaucoup de choses à organiser</h3><p>Lieu, matériel, déroulé : l'organisateur a déjà assez à faire.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">choisir</span></span> <span class="w"><span style="--i: 2;">une</span></span> <span class="w"><span style="--i: 3;">activité</span></span> <span class="w"><span style="--i: 4;">sportive.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Un moment qui rassemble</h3><p>Des défis par équipes qui mélangent les groupes d'amis et créent des souvenirs communs.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Tout le monde participe</h3><p>Le coach adapte chaque défi pour que tous les niveaux puissent jouer, sans mettre personne en difficulté.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Clé en main</h3><p>Vous choisissez le format, le coach prépare le déroulé, le matériel et anime du début à la fin.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🌳</span> Bootcamp en plein air</h3><p>Une séance ludique et collective dans un parc ou au bord de la Loire.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🏆</span> Défis par équipes</h3><p>Relais, épreuves chronométrées et classement final, avec une épreuve spéciale pour la future mariée ou le futur marié.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🏋️</span> Mini course façon Hyrox</h3><p>Course et ateliers enchaînés, en version adaptée au groupe.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">💍</span> Préparation avant le mariage</h3><p>Quelques séances en amont pour le couple ou la personne fêtée.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Une activité classique vite oubliée</span><span class="cb-ap">Des défis par équipes dont tout le monde se souvient</span></div><div class="cb-r"><span class="cb-av">Les moins sportifs restent à l'écart</span><span class="cb-ap">Chaque défi a plusieurs niveaux</span></div><div class="cb-r"><span class="cb-av">Tout organiser soi-même</span><span class="cb-ap">Un déroulé et un matériel prêts, animés par le coach</span></div><div class="cb-r"><span class="cb-av">La forme oubliée avant le grand jour</span><span class="cb-ap">Une préparation physique de la personne fêtée</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🎉</span><div><h2 class="h2">LE GRAND DÉFI</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Une préparation physique avant le grand jour, et une activité pleine de rires pour l'EVJF ou l'EVG.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>La préparation de la personne fêtée avant le grand jour, avec le Grand Défi pour l'EVJF ou l'EVG.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>La préparation jusqu'au mariage, le Grand Défi, puis un suivi pour garder la forme après la fête.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Des séances pour la personne fêtée, à son rythme, jusqu'au mariage</li><li>Le Grand Défi le jour de l'EVJF ou de l'EVG : 5 défis par équipes, tous niveaux</li><li>Une épreuve spéciale pour la future mariée ou le futur marié</li><li>Un podium et une petite récompense</li><li>Le matériel fourni par le coach</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Un souvenir commun qui rassemble les deux groupes d'amis</li><li>Zéro organisation de votre côté</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=evjf-evg#sm-contact">Demander le programme LE GRAND DÉFI</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur l'EVJF ou l'EVG sportif.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/evjf-evg-sportif-idees-d-activites/" data-a="up"><b>EVJF ou EVG sportif : idées d'activités avec un coach</b><span>Bootcamp, défis par équipes, mini course façon Hyrox : des idées d'activités sportives pour un enterrement de vie de jeune fille ou de garçon réussi.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=evjf-evg#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

