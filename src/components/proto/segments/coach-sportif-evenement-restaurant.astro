---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-evenement-restaurant')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Restaurants</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST EVENT · Restaurants</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🍽️</span></span> <span class="w"><span style="--i: 1;">Une</span></span> <span class="w"><span style="--i: 2;">séance</span></span> <span class="w"><span style="--i: 3;">de</span></span> <span class="w"><span style="--i: 4;">sport,</span></span> <span class="w"><span style="--i: 5;">puis</span></span> <span class="w"><span style="--i: 6;">on</span></span> <span class="w"><span style="--i: 7;">passe</span></span> <span class="w"><span style="--i: 8;">à</span></span> <span class="w"><span style="--i: 9;">table</span></span> <span class="w"><span style="--i: 10;">chez</span></span> <span class="w"><span style="--i: 11;">vous.</span></span></h1><p class="phero-lead" data-a="up">Séance en plein air suivie d'un brunch, déjeuner d'équipe actif, événement privé : un coach diplômé anime l'activité, vous servez le repas. Un rendez-vous qui fait découvrir votre cuisine à de nouveaux clients.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Une formule sport et repas clé en main</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un coach diplômé aux commandes</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Le week-end ou en semaine</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=restaurant#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> une séance sportive animée par un coach diplômé, puis un repas chez vous.</li><li><b>Pour qui :</b> restaurants, brunchs et traiteurs d'Orléans et du Loiret.</li><li><b>Comment :</b> séance et brunch, déjeuner actif ou événement privé, ponctuel ou chaque mois.</li><li><b>Ce que vous y gagnez :</b> un rendez-vous original qui attire de nouveaux clients.</li></ul></div></div></section>
<BoostOffre id="event" cta="/services-sur-mesure/?pour=restaurant#sm-contact" texte="Un run club, une séance avant le brunch, un défi entre amis : le sport qui rassemble, avant la fête." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Faire</span></span> <span class="w"><span style="--i: 1;">venir</span></span> <span class="w"><span style="--i: 2;">de</span></span> <span class="w"><span style="--i: 3;">nouveaux</span></span> <span class="w"><span style="--i: 4;">clients,</span></span> <span class="w"><span style="--i: 5;">c'est</span></span> <span class="w"><span style="--i: 6;">le</span></span> <span class="w"><span style="--i: 7;">défi.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🪑</span><h3>Des services en demi-teinte</h3><p>Certains midis ou certains week-ends, des tables restent vides.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🔎</span><h3>Se démarquer des autres</h3><p>Beaucoup de restaurants se ressemblent ; il faut une raison de choisir le vôtre.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">👥</span><h3>Des groupes difficiles à attirer</h3><p>Entreprises et groupes cherchent une formule complète, pas seulement un repas.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">associer</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">restaurant</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">un</span></span> <span class="w"><span style="--i: 6;">rendez-vous</span></span> <span class="w"><span style="--i: 7;">sportif.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Des services remplis à l'avance</h3><p>Une séance suivie d'un brunch, c'est un groupe qui réserve, sur un créneau parfois calme.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Une image qui vous ressemble</h3><p>Cuisine maison, produits frais, bien-être : le sport prolonge naturellement votre carte.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Une offre pour les groupes</h3><p>Entreprises, associations, groupes d'amis : une formule activité plus repas, prête à vendre.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🥐</span> Séance et brunch</h3><p>Une séance en plein air le dimanche matin, puis le brunch chez vous.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🥗</span> Déjeuner actif</h3><p>Une séance courte le midi pour une entreprise voisine, puis un déjeuner léger.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🎉</span> Événement privé</h3><p>Anniversaire, séminaire, EVJF : l'activité sportive avant le repas.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🍳</span> Rendez-vous mensuel</h3><p>Un brunch sportif chaque mois, à annoncer à l'avance à vos clients.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Des tables vides certains jours</span><span class="cb-ap">Un groupe qui réserve pour le brunch sportif</span></div><div class="cb-r"><span class="cb-av">Un restaurant parmi d'autres</span><span class="cb-ap">Un rendez-vous original dont on parle</span></div><div class="cb-r"><span class="cb-av">Une offre groupe limitée au repas</span><span class="cb-ap">Une formule activité plus repas, clé en main</span></div><div class="cb-r"><span class="cb-av">Organiser l'activité soi-même</span><span class="cb-ap">Le coach anime, vous servez</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🍽️</span><div><h2 class="h2">RUN &amp; BRUNCH</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Une séance de sport, puis le brunch chez vous, chaque mois.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Trois brunchs sportifs, un par mois, pour tester la formule auprès de vos clients.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Un rendez-vous mensuel toute l'année, avec des éditions spéciales à chaque saison.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Une séance en plein air près de votre restaurant, tous niveaux</li><li>Un brunch ou un déjeuner servi par vous juste après</li><li>Une formule groupe pour les entreprises et les associations</li><li>Des visuels prêts à publier sur vos réseaux</li><li>Le coach anime, vous servez</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>De nouveaux clients qui découvrent votre cuisine</li><li>Des services remplis à l'avance</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=restaurant#sm-contact">Demander le programme RUN &amp; BRUNCH</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur l'événement sportif dans votre restaurant.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/evenement-sportif-bar-restaurant-idees/" data-a="up"><b>Organiser un événement sportif dans son bar ou son restaurant</b><span>Run club, séance suivie d'un brunch, défi en soirée : des idées d'événements sportifs pour faire venir du monde dans votre bar ou restaurant.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=restaurant#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

