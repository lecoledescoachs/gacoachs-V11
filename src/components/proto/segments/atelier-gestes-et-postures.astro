---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'atelier-gestes-et-postures')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Gestes et postures</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST ENTREPRISE™ · Gestes et postures</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🦺</span></span> <span class="w"><span style="--i: 1;">Des</span></span> <span class="w"><span style="--i: 2;">ateliers</span></span> <span class="w"><span style="--i: 3;">gestes</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">postures,</span></span> <span class="w"><span style="--i: 6;">concrets</span></span> <span class="w"><span style="--i: 7;">et</span></span> <span class="w"><span style="--i: 8;">adaptés</span></span> <span class="w"><span style="--i: 9;">aux</span></span> <span class="w"><span style="--i: 10;">postes</span></span> <span class="w"><span style="--i: 11;">de</span></span> <span class="w"><span style="--i: 12;">travail.</span></span></h1><p class="phero-lead" data-a="up">Port de charges, travail sur écran, gestes répétés : un coach diplômé anime des ateliers pratiques sur votre site, au plus près des situations réelles de vos équipes.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Sur site, au plus près des postes</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Pratique, pas seulement théorique</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Pour tous les métiers</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=gestes-postures#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> des ateliers pratiques gestes et postures, animés par un coach sportif diplômé.</li><li><b>Pour qui :</b> entreprises de tous les métiers : bureaux, logistique, commerce, artisanat, santé.</li><li><b>Comment :</b> sur votre site, en petit groupe et au poste de travail, ponctuellement ou avec un suivi.</li><li><b>Ce que vous y gagnez :</b> des équipes qui adoptent les bons gestes au quotidien.</li></ul></div></div></section>
<BoostOffre id="entreprise" cta="/services-sur-mesure/?pour=gestes-postures#sm-contact" texte="30 minutes pour faire bouger vos équipes, sur site. Testez avec BOOST 30, une séance découverte offerte." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">gestes</span></span> <span class="w"><span style="--i: 2;">du</span></span> <span class="w"><span style="--i: 3;">quotidien</span></span> <span class="w"><span style="--i: 4;">finissent</span></span> <span class="w"><span style="--i: 5;">par</span></span> <span class="w"><span style="--i: 6;">peser.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📦</span><h3>Des charges portées chaque jour</h3><p>Lever, porter, pousser : des gestes répétés qui fatiguent le dos et les épaules.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🖥️</span><h3>Des heures assis devant un écran</h3><p>Nuque raide, dos voûté, fatigue en fin de journée : le bureau aussi a ses douleurs.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📄</span><h3>Une prévention qui reste sur le papier</h3><p>Les consignes existent, mais elles sont rarement pratiquées sur les postes réels.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qu'un</span></span> <span class="w"><span style="--i: 2;">atelier</span></span> <span class="w"><span style="--i: 3;">apporte</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">vos</span></span> <span class="w"><span style="--i: 6;">équipes.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Des gestes plus sûrs</h3><p>Lever, porter, pousser, se pencher : les bons réflexes s'apprennent en pratiquant.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Moins de tensions</h3><p>Quelques exercices simples à refaire au poste pour soulager le dos, la nuque et les épaules.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Une démarche de prévention visible</h3><p>Une action concrète pour la santé de vos salariés, qui s'inscrit dans votre démarche de prévention.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🧑‍🏫</span> Atelier collectif</h3><p>Une à deux heures en petit groupe, théorie courte et beaucoup de pratique.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🏭</span> Au poste de travail</h3><p>Le coach observe les gestes réels et propose des ajustements sur place.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🌅</span> Échauffement de prise de poste</h3><p>Quelques minutes avant de commencer, pour préparer le corps à l'effort.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🔁</span> Suivi régulier</h3><p>Des rappels et séances courtes sur plusieurs semaines pour ancrer les habitudes.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Une formation théorique vite oubliée</span><span class="cb-ap">Des ateliers pratiques sur les postes réels</span></div><div class="cb-r"><span class="cb-av">Chacun ses habitudes</span><span class="cb-ap">Une routine commune de prise de poste</span></div><div class="cb-r"><span class="cb-av">Une action faite une fois</span><span class="cb-ap">Des rappels sur le terrain à 1 et 3 mois</span></div><div class="cb-r"><span class="cb-av">Peu de traces de la démarche</span><span class="cb-ap">Un compte rendu écrit des actions menées</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🦺</span><div><h2 class="h2">POSTES EN FORME</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un parcours pratique pour adopter de meilleurs gestes au poste de travail.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Un parcours complet : visite des postes, ateliers pratiques, routine de prise de poste, rappels à 1 et 3 mois.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Une prévention suivie : les nouveaux salariés formés au fil de l'eau, un rappel chaque trimestre, un compte rendu annuel.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Une visite des postes pour repérer les gestes à risque</li><li>Un atelier pratique de 2 heures par groupe</li><li>Une routine d'échauffement de prise de poste de 10 minutes</li><li>2 rappels sur le terrain, à 1 mois et à 3 mois</li><li>Un compte rendu écrit des actions menées</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Des réflexes de prévention ancrés dans le quotidien</li><li>Une action concrète à présenter dans votre démarche de prévention</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=gestes-postures#sm-contact">Demander le programme POSTES EN FORME</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur l'atelier gestes et postures.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/atelier-gestes-et-postures-comment-ca-se-passe/" data-a="up"><b>Atelier gestes et postures : comment ça se passe concrètement ?</b><span>Port de charges, travail sur écran, échauffement de prise de poste : le déroulé d'un atelier gestes et postures animé par un coach sportif diplômé.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=gestes-postures#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

