---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-clinique')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Cliniques</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST SANTÉ · Cliniques</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🏥</span></span> <span class="w"><span style="--i: 1;">Des</span></span> <span class="w"><span style="--i: 2;">séances</span></span> <span class="w"><span style="--i: 3;">de</span></span> <span class="w"><span style="--i: 4;">remise</span></span> <span class="w"><span style="--i: 5;">en</span></span> <span class="w"><span style="--i: 6;">mouvement</span></span> <span class="w"><span style="--i: 7;">pour</span></span> <span class="w"><span style="--i: 8;">vos</span></span> <span class="w"><span style="--i: 9;">patients.</span></span></h1><p class="phero-lead" data-a="up">Remise en mouvement, reprise d'activité après une hospitalisation, bien-être des équipes : un coach diplômé intervient dans votre clinique, avec l'accord et selon les consignes de l'équipe soignante.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Avec l'accord de l'équipe soignante</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Pour les patients et les équipes</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Adapté à votre organisation</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=clinique#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> un coach sportif diplômé pour la remise en mouvement de vos patients et le bien-être de vos équipes.</li><li><b>Pour qui :</b> cliniques, services ambulatoires, hôpitaux de jour et leurs équipes.</li><li><b>Comment :</b> des séances collectives sur indication de l'équipe soignante, puis un relais possible en ville après la sortie.</li><li><b>Ce que vous y gagnez :</b> des patients plus actifs et une continuité après le séjour, sans charge en plus pour vos soignants.</li></ul></div></div></section>
<BoostOffre id="sante" cta="/services-sur-mesure/?pour=clinique#sm-contact" texte="Médecins, kinés, maisons de santé, cliniques : un coach diplômé prend le relais pour la reprise d'activité de vos patients." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pendant</span></span> <span class="w"><span style="--i: 1;">et</span></span> <span class="w"><span style="--i: 2;">après</span></span> <span class="w"><span style="--i: 3;">le</span></span> <span class="w"><span style="--i: 4;">séjour,</span></span> <span class="w"><span style="--i: 5;">le</span></span> <span class="w"><span style="--i: 6;">mouvement</span></span> <span class="w"><span style="--i: 7;">compte.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🛏️</span><h3>Des patients qui bougent peu</h3><p>Pendant une hospitalisation, les journées sont longues et souvent immobiles.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🏡</span><h3>Un retour à domicile sans relais</h3><p>Après la sortie, beaucoup de patients ne savent pas comment reprendre une activité en sécurité.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🩺</span><h3>Des équipes soignantes sous tension</h3><p>Vos équipes n'ont pas le temps d'animer des séances régulières, et leur propre dos en souffre.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qu'un</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">apporte</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">votre</span></span> <span class="w"><span style="--i: 6;">clinique.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Encourager la remise en mouvement</h3><p>Des séances encadrées, adaptées aux consignes de l'équipe soignante, pour aider les patients à rester actifs.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Préparer le retour à domicile</h3><p>Le patient peut, s'il le souhaite, poursuivre avec un coach du réseau près de chez lui après sa sortie.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Prendre soin de vos équipes</h3><p>Des ateliers courts pour le personnel : postures, gestes, récupération.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🚶</span> Remise en mouvement</h3><p>Des séances collectives douces, sur indication de l'équipe soignante.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🏡</span> Relais après la sortie</h3><p>Un coach du réseau prend le relais en ville, avec l'accord du patient.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🕐</span> Ambulatoire et hôpital de jour</h3><p>Des créneaux calés sur votre organisation et vos temps de prise en charge.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">💙</span> Bien-être des équipes</h3><p>Pauses actives et ateliers pour le personnel soignant et administratif.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Peu d'activité pendant le séjour</span><span class="cb-ap">Des séances encadrées, selon les consignes de l'équipe soignante</span></div><div class="cb-r"><span class="cb-av">La sortie, et plus rien</span><span class="cb-ap">Un relais possible vers un coach du réseau près de chez le patient</span></div><div class="cb-r"><span class="cb-av">Des soignants épuisés</span><span class="cb-ap">Des ateliers pour le personnel chaque mois</span></div><div class="cb-r"><span class="cb-av">Une organisation de plus à gérer</span><span class="cb-ap">Un interlocuteur unique, en lien avec le cadre de santé</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🏥</span><div><h2 class="h2">REMISE EN MOUVEMENT</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Des séances encadrées pour vos patients et un relais après la sortie.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Un pilote dans un service : séances selon les consignes de l'équipe soignante, relais après la sortie, point final avec le cadre de santé.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Un partenariat annuel : séances chaque semaine, ateliers mensuels pour le personnel, point chaque trimestre.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Des séances collectives douces, sur indication et selon les consignes de l'équipe soignante</li><li>Des créneaux calés sur l'ambulatoire et l'hôpital de jour</li><li>Un relais vers un coach du réseau près de chez le patient, s'il le souhaite</li><li>1 atelier par mois pour le personnel : postures, récupération</li><li>Un point trimestriel avec le cadre de santé</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Des patients qui restent actifs pendant et après leur séjour</li><li>Une attention concrète portée à vos équipes</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=clinique#sm-contact">Demander le programme REMISE EN MOUVEMENT</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Notre</span></span> <span class="w"><span style="--i: 1;">rôle</span></span></h2><p class="lead-p" data-a="up">Nos coachs ne posent aucun diagnostic, ne prescrivent aucun traitement et ne remplacent ni les soins ni le suivi médical. En établissement de santé, ils interviennent en complément, avec l'accord de l'équipe soignante.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur le coach sportif en clinique.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/clinique-remise-en-mouvement-role-du-coach/" data-a="up"><b>Remise en mouvement en clinique : le rôle d'un coach sportif</b><span>Séances encadrées, relais après la sortie, bien-être des équipes : comment un coach sportif diplômé peut intervenir dans une clinique, avec l'accord de l'équipe soignante.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a><a class="ss-chip" href="/professionnels-de-sante/"><span aria-hidden="true">🤝</span> Professionnels de santé</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=clinique#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

<style>
  .sg-bref-sec { padding-top: 28px; padding-bottom: 8px; }
  .sg-bref { border-left: 4px solid #1D5BD8; background: #fff; border-radius: 0 18px 18px 0; padding: 18px 22px; box-shadow: 0 12px 30px -24px rgba(11,30,61,.5); }
  .sg-bref-k { margin: 0 0 8px; font-weight: 700; text-transform: none; letter-spacing: .02em; font-size: 12px; color: #1D5BD8; }
  .sg-bref ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; color: #0B1E3D; line-height: 1.5; }
</style>
