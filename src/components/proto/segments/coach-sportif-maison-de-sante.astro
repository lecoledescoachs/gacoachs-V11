---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-maison-de-sante')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Maisons et pôles de santé</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST SANTÉ · Maisons de santé</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🩺</span></span> <span class="w"><span style="--i: 1;">Un</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">sportif</span></span> <span class="w"><span style="--i: 4;">diplômé</span></span> <span class="w"><span style="--i: 5;">aux</span></span> <span class="w"><span style="--i: 6;">côtés</span></span> <span class="w"><span style="--i: 7;">de</span></span> <span class="w"><span style="--i: 8;">votre</span></span> <span class="w"><span style="--i: 9;">maison</span></span> <span class="w"><span style="--i: 10;">de</span></span> <span class="w"><span style="--i: 11;">santé.</span></span></h1><p class="phero-lead" data-a="up">Ateliers collectifs, relais d'activité physique pour les patients que vous orientez, actions de prévention : un coach du réseau intervient en complément de votre équipe, jamais à sa place.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>En lien avec vos praticiens</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Ateliers collectifs et reprises progressives</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Avec l'accord du patient</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=maison-sante#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> un coach sportif diplômé, relais d'activité physique de votre maison de santé.</li><li><b>Pour qui :</b> maisons et pôles de santé, centres de santé, CPTS, et les patients que vos praticiens orientent.</li><li><b>Comment :</b> ateliers collectifs, programmes de reprise progressive et actions de prévention, toujours avec l'accord du patient.</li><li><b>Ce que vous y gagnez :</b> des patients qui passent du conseil à la pratique, sans charge en plus pour votre équipe.</li></ul></div></div></section>
<BoostOffre id="sante" cta="/services-sur-mesure/?pour=maison-sante#sm-contact" texte="Médecins, kinés, maisons de santé, cliniques : un coach diplômé prend le relais pour la reprise d'activité de vos patients." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Le</span></span> <span class="w"><span style="--i: 1;">constat</span></span> <span class="w"><span style="--i: 2;">de</span></span> <span class="w"><span style="--i: 3;">nombreux</span></span> <span class="w"><span style="--i: 4;">praticiens.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">💬</span><h3>Un conseil qui reste un conseil</h3><p>« Il faut bouger » : les patients l'entendent, mais sans accompagnement, peu passent à l'action.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">⏱️</span><h3>Pas le temps de suivre la reprise</h3><p>Une consultation ne permet pas d'encadrer des séances d'activité physique semaine après semaine.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🔗</span><h3>Peu de relais fiables autour de vous</h3><p>Orienter un patient vers quelqu'un de confiance, diplômé et qui vous fait un retour, n'est pas toujours simple.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qu'un</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">apporte</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">votre</span></span> <span class="w"><span style="--i: 6;">structure.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Un relais après la consultation</h3><p>Conseiller de bouger, c'est une chose. Avoir quelqu'un pour accompagner la reprise, semaine après semaine, en est une autre.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Des ateliers dans vos locaux</h3><p>Des séances collectives de prévention et de remise en mouvement, au plus près de vos patients.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Un retour simple au praticien</h3><p>Avec l'accord du patient, le coach vous fait un retour sur la participation et l'évolution.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">👥</span> Ateliers collectifs</h3><p>Des séances régulières pour de petits groupes, dans vos locaux ou à proximité.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">📈</span> Reprise progressive</h3><p>Un programme sur plusieurs semaines pour les patients qui reprennent une activité.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">📣</span> Prévention</h3><p>Ateliers thématiques et journées de sensibilisation auprès du public.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🩺</span> Pour votre équipe</h3><p>Des séances pour les soignants et le personnel de la structure.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Le patient repart avec un conseil</span><span class="cb-ap">Le patient rejoint un atelier encadré chaque semaine</span></div><div class="cb-r"><span class="cb-av">Aucune nouvelle après la consultation</span><span class="cb-ap">Un retour écrit au praticien, avec l'accord du patient</span></div><div class="cb-r"><span class="cb-av">Des actions de prévention ponctuelles</span><span class="cb-ap">Un cycle d'ateliers régulier dans vos locaux</span></div><div class="cb-r"><span class="cb-av">Chercher un intervenant à chaque fois</span><span class="cb-ap">Un coach diplômé du réseau, toujours le même</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🩺</span><div><h2 class="h2">RELAIS SANTÉ 12</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un cycle d'ateliers pour accompagner la reprise d'activité des patients que vous orientez.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Un cycle d'ateliers pour un groupe de patients : tests de forme au début et à la fin, retour au praticien avec accord.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Un relais permanent : nouveaux groupes chaque trimestre, actions de prévention auprès du public, bilan annuel.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Un entretien d'accueil pour chaque participant, sans diagnostic</li><li>1 atelier collectif par semaine en petit groupe</li><li>Des exercices simples à refaire à la maison</li><li>Des tests de forme simples au début et à la fin du cycle</li><li>Avec l'accord du patient, un retour écrit au praticien</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Un relais concret entre la consultation et la reprise</li><li>Une action de prévention portée par votre structure</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=maison-sante#sm-contact">Demander le programme RELAIS SANTÉ 12</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Notre</span></span> <span class="w"><span style="--i: 1;">rôle</span></span></h2><p class="lead-p" data-a="up">Nos coachs ne posent aucun diagnostic, ne prescrivent aucun traitement et ne remplacent ni les soins ni le suivi médical. En établissement de santé, ils interviennent en complément, avec l'accord de l'équipe soignante.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur le coach sportif en maison de santé.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/maison-de-sante-travailler-avec-un-coach-sportif/" data-a="up"><b>Maison de santé : travailler avec un coach sportif diplômé</b><span>Ateliers collectifs, relais pour les patients, prévention : comment une maison ou un pôle de santé peut collaborer avec un coach sportif, en complément des praticiens.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a><a class="ss-chip" href="/professionnels-de-sante/"><span aria-hidden="true">🤝</span> Professionnels de santé</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=maison-sante#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

