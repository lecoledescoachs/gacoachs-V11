---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-evenement-bar')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Bars</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST EVENT · Bars</span><h1 data-a="words"><span class="w"><span style="--i: 0;">🍻</span></span> <span class="w"><span style="--i: 1;">Un</span></span> <span class="w"><span style="--i: 2;">événement</span></span> <span class="w"><span style="--i: 3;">sportif</span></span> <span class="w"><span style="--i: 4;">qui</span></span> <span class="w"><span style="--i: 5;">remplit</span></span> <span class="w"><span style="--i: 6;">votre</span></span> <span class="w"><span style="--i: 7;">bar</span></span> <span class="w"><span style="--i: 8;">en</span></span> <span class="w"><span style="--i: 9;">semaine.</span></span></h1><p class="phero-lead" data-a="up">Run club au départ de votre bar, défi sportif avant l'afterwork, soirée à thème : un coach diplômé anime, vos clients transpirent, puis restent pour la suite chez vous.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un rendez-vous fixe qui fait venir du monde</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un coach diplômé aux commandes</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Ponctuel ou chaque semaine</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=bar#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> un événement sportif animé par un coach diplômé, au départ de votre bar.</li><li><b>Pour qui :</b> bars, pubs et brasseries d'Orléans et du Loiret qui veulent un rendez-vous fixe.</li><li><b>Comment :</b> run club, défi par équipes ou séance avant un grand match, ponctuel ou chaque semaine.</li><li><b>Ce que vous y gagnez :</b> du monde en semaine et des clients qui reviennent.</li></ul></div></div></section>
<BoostOffre id="event" cta="/services-sur-mesure/?pour=bar#sm-contact" texte="Un run club, une séance avant le brunch, un défi entre amis : le sport qui rassemble, avant la fête." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Remplir</span></span> <span class="w"><span style="--i: 1;">les</span></span> <span class="w"><span style="--i: 2;">soirées</span></span> <span class="w"><span style="--i: 3;">de</span></span> <span class="w"><span style="--i: 4;">semaine,</span></span> <span class="w"><span style="--i: 5;">c'est</span></span> <span class="w"><span style="--i: 6;">le</span></span> <span class="w"><span style="--i: 7;">défi.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📉</span><h3>Des soirées creuses</h3><p>Le lundi, le mardi, certains débuts de soirée : le bar reste à moitié vide.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">📣</span><h3>Une communication qui s'essouffle</h3><p>Trouver de quoi publier chaque semaine sur vos réseaux, c'est un vrai travail.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🤝</span><h3>Des clients de passage</h3><p>Ils viennent une fois, puis vont ailleurs. Une vraie communauté se construit dans le temps.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">organiser</span></span> <span class="w"><span style="--i: 2;">un</span></span> <span class="w"><span style="--i: 3;">événement</span></span> <span class="w"><span style="--i: 4;">sportif</span></span> <span class="w"><span style="--i: 5;">dans</span></span> <span class="w"><span style="--i: 6;">votre</span></span> <span class="w"><span style="--i: 7;">bar.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Des soirées calmes qui se remplissent</h3><p>Un run club ou un défi en début de soirée crée un rendez-vous sur les créneaux où votre bar tourne au ralenti.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Une communauté qui revient</h3><p>Les participants reviennent chaque semaine, avec leurs amis, et votre bar devient leur point de ralliement.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>De quoi animer vos réseaux</h3><p>Photos du groupe, défis, classements : du contenu authentique à partager chaque semaine.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🏃</span> Run club</h3><p>Un parcours de course au départ du bar, plusieurs allures, retour pour l'afterwork.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🔥</span> Défi avant l'afterwork</h3><p>Un défi sportif ludique par équipes, avant de passer au comptoir.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">📺</span> Soirée match</h3><p>Une séance courte avant la diffusion d'un grand match ou d'une course.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🎟️</span> Événement privé</h3><p>Pour un groupe, une entreprise ou une association qui réserve chez vous.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Une soirée calme chaque semaine</span><span class="cb-ap">Un run club qui part et revient chez vous</span></div><div class="cb-r"><span class="cb-av">Rien de nouveau à publier</span><span class="cb-ap">Des défis et des photos de groupe chaque semaine</span></div><div class="cb-r"><span class="cb-av">Des clients de passage</span><span class="cb-ap">Une communauté qui fait de votre bar son QG</span></div><div class="cb-r"><span class="cb-av">Organiser un événement soi-même</span><span class="cb-ap">Le coach anime, vous accueillez</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">🍻</span><div><h2 class="h2">RUN &amp; AFTERWORK</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un run club qui part de votre bar et y revient, chaque semaine.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Le lancement du run club : un rendez-vous chaque semaine pour installer l'habitude.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Une communauté installée : run club toute l'année, défis et soirées à thème à chaque saison.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Un run club hebdomadaire au départ de votre bar, plusieurs allures</li><li>Un défi par équipes une fois par mois</li><li>Des parcours adaptés à tous les niveaux</li><li>Des visuels prêts à publier sur vos réseaux</li><li>Le coach anime, vous accueillez</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Une soirée de semaine qui se remplit</li><li>Une communauté qui revient chez vous</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=bar#sm-contact">Demander le programme RUN &amp; AFTERWORK</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur l'événement sportif dans votre bar.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/evenement-sportif-bar-restaurant-idees/" data-a="up"><b>Organiser un événement sportif dans son bar ou son restaurant</b><span>Run club, séance suivie d'un brunch, défi en soirée : des idées d'événements sportifs pour faire venir du monde dans votre bar ou restaurant.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/coach-sportif-echauffement-course/"><span aria-hidden="true">🏃</span> Échauffement de courses</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-camping/"><span aria-hidden="true">⛺</span> Campings</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=bar#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

