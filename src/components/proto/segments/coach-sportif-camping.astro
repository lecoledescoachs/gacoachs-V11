---
import BoostOffre from '../BoostOffre.astro';
// Contenu repris du prototype validé par Garry
import SEGMENTS from '../../../data/sur-mesure-segments.json';
const faq = (SEGMENTS as any[]).find((x) => x.slug === 'coach-sportif-camping')?.faq ?? [];
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol><symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"></path></symbol><symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.2"></circle></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><a href="/services-sur-mesure/">Services sur mesure</a><span aria-hidden="true">›</span><span>Campings</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">BOOST TOURISME · Campings</span><h1 data-a="words"><span class="w"><span style="--i: 0;">⛺</span></span> <span class="w"><span style="--i: 1;">Des</span></span> <span class="w"><span style="--i: 2;">animations</span></span> <span class="w"><span style="--i: 3;">sportives</span></span> <span class="w"><span style="--i: 4;">encadrées</span></span> <span class="w"><span style="--i: 5;">pour</span></span> <span class="w"><span style="--i: 6;">votre</span></span> <span class="w"><span style="--i: 7;">camping.</span></span></h1><p class="phero-lead" data-a="up">Réveil musculaire, circuit training, séances en famille, plein air : un coach diplômé anime des créneaux réguliers pendant votre saison, pour tous les âges et tous les niveaux.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Pour toute la famille</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Créneaux réguliers sur la saison</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>En plein air, sans matériel lourd</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="/services-sur-mesure/?pour=camping#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#ss-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> des animations sportives encadrées par un coach diplômé pour vos vacanciers.</li><li><b>Pour qui :</b> campings et villages de vacances, pour les enfants, les ados et les adultes.</li><li><b>Comment :</b> des créneaux réguliers en plein air : réveil musculaire, circuit training, séances parents-enfants.</li><li><b>Ce que vous y gagnez :</b> un programme d'animations plus riche et des vacanciers ravis, sans recrutement à gérer.</li></ul></div></div></section>
<BoostOffre id="tourisme" cta="/services-sur-mesure/?pour=camping#sm-contact" texte="Des séances encadrées pour vos clients, sans recrutement à gérer : un vrai service en plus pendant leur séjour." />
<section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Le constat</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">La</span></span> <span class="w"><span style="--i: 1;">haute</span></span> <span class="w"><span style="--i: 2;">saison,</span></span> <span class="w"><span style="--i: 3;">vous</span></span> <span class="w"><span style="--i: 4;">la</span></span> <span class="w"><span style="--i: 5;">connaissez.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🎪</span><h3>Un programme d'animations à remplir</h3><p>Chaque semaine, il faut des rendez-vous variés pour toutes les familles et tous les âges.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🧑‍🤝‍🧑</span><h3>Une équipe d'animation à flux tendu</h3><p>Vos animateurs font beaucoup ; le sport encadré demande des compétences et un diplôme spécifiques.</p></div><div class="tile cb-c" data-a="up"><span class="cb-e" aria-hidden="true">🔁</span><h3>Des vacanciers à faire revenir</h3><p>Ce dont on se souvient d'un séjour, ce sont les moments partagés. Ce sont eux qui donnent envie de revenir.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Ce que vous attendez</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">faire</span></span> <span class="w"><span style="--i: 2;">appel</span></span> <span class="w"><span style="--i: 3;">à</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-heart"></use></svg></span><h3>Un programme d'animations plus riche</h3><p>Des rendez-vous sportifs réguliers que vos vacanciers attendent et qui rythment la semaine.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><h3>Un encadrement par un diplômé</h3><p>Le coach adapte chaque séance à l'âge et au niveau des participants, pour que tout le monde y trouve sa place en sécurité.</p></div><div class="tile" data-a="up"><span class="tic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg></span><h3>Des vacanciers qui reviennent</h3><p>Une animation de qualité fait partie des souvenirs de séjour, et des raisons de revenir l'année suivante.</p></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Les formats</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Les</span></span> <span class="w"><span style="--i: 1;">formats</span></span> <span class="w"><span style="--i: 2;">possibles.</span></span></h2><div class="grid g4 eh-sv" data-group=""><div class="tile" data-a="up"><h3><span aria-hidden="true">🌅</span> Réveil musculaire</h3><p>Une séance douce le matin, ouverte à tous, pour bien démarrer la journée.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">🔥</span> Circuit training</h3><p>Une séance plus dynamique pour les ados et les adultes qui veulent se dépenser.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">👨‍👩‍👧</span> Parents-enfants</h3><p>Des jeux et exercices à faire ensemble, adaptés aux plus jeunes.</p></div><div class="tile" data-a="up"><h3><span aria-hidden="true">☀️</span> Renfort haute saison</h3><p>Des créneaux supplémentaires sur les semaines les plus chargées.</p></div></div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Avant / après</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">qui</span></span> <span class="w"><span style="--i: 2;">change</span></span> <span class="w"><span style="--i: 3;">avec</span></span> <span class="w"><span style="--i: 4;">un</span></span> <span class="w"><span style="--i: 5;">coach</span></span> <span class="w"><span style="--i: 6;">GA.</span></span></h2><div class="cb-aa" data-a="up"><div class="cb-r cb-h"><span>Aujourd'hui</span><span>Avec un coach GA</span></div><div class="cb-r"><span class="cb-av">Des animations sportives improvisées</span><span class="cb-ap">Un planning de séances prêt à afficher pour la semaine</span></div><div class="cb-r"><span class="cb-av">Le sport repose sur vos animateurs</span><span class="cb-ap">Un coach diplômé qui encadre en toute sécurité</span></div><div class="cb-r"><span class="cb-av">Les mêmes activités chaque jour</span><span class="cb-ap">Réveil musculaire, circuit, parents-enfants et grand défi</span></div><div class="cb-r"><span class="cb-av">Aucun retour sur ce qui plaît</span><span class="cb-ap">Un bilan de saison avec la participation par créneau</span></div></div></div></section><section class="sec navy" id="ss-sig"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><span class="eyebrow eyebrow-dark" data-a="pop">Notre programme signature</span><div class="ss-sig" data-a="up"><div class="ss-sig-h"><span aria-hidden="true">⛺</span><div><h2 class="h2">SAISON ACTIVE</h2><b>12 semaines ou 1 an</b></div></div><p class="lead-p">Un programme d'animations sportives prêt à afficher pour tout l'été.</p><div class="ss-sig-f"><div><em>Pour tester</em><b>12 semaines</b><span>Toute la saison d'été couverte : planning hebdomadaire, grand défi chaque fin de semaine, bilan de saison.</span></div><div class="reco"><em>⭐ Notre spécialité</em><b>1 an</b><span>Un partenariat à l'année : la saison d'été, les ailes de saison et des temps forts pour vos clients fidèles, préparés à l'avance.</span></div></div><div class="ss-sig-cols"><div><h3>Ce que comprend le programme</h3><ul><li>Un planning hebdomadaire type : réveil musculaire, circuit training, séances parents-enfants</li><li>Un grand défi en fin de semaine pour réunir les vacanciers</li><li>Des séances adaptées à tous les âges, encadrées par un diplômé</li><li>Un repli prévu en cas de pluie</li><li>Un bilan de saison avec la participation par créneau</li></ul></div><div><h3>Ce que vous obtenez</h3><ul><li>Un programme d'animations plus riche, sans charge pour votre équipe</li><li>Des rendez-vous que les vacanciers attendent et dont ils se souviennent</li></ul><a class="btn btn-primary" href="/services-sur-mesure/?pour=camping#sm-contact">Demander le programme SAISON ACTIVE</a><p class="ss-sig-n">Tarif sur devis, selon le lieu, la fréquence et la durée.</p></div></div></div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="ss-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Vos questions sur le coach sportif en camping.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Pourquoi GA Coachs</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Un</span></span> <span class="w"><span style="--i: 1;">réseau</span></span> <span class="w"><span style="--i: 2;">local,</span></span> <span class="w"><span style="--i: 3;">structuré</span></span> <span class="w"><span style="--i: 4;">et</span></span> <span class="w"><span style="--i: 5;">sérieux.</span></span></h2><div class="cb-pr" data-group=""><div data-a="up"><b>2018</b><span>Partenaire de Basic-Fit à Orléans depuis 2018</span></div><div data-a="up"><b>7</b><span>coachs sportifs diplômés, avec carte professionnelle et assurance RC Pro</span></div><div data-a="up"><b>5</b><span>salles partenaires à Orléans et dans sa métropole</span></div><div data-a="up"><b>63</b><span>villes couvertes dans le Loiret et autour</span></div></div><p class="lead-p" data-a="up" style="margin-top:18px">Un interlocuteur unique pour votre structure, et un coach référent qui connaît vos lieux et votre public.</p></div></section><section class="sec band"><div class="inner"><span class="eyebrow" data-a="pop">Notre guide</span><div class="eh-guides ss-one" data-group=""><a class="tile eh-g" href="/blog/animations-sportives-camping-idees-de-seances/" data-a="up"><b>Animations sportives en camping : idées de séances pour toute la famille</b><span>Réveil musculaire, circuit training, jeux parents-enfants : des idées de séances sportives encadrées pour enrichir le programme d'animations d'un camping.</span><em>Lire le guide →</em></a></div></div></section><section class="sec"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">autres</span></span> <span class="w"><span style="--i: 2;">services</span></span> <span class="w"><span style="--i: 3;">sur</span></span> <span class="w"><span style="--i: 4;">mesure.</span></span></h2><div class="ss-chips" data-a="up"><a class="ss-chip" href="/services-sur-mesure/coach-sportif-vip/"><span aria-hidden="true">👑</span> VIP et personnalités</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-hotel/"><span aria-hidden="true">🏨</span> Hôtels</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-collectivites-administrations/"><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-maison-de-sante/"><span aria-hidden="true">🩺</span> Maisons et pôles de santé</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-clinique/"><span aria-hidden="true">🏥</span> Cliniques</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-bar/"><span aria-hidden="true">🍻</span> Bars</a><a class="ss-chip" href="/services-sur-mesure/coach-sportif-evenement-restaurant/"><span aria-hidden="true">🍽️</span> Restaurants</a><a class="ss-chip" href="/services-sur-mesure/atelier-gestes-et-postures/"><span aria-hidden="true">🦺</span> Gestes et postures</a><a class="ss-chip" href="/services-sur-mesure/evjf-evg-activite-sportive/"><span aria-hidden="true">🎉</span> EVJF et EVG</a></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet.</span></span></h2><a class="btn-final" href="/services-sur-mesure/?pour=camping#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

