---
import BoostPCQ from '../BoostPCQ.astro';
import CoutSeance from '../CoutSeance.astro';
// Contenu de la page Entreprises, repris à l'identique du prototype validé par Garry
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="M3.5 7.5 12 13l8.5-5.5"></path></symbol><symbol id="i-person" viewBox="0 0 24 24"><circle cx="12" cy="6.5" r="4"></circle><path d="M4 22c0-5 3.6-9 8-9s8 4 8 9z"></path></symbol></svg>

    <div>
      <section class="phero" data-hero="">
        <div class="lightning-bg" aria-hidden="true"></div>
        <div class="inner">
          <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><span>Entreprises</span></nav>
          <div class="phero-grid">
            <div>
              <span class="eyebrow eyebrow-dark" data-a="pop">Coaching sportif en entreprise · BOOST ENTREPRISE™</span>
              <h1 data-a="words" data-hl="0,1"><span class="w hl"><span style="--i: 0;">30</span></span> <span class="w hl"><span style="--i: 1;">minutes</span></span> <span class="w"><span style="--i: 2;">pour</span></span> <span class="w"><span style="--i: 3;">faire</span></span> <span class="w"><span style="--i: 4;">bouger</span></span> <span class="w"><span style="--i: 5;">votre</span></span> <span class="w"><span style="--i: 6;">entreprise.</span></span></h1>
              <p class="phero-lead" data-a="up">Le coaching entreprise pensé pour s'intégrer à une vraie journée de travail. Testez BOOST ENTREPRISE™ avec vos équipes grâce à BOOST 30, notre format découverte offert.</p>
              <p class="phero-sub" data-a="up">En seulement 30 minutes, nous testons le programme dans vos conditions réelles et vous recommandons la formule la plus adaptée.</p>
              <ul class="checks" data-a="up">
                <li>Pas besoin d'être sportif.</li>
                <li>Pas besoin d'une salle de sport.</li>
                <li>Pas besoin de bouleverser les journées de travail.</li>
              </ul>
              <div class="ctas" data-a="up">
                <a class="btn btn-primary" href="#e-form">Réserver mon BOOST 30 offert</a>
                <a class="btn btn-glass" href="#e-formules">Découvrir les formules</a>
              </div>
              <p class="micro" data-a="up"><b>30 minutes · dans votre entreprise · sans engagement</b><br>Orléans · Métropole orléanaise · Déploiement national à venir</p>
            </div>
            <div class="visual" data-a="zoom">
              <div class="tilt" data-tilt=""><img src="/images/design/img-boost-entreprise.webp" data-same="IMG_BOOSTENT" alt="BOOST ENTREPRISE, coaching sportif en entreprise" width="1000" height="525"></div>
              <span class="float-chip">BOOST 30 offert</span>
              <div class="timer" aria-hidden="true">
                <svg viewBox="0 0 50 50"><circle cx="25" cy="25" r="22" fill="none" stroke="#E3EBFD" stroke-width="5"></circle><circle class="t-arc" cx="25" cy="25" r="22" fill="none" stroke="#2F6FED" stroke-width="5" stroke-linecap="round"></circle></svg>
                <div><span class="timer-n" id="eTimer">30:00</span><span class="timer-l">par séance, sur site</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <nav class="subnav" id="eSubnav" aria-label="Sur cette page">
        <div class="inner subnav-in">
          <a href="#e-boost30">BOOST 30</a>
          <a href="#e-30min">30 minutes</a>
          <a href="#e-57">BOOST 5/7</a>
          <a href="#e-formules">Formules</a>
          <a href="#e-simu">Simulateur</a>
          <a href="#e-faq">FAQ</a>
          <a class="subnav-cta" href="#e-form">Réserver</a>
        </div>
      </nav>

      <!-- Ils nous font confiance -->
      <section class="sec" style="padding-bottom: 40px;">
        <div class="inner center">
          <span class="eyebrow" data-a="pop">Ils nous font confiance</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ils</span></span> <span class="w"><span style="--i: 1;">font</span></span> <span class="w"><span style="--i: 2;">bouger</span></span> <span class="w"><span style="--i: 3;">leur</span></span> <span class="w"><span style="--i: 4;">entreprise</span></span> <span class="w"><span style="--i: 5;">avec</span></span> <span class="w"><span style="--i: 6;">BOOST.</span></span></h2>
          <p class="lead-p" data-a="up">Coaching déjà réalisé chez</p>
        </div>
      </section>
      <section class="partners" data-group="" aria-label="Entreprises et partenaires" style="margin-top: 0;">
        <p class="partners-k">Entreprises et partenaires</p>
        <div class="marquee" id="eMarquee">
          <div class="logos">
            <img style="padding: 15.1px 60.3px;" data-a="pop" src="/images/logos/trim/basic-fit.webp" data-same="L_BASICFIT" alt="Basic-Fit" height="68">
            <img style="padding: 15.0px 61.0px;" data-a="pop" src="/images/logos/trim/ecole-des-coachs.webp" data-same="L_ECOLE" alt="L'École des Coachs" height="68">
            <img style="padding: 15.0px 67.7px;" data-a="pop" src="/images/logos/trim/sport-sante-france.webp" data-same="L_SSF" alt="Sport Santé France" height="68">
            <img style="padding: 26.6px 42.7px;" data-a="pop" src="/images/logos/trim/tournee-des-coachs.webp" data-same="L_TOURNEE" alt="La Tournée des Coachs" height="68">
            <img style="padding: 26.9px 42.1px;" data-a="pop" src="/images/logos/trim/ikea.webp" alt="IKEA" height="68">
            <img style="padding: 21.3px 52.8px;" data-a="pop" src="/images/logos/trim/reliance-centre.webp" alt="Reliance Centre" height="68">
          </div>
        <div class="logos" aria-hidden="true">
            <img style="padding: 15.1px 60.3px;" src="/images/logos/trim/basic-fit.webp" data-same="L_BASICFIT" alt="" height="68">
            <img style="padding: 15.0px 61.0px;" src="/images/logos/trim/ecole-des-coachs.webp" data-same="L_ECOLE" alt="" height="68">
            <img style="padding: 15.0px 67.7px;" src="/images/logos/trim/sport-sante-france.webp" data-same="L_SSF" alt="" height="68">
            <img style="padding: 26.6px 42.7px;" src="/images/logos/trim/tournee-des-coachs.webp" data-same="L_TOURNEE" alt="" height="68">
            <img style="padding: 26.9px 42.1px;" src="/images/logos/trim/ikea.webp" alt="" height="68">
            <img style="padding: 21.3px 52.8px;" src="/images/logos/trim/reliance-centre.webp" alt="" height="68">
          </div></div>
      </section>

      <!-- BOOST 30 offert -->
      <section class="sec" id="e-boost30">
        <div class="inner">
          <span class="eyebrow" data-a="pop">BOOST 30 · Offert</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Avant</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">vous</span></span> <span class="w"><span style="--i: 3;">vendre</span></span> <span class="w"><span style="--i: 4;">une</span></span> <span class="w"><span style="--i: 5;">formule,</span></span> <span class="w"><span style="--i: 6;">on</span></span> <span class="w"><span style="--i: 7;">préfère</span></span> <span class="w"><span style="--i: 8;">vous</span></span> <span class="w"><span style="--i: 9;">la</span></span> <span class="w"><span style="--i: 10;">faire</span></span> <span class="w"><span style="--i: 11;">vivre.</span></span></h2>
          <p class="lead-p" data-a="up">Un programme de sport en entreprise ne se choisit pas uniquement sur une plaquette. Il faut vérifier si vos salariés participent, si le créneau est adapté, si le format fonctionne, si les équipes adhèrent, si l'organisation est simple. C'est exactement le rôle de BOOST 30.</p>
          <div class="tbar" data-a="up">
            <div class="tbar-track" aria-hidden="true">
              <span class="tbar-seg s1" style="flex: 5;"><i></i><b>5 MIN</b></span>
              <span class="tbar-seg s2" style="flex: 20;"><i></i><b>20 MIN</b></span>
              <span class="tbar-seg s3" style="flex: 5;"><i></i><b>5 MIN</b></span>
            </div>
            <div class="tbar-steps">
              <div><span class="k">5 min</span><h3>Comprendre votre entreprise</h3><p>Effectif, contraintes, horaires, espaces disponibles, attentes.</p></div>
              <div><span class="k">20 min</span><h3>Faire vivre BOOST</h3><p>Une séance courte, accessible et adaptée à votre équipe.</p></div>
              <div><span class="k">5 min</span><h3>Recommandation</h3><p>Retour à chaud et recommandation de fréquence : Essentiel, Performance ou 5/7.</p></div>
            </div>
          </div>
          <p class="shout"><span data-a="left">Vous testez.</span><span data-a="right">Vos équipes participent.</span><span data-a="left">Nous recommandons.</span></p>
          <p class="lead-p" data-a="up">Pas de vente à l'aveugle. Pas de contrat avant d'avoir vu comment BOOST fonctionne chez vous.</p>
          <div class="offer-grid">
            <div class="tile" data-a="up">
              <h3>Ce que votre entreprise obtient avec BOOST 30</h3>
              <ul class="tick-list">
                <li>Un échange rapide avec un interlocuteur GA Coachs</li>
                <li>Un test réel avec vos salariés</li>
                <li>Une évaluation de l'adhésion</li>
                <li>Un avis sur le meilleur créneau</li>
                <li>Une recommandation de fréquence</li>
                <li>Un retour sur l'organisation</li>
                <li>Une proposition adaptée si vous souhaitez continuer</li>
              </ul>
              <span class="value">Valeur : offerte</span>
            </div>
            <div class="tile" data-a="up">
              <h3>Pourquoi l'offrir ?</h3>
              <p>Parce que nous préférons vous aider à vérifier que BOOST fonctionne dans votre entreprise avant de vous proposer un abonnement. Nous ne voulons pas vous vendre des séances. Nous voulons construire un programme que vos équipes utilisent réellement.</p>
              <p class="small-note">BOOST 30 est offert aux entreprises situées dans les zones couvertes par GA Coachs, sous réserve de disponibilité et d'éligibilité (localisation, taille du groupe, disponibilité des coachs, faisabilité de l'intervention).</p>
              <a class="btn btn-primary" href="#e-form" style="margin-top: 20px;">Réserver mon BOOST 30 offert</a>
            </div>
          </div>
        </div>
      </section>

      <section class="navy quote-band">
        <div class="lightning-bg" data-a="charge" aria-hidden="true"></div>
        <div class="inner">
          <p class="big" data-a="up">Nous ne vous demandons pas de croire que BOOST fonctionne.<b>Nous vous proposons de le tester.</b></p>
          <p data-a="up">BOOST 30 OFFERT · 30 minutes pour tester le programme dans votre entreprise.</p>
        </div>
      </section>

      <!-- Chiffres -->
      <section class="sec" id="e-chiffres">
        <div class="inner">
          <span class="eyebrow" data-a="pop">La réalité chiffrée</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">La</span></span> <span class="w"><span style="--i: 1;">santé</span></span> <span class="w"><span style="--i: 2;">de</span></span> <span class="w"><span style="--i: 3;">vos</span></span> <span class="w"><span style="--i: 4;">équipes</span></span> <span class="w"><span style="--i: 5;">en</span></span> <span class="w"><span style="--i: 6;">chiffres.</span></span></h2>
          <div class="grid stats4" id="eStats"><div class="tile" data-a="pop"><div class="bigstat"><span data-count="17">17</span>&nbsp;%</div><p class="stat-txt">seulement des entreprises françaises proposent une offre sportive à leurs salariés, alors que 87 % des dirigeants reconnaissent les bienfaits du sport en entreprise.</p><span class="src">Source : Harmonie Mutuelle, baromètre sport en entreprise</span></div><div class="tile" data-a="pop"><div class="bigstat"><span data-count="90">90</span>&nbsp;%</div><p class="stat-txt">des maladies professionnelles reconnues en France sont des troubles musculosquelettiques (TMS).</p><span class="src">Source : Assurance Maladie / INRS, 2024</span></div><div class="tile" data-a="pop"><div class="bigstat"><span data-count="11">11</span>&nbsp;M</div><p class="stat-txt">de journées de travail perdues en 2021 à cause des TMS, pour plus d'1 milliard d'euros de frais couverts par les entreprises.</p><span class="src">Source : INRS, statistiques TMS</span></div><div class="tile" data-a="pop"><div class="bigstat">1/<span data-count="5">5</span></div><p class="stat-txt">des adultes déclarent passer plus de 7 heures par jour en position assise.</p><span class="src">Source : Santé publique France, baromètre activité physique 2021</span></div></div>
        </div>
      </section>

      <!-- Le coût de l'inaction -->
      <section class="sec navy">
        <div class="inner">
          <span class="eyebrow" data-a="pop">Le coût de l'inaction</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">La</span></span> <span class="w"><span style="--i: 1;">santé</span></span> <span class="w"><span style="--i: 2;">de</span></span> <span class="w"><span style="--i: 3;">vos</span></span> <span class="w"><span style="--i: 4;">salariés</span></span> <span class="w"><span style="--i: 5;">n'est</span></span> <span class="w"><span style="--i: 6;">pas</span></span> <span class="w"><span style="--i: 7;">une</span></span> <span class="w"><span style="--i: 8;">dépense.</span></span> <span class="w"><span style="--i: 9;">L'inaction,</span></span> <span class="w"><span style="--i: 10;">elle,</span></span> <span class="w"><span style="--i: 11;">peut</span></span> <span class="w"><span style="--i: 12;">en</span></span> <span class="w"><span style="--i: 13;">devenir</span></span> <span class="w"><span style="--i: 14;">une.</span></span></h2>
          <p class="lead-p" data-a="up">Fatigue, sédentarité, stress, douleurs, TMS, désengagement… Un à un, ces signaux semblent anodins. Additionnés sur toute l'équipe et sur plusieurs années, ils se traduisent en arrêts, en départs et en baisse d'engagement.</p>
          <div class="grid g4" id="eInaction"><div class="glass" data-a="zoom"><span class="ico">🪑</span><h3>Sédentarité</h3><p>Des journées passées majoritairement assis, sans rupture active.</p></div><div class="glass" data-a="zoom"><span class="ico">🦴</span><h3>Douleurs / TMS</h3><p>Première cause de maladie professionnelle reconnue en France.</p></div><div class="glass" data-a="zoom"><span class="ico">🔋</span><h3>Fatigue</h3><p>Une énergie qui baisse au fil de la journée et de la semaine.</p></div><div class="glass" data-a="zoom"><span class="ico">😮‍💨</span><h3>Stress</h3><p>Un quotidien professionnel sans réel temps de coupure.</p></div><div class="glass" data-a="zoom"><span class="ico">📅</span><h3>Absentéisme</h3><p>Un sujet suivi de près par toutes les directions RH.</p></div><div class="glass" data-a="zoom"><span class="ico">🔌</span><h3>Désengagement</h3><p>Des collaborateurs moins impliqués dans la vie collective.</p></div><div class="glass" data-a="zoom"><span class="ico">🔄</span><h3>Turn-over</h3><p>Un enjeu de fidélisation, notamment chez les jeunes actifs.</p></div><div class="glass" data-a="zoom"><span class="ico">🧲</span><h3>Attractivité employeur</h3><p>Un critère de plus en plus regardé par les candidats.</p></div></div>
          <p class="punch" data-a="up"><b>BOOST ENTREPRISE™</b> agit en prévention en installant une habitude simple : remettre régulièrement les collaborateurs en mouvement.</p>
        </div>
      </section>

      <!-- Sans action / avec BOOST -->
      <section class="sec">
        <div class="inner">
          <span class="eyebrow" data-a="pop">Concrètement</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Ce</span></span> <span class="w"><span style="--i: 1;">que</span></span> <span class="w"><span style="--i: 2;">vous</span></span> <span class="w"><span style="--i: 3;">perdez</span></span> <span class="w"><span style="--i: 4;">à</span></span> <span class="w"><span style="--i: 5;">ne</span></span> <span class="w"><span style="--i: 6;">rien</span></span> <span class="w"><span style="--i: 7;">faire.</span></span> <span class="w"><span style="--i: 8;">Ce</span></span> <span class="w"><span style="--i: 9;">que</span></span> <span class="w"><span style="--i: 10;">vous</span></span> <span class="w"><span style="--i: 11;">gagnez</span></span> <span class="w"><span style="--i: 12;">à</span></span> <span class="w"><span style="--i: 13;">agir.</span></span></h2>
          <div class="seg2" role="group" aria-label="Afficher les cartes" data-a="up">
            <button type="button" data-side="sans" aria-pressed="true">Sans action</button>
            <button type="button" data-side="avec" aria-pressed="false">Avec BOOST ENTREPRISE™</button>
          </div>
          <div class="grid g3" id="ePg"><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">Vous restez dans les 83% d'entreprises françaises qui ne proposent aucune offre sportive, pendant que la concurrence commence à s'en servir comme argument de recrutement.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">Une vraie offre bien-être à mettre en avant auprès des candidats, pas juste une salle de sport vide dans la plaquette RH.</span></span></span></button><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">Les TMS restent la première cause de maladie professionnelle reconnue en France, sans action de prévention active dans vos équipes.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">Des collaborateurs qui bougent régulièrement, avec un travail préventif sur les douleurs les plus fréquentes (dos, épaules, nuque).</span></span></span></button><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">Des journées de travail perdues année après année, sans qu'aucun levier concret ne soit activé pour les réduire.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">Un levier de prévention régulier, dont vous suivez la participation et la satisfaction dès les premières semaines de mise en place.</span></span></span></button><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">Des collaborateurs qui n'ont, la plupart du temps, aucun moment collectif hors réunions de travail.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">Un vrai temps de cohésion partagé, le seul moment où toute une équipe bouge ensemble, sans hiérarchie de sujet.</span></span></span></button><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">Aucun temps dégagé pour la santé de vos équipes : entre les réunions et la charge de travail, ça finit toujours par passer après.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">30 minutes seulement, directement dans vos locaux, sans vestiaire ni trajet à prévoir. Le format pensé pour tenir dans un agenda réel.</span></span></span></button><button class="pg-card" type="button" data-a="up" aria-pressed="false"><span class="pg-inner"><span class="pg-face pg-sans"><span class="pg-tag">SANS ACTION</span><span class="pg-txt">L'absentéisme pèse sur toute l'organisation : remplacements, retards, charge reportée sur les collègues.</span><span class="pg-hint">Voir avec BOOST ↻</span></span><span class="pg-face pg-avec"><span class="pg-tag">AVEC BOOST ENTREPRISE™</span><span class="pg-txt">Une action de prévention concrète, de 299€ à 999€/mois pour toute l'équipe, à comparer à vos propres coûts d'absence.</span></span></span></button></div>
        </div>
      </section>

      <!-- 30 minutes et pas 1 heure -->
      <section class="sec band" id="e-30min">
        <div class="inner">
          <span class="eyebrow" data-a="pop">Notre différence</span>
          <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Pourquoi</span></span> <span class="w"><span style="--i: 1;">nos</span></span> <span class="w"><span style="--i: 2;">séances</span></span> <span class="w"><span style="--i: 3;">durent</span></span> <span class="w"><span style="--i: 4;">30</span></span> <span class="w"><span style="--i: 5;">minutes</span></span> <span class="w"><span style="--i: 6;">et</span></span> <span class="w"><span style="--i: 7;">pas</span></span> <span class="w"><span style="--i: 8;">1</span></span> <span class="w"><span style="--i: 9;">heure&nbsp;?</span></span></h2>
          <p class="lead-p" data-a="up">Parce que la meilleure séance n'est pas la plus longue. C'est celle à laquelle vos salariés participent réellement.</p>
          <div class="vs-grid">
            <div class="tile vs-col vs-old" data-a="left">
              <h3>Format classique 1h</h3>
              <ul><li>1 heure à bloquer</li><li>Organisation plus complexe</li><li>Pause déjeuner largement mobilisée</li><li>Vestiaires potentiellement nécessaires</li><li>Participation plus difficile à maintenir</li><li>Plus difficile à intégrer plusieurs fois par semaine</li></ul>
            </div>
            <span class="vs-badge" data-a="pop">VS</span>
            <div class="tile vs-col vs-new" data-a="right">
              <h3>BOOST ENTREPRISE™ · 30 min</h3>
              <ul><li>30 minutes seulement</li><li>Facile à intégrer dans la journée</li><li>1 à 2 rendez-vous réguliers par semaine</li><li>Accessible aux débutants</li><li>Peu ou pas de matériel</li><li>Possible dans les locaux ou en extérieur</li><li>Moins de friction organisationnelle</li></ul>
            </div>
          </div>
          <p class="formula" data-a="zoom">30 minutes × régularité <span class="gt">&gt;</span> 1 heure × irrégularité</p>
        </div>
      </section>

      <!-- BOOST 5/7 -->
      <section class="sec navy" id="e-57">
        <div class="lightning-bg" data-a="charge" aria-hidden="true"></div>
