---
// Accueil : « Pour aller plus vite », la carte Bilan Santé à remplir directement
import BilanCarte from '../BilanCarte.astro';
---
<section class="sec cba" id="carte-bilan" aria-labelledby="cba-t">
  <div class="inner cba-in">
    <div class="cba-txt">
      <span class="eyebrow">Pour aller plus vite</span>
      <h2 class="h2" id="cba-t">Réserve ton bilan santé <span class="cba-hl">avec un coach.</span></h2>
      <p class="lead-p">Remplis ta carte en 30 secondes : un coach GA te recontacte pour fixer ton créneau, dans ta salle Basic-Fit.</p>
      <p class="cba-rare"><span class="cba-dot" aria-hidden="true"></span><span><b>Places limitées.</b> Fort de notre succès, nous avons de moins en moins de places disponibles chaque semaine.</span></p>
      <ul class="cba-pts">
        <li>Un coach diplômé, en polo bleu</li>
        <li>Une heure en salle avec ton coach</li>
        <li>Contact par appel, SMS ou WhatsApp</li>
      </ul>
      <ol class="cba-lv" aria-label="5 niveaux, 30 secondes">
        <li><b>1</b>Objectif</li><li><b>2</b>Salle</li><li><b>3</b>Dispos</li><li><b>4</b>Contact</li><li><b>5</b>Coach</li>
      </ol>
    </div>
    <div class="cba-card" data-a="zoom">
      <span class="cba-fx is-1" aria-hidden="true">+20 XP</span><span class="cba-fx is-2" aria-hidden="true">+20 XP</span><span class="cba-fx is-3" aria-hidden="true">+20 XP</span>
      <BilanCarte note="" rare={false} />
    </div>
  </div>
</section>

<style is:global>
  .proto .cba { background: linear-gradient(180deg, #F6F8FF 0%, #EAF2FF 100%); }
  .proto .cba-in { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 32px 48px; align-items: center; }
  .proto .cba-hl { color: var(--blue, #2F6FED); }
  .proto .cba-rare { display: flex; gap: 12px; align-items: flex-start; margin: 22px 0 0; padding: 14px 18px; border-radius: 16px; background: #fff; border: 2px solid #DCE6FA; font-size: 15px; line-height: 1.5; color: #13203B; max-width: 46ch; }
  .proto .cba-rare b { color: #0037B6; }
  .proto .cba-dot { position: relative; flex: none; width: 12px; height: 12px; margin-top: 5px; border-radius: 50%; background: #0037B6; }
  .proto .cba-dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid #2F6FED; animation: cba-ping 1.8s ease-out infinite; }
  @keyframes cba-ping { 0% { transform: scale(.6); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }
  .proto .cba-pts { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 8px; }
  .proto .cba-pts li { position: relative; padding-left: 28px; font-size: 15px; font-weight: 700; color: #13203B; }
  .proto .cba-pts li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 20px; height: 20px; border-radius: 50%; background: #0037B6; color: #fff; font-size: 12px; display: grid; place-items: center; }
  .proto .cba-card .bilan-fallback { margin-top: 0; }
  .proto .cba-lv { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; max-width: 420px; }
  .proto .cba-lv li { display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 8px 2px 7px; border-radius: 12px; background: #fff; border: 2px solid #DCE6FA; font-size: 11.5px; font-weight: 700; color: #13203B; animation: cba-niv 7.5s ease-in-out infinite; animation-delay: calc(var(--n, 0) * 1.2s); }
  .proto .cba-lv li:nth-child(1) { --n: 0; } .proto .cba-lv li:nth-child(2) { --n: 1; } .proto .cba-lv li:nth-child(3) { --n: 2; } .proto .cba-lv li:nth-child(4) { --n: 3; } .proto .cba-lv li:nth-child(5) { --n: 4; }
  .proto .cba-lv b { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: #0037B6; color: #fff; font: 400 10px/1 'Press Start 2P', ui-monospace, monospace; }
  @keyframes cba-niv { 0%, 20%, 100% { background: #fff; border-color: #DCE6FA; transform: none; } 6%, 14% { background: #DCE6FA; border-color: #0037B6; transform: translateY(-3px); } }
  .proto .cba-card { position: relative; }
  .proto .cba-fx { position: absolute; z-index: 3; pointer-events: none; font: 400 11px/1 'Press Start 2P', ui-monospace, monospace; color: #0037B6; text-shadow: 0 2px 0 #fff, 2px 0 0 #fff, -2px 0 0 #fff; opacity: 0; animation: cba-xp 5.4s ease-out infinite; }
  .proto .cba-fx.is-1 { left: 6%; top: 8%; } .proto .cba-fx.is-2 { right: 6%; top: 30%; animation-delay: 1.8s; } .proto .cba-fx.is-3 { left: 8%; bottom: 32%; animation-delay: 3.6s; }
  @keyframes cba-xp { 0% { opacity: 0; transform: translateY(14px) scale(.7); } 12% { opacity: 1; transform: translateY(0) scale(1.1); } 40% { opacity: 1; } 60%, 100% { opacity: 0; transform: translateY(-34px) scale(1); } }
  @media (max-width: 980px) { .proto .cba-in { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .proto .cba-dot::after, .proto .cba-lv li, .proto .cba-fx { animation: none; } .proto .cba-fx { display: none; } }
</style>
