---
// « Le bleu GA » : le showroom de la tenue de l'équipe, avec un mannequin homme et un mannequin femme.
// Le futur client s'y projette (« c'est le coach que je repère en salle »), le futur coach aussi (« c'est ma future tenue »).
// Effets : allumage du showroom, apparition par balayage, rotation sur plusieurs vues (souris, doigt, clavier),
// changement de tenue au laser, relief qui suit la souris, zooms sur les détails. Script : src/scripts/vitrine.js
// Photos : public/images/tenue/ (détourées, même échelle, même sol). Vues : angle (a, en degrés) et largeur
// de la silhouette (w, part de la largeur de l'image) pour le fondu entre deux vues voisines.
const T = '/images/tenue/';
type Hot = { id: string; x: number; y: number; img: string; titre: string; sous?: string };
type Vue = { id: string; a: number; w: number };
type Mannequin = { qui: string; nom: string; fh: number; iw: number; ih: number; vues: Vue[]; tenues: Record<string, string>; bas: Record<string, string>; hot: Record<string, Hot[]> };
const chaussures = { id: 'chaussure', titre: 'Les chaussures blanches' };
const mannequins: Mannequin[] = [
  {
    qui: 'homme', nom: 'homme', fh: 1, iw: 350, ih: 892,
    vues: [{ id: 'face', a: 0, w: 0.886 }, { id: 'dos', a: 180, w: 0.871 }],
    tenues: { longue: 'homme-jogging', courte: 'homme-short' },
    bas: { longue: 'jogging bleu marine', courte: 'short bleu marine' },
    hot: {
      longue: [
        { id: 'logo', x: 67.1, y: 23.8, img: 'logo', titre: 'Le logo GA', sous: 'Côté cœur' },
        { id: 'manche', x: 13.5, y: 28.4, img: 'manche', titre: 'La manche courte' },
        { id: 'bas', x: 35, y: 56, img: 'jogging', titre: 'Le jogging bleu marine', sous: 'Cordon et poche zippée' },
        { ...chaussures, x: 20, y: 94.6, img: 'chaussure-homme' },
      ],
      courte: [
        { id: 'logo', x: 67.9, y: 24.1, img: 'logo', titre: 'Le logo GA', sous: 'Côté cœur' },
        { id: 'manche', x: 13.8, y: 28.4, img: 'manche', titre: 'La manche courte' },
        { id: 'bas', x: 77, y: 61.6, img: 'short-homme', titre: 'Le short bleu marine' },
        { ...chaussures, x: 16.5, y: 95, img: 'chaussure-homme' },
      ],
    },
  },
  {
    qui: 'femme', nom: 'femme', fh: 0.935, iw: 234, ih: 703,
    vues: [{ id: 'face', a: 0, w: 0.904 }, { id: 'droite', a: 90, w: 0.532 }, { id: 'dos', a: 180, w: 0.93 }, { id: 'gauche', a: 270, w: 0.536 }],
    tenues: { longue: 'femme-legging', courte: 'femme-short' },
    bas: { longue: 'legging bleu marine', courte: 'short bleu marine' },
    hot: {
      longue: [
        { id: 'col', x: 51.8, y: 21.3, img: 'col-femme', titre: 'Le col polo' },
        { id: 'bas', x: 72.6, y: 51, img: 'legging', titre: 'Le legging bleu marine' },
        { ...chaussures, x: 21.5, y: 95.6, img: 'chaussure-femme' },
      ],
      courte: [
        { id: 'col', x: 51.8, y: 21.5, img: 'col-femme', titre: 'Le col polo' },
        { id: 'bas', x: 72, y: 51.5, img: 'short-femme', titre: 'Le short bleu marine' },
        { ...chaussures, x: 16.5, y: 95.6, img: 'chaussure-femme' },
      ],
    },
  },
];
const alt = (m: Mannequin, v: string, t: string) =>
  v === 'face' ? `Mannequin ${m.nom} de face : polo bleu GA, ${m.bas[t]} et chaussures blanches`
  : v === 'dos' ? `Mannequin ${m.nom} de dos : « COACH » écrit en blanc sur le polo bleu`
  : `Mannequin ${m.nom} de profil, côté ${v}`;
const tenues = [
  { id: 'longue', label: 'Jogging · legging' },
  { id: 'courte', label: 'Short' },
];
// Poussières de lumière (positions fixes, pas d'aléatoire au rendu)
const grains = Array.from({ length: 16 }, (_, i) => ({ x: (i * 37) % 100, d: 6 + ((i * 7) % 9), r: (i * 0.73) % 6, s: 2 + (i % 3) }));
---
<section class="bga" id="bleu-ga" aria-labelledby="bga-t">
  <div class="bga-glow" aria-hidden="true"></div>
  <div class="inner bga-in">
    <div class="bga-txt">
      <span class="bga-k">Le bleu GA</span>
      <h2 id="bga-t">Un coach en bleu dans ta salle&nbsp;? <span>C'est l'équipe GA.</span></h2>
      <p>Polo bleu GA, bas bleu marine et chaussures blanches&nbsp;: quand tu croises cette tenue dans un Basic-Fit, c'est un coach du réseau GA.</p>
      <div class="bga-duo">
        <a class="bga-who" href="/trouver-un-coach/">
          <span class="bga-who-k">Tu cherches un coach&nbsp;?</span>
          <b>Repère le polo bleu dans ta salle.</b>
          <small>Ou trouve-le directement en ligne&nbsp;→</small>
        </a>
        <a class="bga-who" href="/rejoindre/">
          <span class="bga-who-k">Tu es coach sportif&nbsp;?</span>
          <b>Imagine-toi dans cette tenue.</b>
          <small>C'est celle de l'équipe que tu peux rejoindre&nbsp;→</small>
        </a>
      </div>
      <div class="bga-cta">
        <a class="bga-btn" href="/trouver-un-coach/">Trouver mon coach en bleu</a>
        <span class="bga-chip"><i aria-hidden="true"></i>Bleu GA · #0037B6</span>
      </div>
    </div>

    <figure class="sw" id="bga-vit" data-tenue="longue">
      <div class="sw-scene">
        <div class="sw-sign" aria-hidden="true"><span>GA COACHS</span><small>la tenue de l'équipe</small></div>
        <div class="sw-beams" aria-hidden="true">
          <span class="sw-beam b1"></span><span class="sw-beam b2"></span>
          {grains.map((g) => <i class="sw-grain" style={`--gx:${g.x}%;--gd:${g.d}s;--gr:-${g.r}s;--gs:${g.s}px`}></i>)}
        </div>
        <div class="sw-floor" aria-hidden="true"></div>
        <div class="sw-stage">
          {mannequins.map((m) => (
            <div class="sw-stand" data-qui={m.qui} data-vue="face" style={`--fh:${m.fh};--fr:${(m.iw / m.ih).toFixed(4)}`}>
              <div class="sw-socle" aria-hidden="true"><i></i></div>
              <div class="sw-turn" tabindex="0" role="group" aria-label={`Mannequin ${m.nom} en tenue GA. Fais-le tourner en le faisant glisser, en appuyant dessus ou avec les flèches du clavier.`}>
                {m.vues.map((v) => (
                  <div class={`sw-face is-${v.id}`} data-id={v.id} data-a={v.a} data-w={v.w}>
                    {tenues.map((t) => (
                      <img class={`sw-img${t.id === 'longue' ? ' on' : ''}`} data-tenue={t.id} src={`${T}${m.tenues[t.id]}-${v.id}.webp`} alt={alt(m, v.id, t.id)} width={m.iw} height={m.ih} loading="lazy" decoding="async" draggable="false" />
                    ))}
                    <span class="sw-shine" aria-hidden="true"></span>
                    <span class="sw-scan" aria-hidden="true"></span>
                    {v.id === 'face' && tenues.map((t) => m.hot[t.id].map((h) => (
                      <button type="button" class="sw-hot" data-tenue={t.id} data-img={`${T}detail-${h.img}.webp`} data-titre={h.titre} data-sous={h.sous || ''} style={`--x:${h.x}%;--y:${h.y}%`} aria-label={`Zoom : ${h.titre.toLowerCase()}`} aria-expanded="false"><i></i></button>
                    )))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="sw-loupe" aria-hidden="true">
          <span class="sw-loupe-img"><img src={`${T}detail-logo.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" /></span>
          <span class="sw-loupe-txt"><em>Zoom</em><b>Le logo GA</b><small></small></span>
        </div>
      </div>
      <figcaption class="sw-ctl">
        <span class="sw-seg" role="group" aria-label="Choix de la tenue">
          {tenues.map((t, i) => <button type="button" data-tenue-btn={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
        </span>
        <button type="button" class="sw-flip" data-flip aria-pressed="false">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 4 0 0 0 15.5 2.8" /><path d="M21 12a9 4 0 0 0-15.5-2.8" /><path d="m17 17 1.5-2.2L21 16" /><path d="M7 7 5.5 9.2 3 8" /></svg>
          <span class="v-face">Voir le dos</span><span class="v-dos">Voir la face</span>
        </button>
        <span class="sw-hint">Glisse un mannequin pour le faire tourner, touche un point pour zoomer.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style is:global>
  .proto .bga { position: relative; overflow: hidden; background: #0037B6; color: #fff; padding-block: 76px; }
  .proto .bga-glow { position: absolute; inset: 0; background: radial-gradient(circle at 78% 40%, rgba(124,196,255,.45), transparent 55%), radial-gradient(circle at 10% 100%, rgba(0,2,11,.45), transparent 50%); pointer-events: none; }
  .proto .bga-in { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px 56px; align-items: center; }
  .proto .bga-k { display: inline-block; padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.3); font-size: 13px; font-weight: 700; }
  .proto .bga h2 { margin: 16px 0 14px; font-family: var(--display); font-size: clamp(30px, 2.4vw + 14px, 46px); line-height: 1.1; font-weight: 700; color: #fff; text-wrap: balance; }
  .proto .bga h2 span { display: block; color: #BFE2FF; }
  .proto .bga-txt > p { font-size: 17px; line-height: 1.65; color: rgba(255,255,255,.9); max-width: 52ch; }
  .proto .bga-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 24px; }
  .proto .bga-who { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border-radius: 18px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.22); color: #fff; transition: background .2s, transform .2s; }
  .proto .bga-who:hover { background: rgba(255,255,255,.18); transform: translateY(-2px); }
  .proto .bga-who-k { font-size: 12.5px; font-weight: 700; letter-spacing: .04em; text-transform: none; color: #BFE2FF; }
  .proto .bga-who b { font-size: 16.5px; line-height: 1.3; }
  .proto .bga-who small { font-size: 13.5px; color: rgba(255,255,255,.85); font-weight: 600; }
  .proto .bga-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 24px; }
  .proto .bga-btn { display: inline-flex; align-items: center; min-height: 50px; padding: 14px 28px; border-radius: 999px; background: #fff; color: #0037B6; font-size: 15.5px; font-weight: 700; box-shadow: 0 8px 0 rgba(0,2,11,.35); transition: transform .2s ease, box-shadow .2s ease; }
  .proto .bga-btn:hover { transform: translateY(2px); box-shadow: 0 6px 0 rgba(0,2,11,.35); }
  .proto .bga-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; color: rgba(255,255,255,.88); }
  .proto .bga-chip i { width: 18px; height: 18px; border-radius: 6px; background: #0037B6; border: 2px solid #fff; }

  /* ===== Le showroom ===== */
  @property --sa { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .proto .sw { --H: 530px; position: relative; margin: 0; border-radius: 30px; overflow: hidden; isolation: isolate; background: radial-gradient(120% 70% at 50% -5%, #2a63ea 0%, #0d2a78 38%, #061541 68%, #030b29 100%); border: 1px solid rgba(170,212,255,.45); box-shadow: 0 50px 100px -40px rgba(0,2,11,.9), inset 0 0 0 1px rgba(255,255,255,.06), inset 0 -90px 120px -70px rgba(90,170,255,.45); perspective: 1400px; }
  .proto .sw-scene { position: relative; height: calc(var(--H) + 118px); touch-action: pan-y; transform-style: preserve-3d; transform: rotateX(calc(var(--py, 0) * -2.5deg)) rotateY(calc(var(--px, 0) * 3.5deg)); }
  .proto .sw-sign { position: absolute; z-index: 3; top: 16px; left: 0; right: 0; text-align: center; font-family: var(--display); font-weight: 700; color: #E6F4FF; pointer-events: none; transform: translateX(calc(var(--px, 0) * -6px)); }
  .proto .sw-sign span { display: block; font-size: 21px; letter-spacing: .02em; text-shadow: 0 0 8px rgba(140,205,255,.95), 0 0 22px rgba(60,130,255,.9), 0 0 44px rgba(40,100,255,.6); }
  .proto .sw-sign small { display: block; margin-top: 2px; font-size: 10.5px; letter-spacing: .02em; text-transform: none; color: #9DD0FF; }
  .proto .sw-beams { position: absolute; inset: 0; z-index: 0; pointer-events: none; transform: translateX(calc(var(--px, 0) * 10px)); }
  .proto .sw-beam { position: absolute; top: -4%; width: 46%; height: 98%; background: linear-gradient(180deg, rgba(200,232,255,.55), rgba(150,205,255,.16) 45%, rgba(120,190,255,0) 92%); clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%); filter: blur(6px); mix-blend-mode: screen; }
  .proto .sw-beam.b1 { left: 4%; }
  .proto .sw-beam.b2 { right: 4%; }
  .proto .sw-grain { position: absolute; left: var(--gx); bottom: 18%; width: var(--gs); height: var(--gs); border-radius: 50%; background: #CFE9FF; box-shadow: 0 0 6px #9fd4ff; opacity: 0; animation: sw-grain var(--gd) linear var(--gr) infinite; }
  .proto .sw-floor { position: absolute; left: -20%; right: -20%; bottom: 0; height: 42%; z-index: 0; pointer-events: none; background: repeating-linear-gradient(90deg, rgba(120,190,255,.22) 0 1px, transparent 1px 64px), repeating-linear-gradient(0deg, rgba(120,190,255,.22) 0 1px, transparent 1px 48px); transform: perspective(500px) rotateX(62deg); transform-origin: 50% 100%; -webkit-mask: linear-gradient(to top, #000 10%, transparent 85%); mask: linear-gradient(to top, #000 10%, transparent 85%); }
  .proto .sw-stage { position: absolute; z-index: 1; left: 0; right: 0; bottom: 46px; height: var(--H); display: flex; justify-content: center; align-items: flex-end; gap: clamp(14px, 7%, 64px); transform-style: preserve-3d; pointer-events: none; }
  /* la scène est en 3D : seuls les mannequins captent le pointeur (sinon le fond de la scène peut passer devant au test de clic) */
  .proto .sw-stand { position: relative; height: calc(var(--H) * var(--fh)); width: calc(var(--H) * var(--fh) * var(--fr)); perspective: 1000px; }
  .proto .sw-socle { position: absolute; left: 50%; bottom: -18px; width: 140%; height: 38px; transform: translateX(-50%); pointer-events: none; }
  .proto .sw-socle::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(closest-side, rgba(0,4,24,.7), rgba(0,4,24,.25) 55%, transparent 76%); }
  .proto .sw-socle i { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from var(--sa, 0deg), rgba(170,220,255,0) 0deg, rgba(190,230,255,.95) 40deg, rgba(90,160,255,.2) 120deg, rgba(170,220,255,0) 200deg, rgba(190,230,255,.75) 280deg, rgba(170,220,255,0) 360deg); -webkit-mask: radial-gradient(closest-side, transparent 78%, #000 82%, #000 90%, transparent 96%); mask: radial-gradient(closest-side, transparent 78%, #000 82%, #000 90%, transparent 96%); animation: sw-ring 6s linear infinite; filter: drop-shadow(0 0 6px rgba(120,190,255,.9)); }
  .proto .sw-turn { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: auto; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; border-radius: 16px; animation: none; }
  .proto .sw-stand[data-qui="femme"] .sw-turn { animation-delay: -3s; }
  .proto .sw.is-drag .sw-turn, .proto .sw.is-drag .sw-scene { cursor: grabbing; }
  .proto .sw-turn:focus { outline: none; }
  .proto .sw-turn:focus-visible { outline: 3px solid #BFE2FF; outline-offset: 8px; }
  .proto .sw-face { position: absolute; inset: 0; transform: rotateY(var(--t, 0deg)) scaleX(var(--s, 1)); opacity: var(--o, 1); filter: blur(var(--b, 0px)); will-change: transform, opacity; }
  .proto .sw-face:not(.is-face) { opacity: var(--o, 0); visibility: hidden; }
  .proto .sw-img { position: absolute; inset: 0; z-index: 1; display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; -webkit-user-drag: none; opacity: 0; filter: drop-shadow(0 18px 16px rgba(0,2,11,.5)); }
  .proto .sw-img.on { opacity: 1; }
  .proto .sw-img.is-in { z-index: 2; animation: sw-drop .95s cubic-bezier(.6,0,.3,1) both; }
  .proto .sw-shine { display: none; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: linear-gradient(100deg, transparent 40%, rgba(220,238,255,.8) 50%, transparent 60%) no-repeat; background-size: 280% 100%; background-position: var(--sx, 50%) 0; mix-blend-mode: soft-light; -webkit-mask: var(--img) center / 100% 100% no-repeat; mask: var(--img) center / 100% 100% no-repeat; }
  .proto .sw.has-img .sw-shine { display: block; }
  /* avant l'apparition : silhouette holographique */
  .proto .sw.js-on .sw-stand:not(.is-up) .sw-shine { background: linear-gradient(180deg, rgba(170,220,255,.55), rgba(80,150,255,.18)); mix-blend-mode: normal; animation: sw-holo 1.6s ease-in-out infinite; }
  .proto .sw.js-on .sw-stand:not(.is-up) .sw-face::after { opacity: 0; }
  .proto .sw.has-img .sw-face::after { content: ''; position: absolute; left: 0; right: 0; top: 97.8%; height: 22%; background: var(--img) center bottom / 100% auto no-repeat; transform: scaleY(-1); opacity: .3; -webkit-mask: linear-gradient(to top, #000, transparent 70%); mask: linear-gradient(to top, #000, transparent 70%); pointer-events: none; }
  .proto .sw-scan { position: absolute; z-index: 4; left: -14%; right: -14%; top: 0; height: 3px; border-radius: 3px; opacity: 0; pointer-events: none; background: linear-gradient(90deg, transparent, #8fdcff 18%, #fff 50%, #8fdcff 82%, transparent); box-shadow: 0 0 10px 2px rgba(130,210,255,.95), 0 0 34px 10px rgba(60,140,255,.55); }
  .proto .sw-face.is-scan .sw-scan { animation: sw-scandown .95s cubic-bezier(.6,0,.3,1) both; }

  /* Apparition : le showroom s'allume, les mannequins se matérialisent */
  .proto .sw.js-on:not(.is-on) .sw-beam, .proto .sw.js-on:not(.is-on) .sw-sign, .proto .sw.js-on:not(.is-on) .sw-socle { opacity: 0; }
  .proto .sw.js-on .sw-stand:not(.is-up) .sw-img { clip-path: inset(100% -10% -10% -10%); }
  .proto .sw.is-on .sw-beam { animation: sw-power 1.1s steps(1, end) both; }
  .proto .sw.is-on .sw-beam.b2 { animation-delay: .25s; }
  .proto .sw.is-on .sw-sign { animation: sw-neon 1.4s steps(1, end) .15s both; }
  .proto .sw.is-on .sw-socle { animation: sw-socle .9s cubic-bezier(.2,1.4,.4,1) .5s both; }
  .proto .sw-stand.is-rise .sw-img.on { animation: sw-rise 1.15s cubic-bezier(.5,0,.2,1) both; }
  .proto .sw-stand.is-rise .sw-face.is-face .sw-scan { animation: sw-scanup 1.15s cubic-bezier(.5,0,.2,1) both; }

  /* Points de zoom */
  .proto .sw-hot { position: absolute; z-index: 5; left: var(--x); top: var(--y); width: 30px; height: 30px; margin: -15px 0 0 -15px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; display: none; }
  .proto .sw[data-tenue="longue"] .sw-hot[data-tenue="longue"], .proto .sw[data-tenue="courte"] .sw-hot[data-tenue="courte"] { display: block; }
  .proto .sw-hot::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255,255,255,.9); animation: sw-pulse 2.2s ease-out infinite; }
  .proto .sw-hot i { position: absolute; inset: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px rgba(0,55,182,.55), 0 0 14px rgba(160,215,255,.9); transition: transform .2s ease, background .2s ease; }
  .proto .sw-hot:hover i, .proto .sw-hot[aria-expanded="true"] i { transform: scale(1.25); background: #9DD0FF; }
  .proto .sw-hot:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .proto .sw-stand:not([data-vue="face"]) .sw-hot { pointer-events: none; }
  .proto .sw.js-on:not(.is-ready) .sw-hot { opacity: 0; transform: scale(.4); }
  .proto .sw.is-ready .sw-hot { opacity: 1; transform: none; transition: opacity .4s ease, transform .5s cubic-bezier(.3,1.6,.5,1); }

  /* Loupe */
  .proto .sw-loupe { position: absolute; z-index: 6; left: 0; top: 0; display: flex; align-items: center; gap: 12px; padding: 8px 16px 8px 8px; border-radius: 999px; background: rgba(6,20,64,.82); border: 1px solid rgba(170,215,255,.5); box-shadow: 0 24px 50px -16px rgba(0,2,11,.9), 0 0 0 6px rgba(120,190,255,.12); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); pointer-events: none; opacity: 0; transform: translate(var(--lx, 0px), var(--ly, 0px)) scale(.8); transform-origin: var(--lo, left) center; transition: opacity .22s ease, transform .3s cubic-bezier(.3,1.5,.5,1); }
  .proto .sw-loupe.on { opacity: 1; transform: translate(var(--lx, 0px), var(--ly, 0px)) scale(1); }
  .proto .sw-loupe-img { flex: 0 0 auto; width: 104px; height: 104px; border-radius: 50%; overflow: hidden; border: 3px solid #fff; box-shadow: 0 0 0 4px rgba(0,55,182,.7), 0 0 26px rgba(130,200,255,.8); }
  .proto .sw-loupe-img img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); }
  .proto .sw-loupe-txt { display: flex; flex-direction: column; gap: 2px; max-width: 150px; }
  .proto .sw-loupe-txt em { font-style: normal; font-size: 10.5px; font-weight: 700; letter-spacing: .02em; text-transform: none; color: #9DD0FF; }
  .proto .sw-loupe-txt b { font-size: 15px; line-height: 1.2; color: #fff; }
