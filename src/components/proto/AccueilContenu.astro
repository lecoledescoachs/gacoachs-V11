    <!-- Bandeau : BOOST ENTREPRISE, visible dès l'arrivée -->
    <a class="ribbon" href="/score-sante/">
      <span class="ribbon-txt"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg><span><b>Ton bilan santé avec un coach</b><span class="rb-long"> Une heure près de chez toi, pour faire le point et bien démarrer.</span></span></span>
      <span class="ribbon-cta">Réserver mon bilan <svg class="ic" aria-hidden="true" focusable="false"><use href="#i-arrow"></use></svg></span>
    </a>

    <!-- Haut de page : textes, puis la main de cartes distribuée -->
