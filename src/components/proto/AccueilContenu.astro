          <img style="padding: 26.6px 26.5px;" data-a="pop" src="/images/logos/trim/tournee-des-coachs.webp" data-key="L_TOURNEE" alt="La Tournée des Coachs" width="160" height="68">
        </div>
      <div class="logos" aria-hidden="true">
          <img style="padding: 15.1px 37.4px;" src="/images/logos/trim/basic-fit.webp" data-key="L_BASICFIT" alt="" width="68" height="68">
          <img style="padding: 15.0px 37.8px;" src="/images/logos/trim/ecole-des-coachs.webp" data-key="L_ECOLE" alt="" width="66" height="68">
          <img style="padding: 29.9px 20.8px;" src="/images/logos/trim/coach-obesite.webp" alt="" width="224" height="68">
          <img style="padding: 27.3px 25.4px;" src="/images/logos/trim/orus.webp" alt="" width="171" height="68">
          <img style="padding: 15.0px 37.8px;" src="/images/logos/trim/indy.webp" alt="" width="66" height="68">
          <img style="padding: 27.1px 25.9px;" src="/images/logos/trim/boost-entreprise.webp" alt="" width="167" height="68">
