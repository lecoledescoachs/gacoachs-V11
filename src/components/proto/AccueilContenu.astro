      <div class="marquee" id="marquee">
        <div class="logos">
          <img style="padding: 15.1px 37.4px;" data-a="pop" src="/images/logos/trim/basic-fit.webp" data-key="L_BASICFIT" alt="Basic-Fit" width="68" height="68">
          <img style="padding: 15.0px 37.8px;" data-a="pop" src="/images/logos/trim/ecole-des-coachs.webp" data-key="L_ECOLE" alt="L'École des Coachs" width="66" height="68">
