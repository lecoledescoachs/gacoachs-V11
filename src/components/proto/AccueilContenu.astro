    <section class="sec">
      <div class="inner">
        <span class="eyebrow" data-a="pop">Comment ça marche</span>
        <h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Trouve</span></span> <span class="w"><span style="--i: 1;">ton</span></span> <span class="w"><span style="--i: 2;">coach</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2>
        <div class="grid g3">
          <a class="tile step" href="/salles/" data-a="up"><span class="step-n" data-a="ring" data-plus="180">01</span><h3>Ma salle</h3><p>Choisis ta salle Basic-Fit pour voir les coachs disponibles sur place.</p></a>
          <a class="tile step" href="#expertises" data-a="up"><span class="step-n" data-a="ring" data-plus="180">02</span><h3>Mon objectif</h3><p>Perte de poids, prise de muscle, remise en forme, préparation concours…</p></a>
          <a class="tile step" href="/trouver-un-coach/" data-a="up"><span class="step-n" data-a="ring" data-plus="180">03</span><h3>Mon coach</h3><p>Découvre le profil du coach qui te correspond et réserve ton bilan santé avec lui.</p></a>
        </div>
        <div class="tile quiz" id="quiz" data-a="up">
          <div class="qz-top">
            <span class="eyebrow">Test gratuit · ton coach idéal</span>
            <span class="qz-prog"><span class="dots" aria-hidden="true"><span class="on"></span><span></span><span></span></span><span class="qz-k" id="qzK">Étape 1 sur 3</span></span>
          </div>
          <div class="qz-step in-back" data-step="1">
            <h3 tabindex="-1">Quelle salle te conviendrait le mieux ?</h3>
            <div class="chips">
              <button type="button" class="chip" aria-pressed="false" data-v="" data-a="pop" data-plus="260">Peu importe, montre-moi tout</button>
              <button type="button" class="chip" aria-pressed="false" data-v="Basic-Fit Olivet" data-a="pop" data-plus="330">Basic-Fit Olivet</button>
              <button type="button" class="chip" aria-pressed="false" data-v="Basic-Fit Orléans Sud" data-a="pop" data-plus="400">Basic-Fit Orléans Sud</button>
              <button type="button" class="chip" aria-pressed="false" data-v="Basic-Fit Orléans Libération" data-a="pop" data-plus="470">Basic-Fit Orléans Libération</button>
              <button type="button" class="chip" aria-pressed="false" data-v="Basic-Fit Saran" data-a="pop" data-plus="540">Basic-Fit Saran</button>
              <button type="button" class="chip" aria-pressed="false" data-v="Basic-Fit Fleury-les-Aubrais" data-a="pop" data-plus="610">Basic-Fit Fleury-les-Aubrais</button>
            </div>
          </div>
          <div class="qz-step" data-step="2" hidden="">
            <h3 tabindex="-1">Quel est ton objectif principal ?</h3>
            <div class="qz-goals" id="qzGoals"><button type="button" class="goal" aria-pressed="false" data-v="poids" style="--i:0"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-flame"></use></svg></span><span>Perdre du poids</span></button><button type="button" class="goal" aria-pressed="false" data-v="muscle" style="--i:1"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-dumbbell"></use></svg></span><span>Prendre du muscle</span></button><button type="button" class="goal" aria-pressed="false" data-v="forme" style="--i:2"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-battery"></use></svg></span><span>Me remettre en forme</span></button><button type="button" class="goal" aria-pressed="false" data-v="zen" style="--i:3"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-leaf"></use></svg></span><span>Bien-être et moins de stress</span></button><button type="button" class="goal" aria-pressed="false" data-v="mesure" style="--i:4"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"></use></svg></span><span>Un suivi 100&nbsp;% sur mesure</span></button><button type="button" class="goal" aria-pressed="false" data-v="tout" style="--i:5"><span class="goal-ic"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-spark"></use></svg></span><span>Je ne sais pas encore</span></button></div>
            <button type="button" class="qz-link" data-back=""><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-back"></use></svg>Retour</button>
          </div>
          <div class="qz-step" data-step="3" hidden="" aria-live="polite">
            <h3 tabindex="-1" id="qzTitle">Voici ton coach recommandé</h3>
            <p class="qz-note" id="qzNote" hidden=""></p>
            <div class="qz-res" id="qzRes"></div>
            <div id="qzLead"></div>
            <button type="button" class="qz-link" data-restart=""><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-refresh"></use></svg>Refaire le test</button>
          </div>
        </div>
      </div>
