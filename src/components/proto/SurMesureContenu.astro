---
import PourLesPros from './PourLesPros.astro';
// Contenu de la page services sur mesure, repris du prototype validé par Garry
import SM from '../../data/sur-mesure.json';
const faq = (SM as any).faq;
---
<svg class="sprite" width="0" height="0" style="position: absolute; overflow: hidden;" aria-hidden="true" focusable="false"><symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"></path></symbol></svg>
<div><section class="phero" data-hero=""><div class="lightning-bg" aria-hidden="true"></div><div class="inner"><nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><span>Services sur mesure</span></nav><div class="phero-solo"><div><span class="eyebrow eyebrow-dark" data-a="pop">Services sur mesure</span><h1 data-a="words" data-hl="3,4,5"><span class="w"><span style="--i: 0;">Du</span></span> <span class="w"><span style="--i: 1;">coaching</span></span> <span class="w"><span style="--i: 2;">sportif</span></span> <span class="w hl"><span style="--i: 3;">sur</span></span> <span class="w hl"><span style="--i: 4;">mesure</span></span> <span class="w hl"><span style="--i: 5;">pour</span></span> <span class="w"><span style="--i: 6;">votre</span></span> <span class="w"><span style="--i: 7;">lieu,</span></span> <span class="w"><span style="--i: 8;">vos</span></span> <span class="w"><span style="--i: 9;">équipes</span></span> <span class="w"><span style="--i: 10;">ou</span></span> <span class="w"><span style="--i: 11;">vos</span></span> <span class="w"><span style="--i: 12;">clients.</span></span></h1><p class="phero-lead" data-a="up">Hôtels, campings, bars et restaurants, mairies, administrations, maisons de santé, cliniques, entreprises, EVJF et EVG ou clientèle VIP : nos coachs diplômés construisent avec vous une intervention adaptée, sur place.</p><ul class="facts-dark" data-a="up"><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Des coachs diplômés qui se déplacent</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un format construit avec vous</li><li><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg>Un devis clair, sans engagement</li></ul><div class="ctas" data-a="up"><a class="btn btn-primary" href="#sm-contact">Nous contacter</a><a class="btn btn-glass" href="#sm-faq">Questions fréquentes</a></div></div></div></div></section>
<section class="sec sg-bref-sec"><div class="inner"><div class="sg-bref"><p class="sg-bref-k">En bref</p><ul><li><b>Quoi :</b> des coachs sportifs diplômés qui construisent avec vous une intervention adaptée à votre lieu ou à votre public.</li><li><b>Pour qui :</b> hôtels, campings, bars, restaurants, mairies, administrations, maisons de santé, cliniques, entreprises, EVJF et EVG, personnalités.</li><li><b>Comment :</b> un échange sur votre besoin, une proposition et un devis clair, puis un coach du réseau qui intervient chez vous.</li><li><b>Ce que vous y gagnez :</b> un service sportif professionnel, sans recrutement à gérer.</li></ul></div></div></section>
<PourLesPros id="gamme-boost" eyebrow="La gamme BOOST" titre="Une offre BOOST pour chaque structure." lead="Choisissez l'offre qui correspond à votre structure. Chacune a son programme, ses formats et un coach diplômé du réseau GA." plus={false} />
<section class="sec band" id="sm-segments"><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">offre</span></span> <span class="w"><span style="--i: 2;">pour</span></span> <span class="w"><span style="--i: 3;">chaque</span></span> <span class="w"><span style="--i: 4;">lieu</span></span> <span class="w"><span style="--i: 5;">et</span></span> <span class="w"><span style="--i: 6;">chaque</span></span> <span class="w"><span style="--i: 7;">public.</span></span></h2><div class="grid g3 eh-sv" data-group=""><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">👑</span> VIP et personnalités</h3><ul><li>Artistes, sportifs, personnalités publiques</li><li>Élus, sportifs de haut niveau, personnalités publiques</li><li>Artistes : <a href="/services-sur-mesure/coach-sportif-preparation-scene/">BOOST SCÈNE</a> et <a href="/services-sur-mesure/coach-sportif-tournee-artistes/">BOOST TOURNÉE</a></li><li>Engagement de confidentialité écrit</li><li>À domicile, à l'hôtel ou sur un lieu privé</li></ul><p class="sm-sig">⭐ Programme signature : <b>PRIVÉ 12</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-vip/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🏨</span> Hôtels</h3><ul><li>Séances privées pour vos clients, en chambre, en salle ou en extérieur</li><li>Animations collectives : réveil musculaire, circuit training, mobilité</li><li>Programmes bien-être pour les séjours et les séminaires</li><li>Conseils à vos équipes pour animer votre salle de fitness</li></ul><p class="sm-sig">⭐ Programme signature : <b>SÉJOUR ACTIF</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-hotel/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">⛺</span> Campings</h3><ul><li>Animations sportives de la saison : réveil musculaire, circuit training, plein air</li><li>Séances adaptées à toute la famille, enfants et adultes</li><li>Créneaux réguliers sur la haute saison</li><li>Séances parents-enfants</li></ul><p class="sm-sig">⭐ Programme signature : <b>SAISON ACTIVE</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-camping/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🏛️</span> Mairies, administrations et organismes publics</h3><ul><li>Pauses sportives et séances sur site pour vos agents</li><li>Ateliers de prévention : sédentarité, postures, mal de dos</li><li>Actions de sport santé pour vos publics : seniors, habitants, associations</li><li>Challenges collectifs, journées bien-être, événements</li></ul><p class="sm-note">Préfectures, URSSAF, CAF, communes, intercommunalités : un devis détaillé, utilisable dans votre procédure d'achat.</p><p class="sm-sig">⭐ Programme signature : <b>AGENTS EN FORME</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-collectivites-administrations/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🩺</span> Maisons et pôles de santé</h3><ul><li>Ateliers collectifs pour vos patients, en lien avec vos praticiens</li><li>Relais d'activité physique pour les patients que vous adressez</li><li>Programmes de reprise progressive</li><li>Prévention auprès du public et de votre équipe</li></ul><p class="sm-sig">⭐ Programme signature : <b>RELAIS SANTÉ 12</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-maison-de-sante/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🏥</span> Cliniques</h3><ul><li>Séances de remise en mouvement, avec l'accord de l'équipe soignante</li><li>Reprise d'activité après une hospitalisation ou une intervention</li><li>Ateliers bien-être pour vos équipes</li><li>Interventions adaptées à votre organisation (ambulatoire, hôpital de jour)</li></ul><p class="sm-sig">⭐ Programme signature : <b>REMISE EN MOUVEMENT</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-clinique/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🍻</span> Bars</h3><ul><li>Run club au départ de votre bar</li><li>Défi sportif avant l'afterwork</li><li>Soirée match ou événement privé</li></ul><p class="sm-sig">⭐ Programme signature : <b>RUN &amp; AFTERWORK</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-evenement-bar/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🍽️</span> Restaurants</h3><ul><li>Séance de sport suivie d'un brunch</li><li>Déjeuner actif pour les entreprises</li><li>Événement privé avant le repas</li></ul><p class="sm-sig">⭐ Programme signature : <b>RUN &amp; BRUNCH</b></p><a class="sm-more" href="/services-sur-mesure/coach-sportif-evenement-restaurant/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🦺</span> Gestes et postures</h3><ul><li>Ateliers pratiques sur votre site</li><li>Port de charges, travail sur écran</li><li>Échauffement de prise de poste</li></ul><p class="sm-sig">⭐ Programme signature : <b>POSTES EN FORME</b></p><a class="sm-more" href="/services-sur-mesure/atelier-gestes-et-postures/">En savoir plus →</a></div><div class="tile sm-seg" data-a="up"><h3><span aria-hidden="true">🎉</span> EVJF et EVG</h3><ul><li>Bootcamp et défis par équipes</li><li>Mini course façon Hyrox</li><li>Tous niveaux, fous rires garantis</li></ul><p class="sm-sig">⭐ Programme signature : <b>LE GRAND DÉFI</b></p><a class="sm-more" href="/services-sur-mesure/evjf-evg-activite-sportive/">En savoir plus →</a></div></div></div></section><section class="sec navy"><div class="lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Notre</span></span> <span class="w"><span style="--i: 1;">rôle</span></span></h2><p class="lead-p" data-a="up">Nos coachs ne posent aucun diagnostic, ne prescrivent aucun traitement et ne remplacent ni les soins ni le suivi médical. En établissement de santé, ils interviennent en complément, avec l'accord de l'équipe soignante.</p></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Comment ça se passe</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Une</span></span> <span class="w"><span style="--i: 1;">collaboration</span></span> <span class="w"><span style="--i: 2;">simple,</span></span> <span class="w"><span style="--i: 3;">en</span></span> <span class="w"><span style="--i: 4;">trois</span></span> <span class="w"><span style="--i: 5;">étapes.</span></span></h2><div class="method-wrap"><span class="method-line" aria-hidden="true"><i style="transform: scaleY(0);"></i></span><ol class="method"><li><span class="step-n">1</span><div class="tile" data-a="right"><h3>Un échange pour comprendre votre besoin</h3><p>Votre lieu, votre public, les créneaux possibles et vos contraintes d'organisation.</p></div></li><li><span class="step-n">2</span><div class="tile" data-a="right"><h3>Une proposition sur mesure</h3><p>Un format, un rythme et un devis clair, sans engagement.</p></div></li><li><span class="step-n">3</span><div class="tile" data-a="right"><h3>Des interventions régulières</h3><p>Un coach du réseau intervient chez vous, et nous faisons le point avec vous à intervalles réguliers.</p></div></li></ol></div></div></section><section class="sec" id="sm-faq"><div class="inner"><span class="eyebrow" data-a="pop">Questions fréquentes</span><h2 class="h2">Ce que les structures nous demandent.</h2><div class="faq-list" style="margin-top: 24px;">{faq.map((f) => <details class="faq-item" data-a="up"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div></div></section><section class="sec"><div class="inner"><span class="eyebrow" data-a="pop">Pour aller plus loin</span><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Nos</span></span> <span class="w"><span style="--i: 1;">guides</span></span> <span class="w"><span style="--i: 2;">par</span></span> <span class="w"><span style="--i: 3;">type</span></span> <span class="w"><span style="--i: 4;">de</span></span> <span class="w"><span style="--i: 5;">structure.</span></span></h2><div class="eh-guides" data-group=""><a class="tile eh-g" href="/blog/coach-sportif-prive-vip-orleans/" data-a="up"><b>Coach sportif privé à Orléans : comment se passe un accompagnement VIP ?</b><span>Discrétion, agenda, lieux, programme : comment se passe un accompagnement avec un coach sportif privé pour les personnalités, à Orléans et dans le Loiret.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/coach-sportif-hotel-comment-proposer-le-service/" data-a="up"><b>Proposer un coach sportif dans son hôtel : formats et mise en place</b><span>Séances privées, créneaux collectifs, séminaires : comment un hôtel peut proposer un coach sportif diplômé à ses clients, sans recruter.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/animations-sportives-camping-idees-de-seances/" data-a="up"><b>Animations sportives en camping : idées de séances pour toute la famille</b><span>Réveil musculaire, circuit training, jeux parents-enfants : des idées de séances sportives encadrées pour enrichir le programme d'animations d'un camping.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/activite-physique-agents-collectivite/" data-a="up"><b>Activité physique des agents : ce qu'une collectivité peut mettre en place</b><span>Pauses actives, ateliers postures, challenges entre services : des actions simples pour faire bouger les agents d'une mairie ou d'une administration.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/maison-de-sante-travailler-avec-un-coach-sportif/" data-a="up"><b>Maison de santé : travailler avec un coach sportif diplômé</b><span>Ateliers collectifs, relais pour les patients, prévention : comment une maison ou un pôle de santé peut collaborer avec un coach sportif, en complément des praticiens.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/clinique-remise-en-mouvement-role-du-coach/" data-a="up"><b>Remise en mouvement en clinique : le rôle d'un coach sportif</b><span>Séances encadrées, relais après la sortie, bien-être des équipes : comment un coach sportif diplômé peut intervenir dans une clinique, avec l'accord de l'équipe soignante.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/evenement-sportif-bar-restaurant-idees/" data-a="up"><b>Organiser un événement sportif dans son bar ou son restaurant</b><span>Run club, séance suivie d'un brunch, défi en soirée : des idées d'événements sportifs pour faire venir du monde dans votre bar ou restaurant.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/atelier-gestes-et-postures-comment-ca-se-passe/" data-a="up"><b>Atelier gestes et postures : comment ça se passe concrètement ?</b><span>Port de charges, travail sur écran, échauffement de prise de poste : le déroulé d'un atelier gestes et postures animé par un coach sportif diplômé.</span><em>Lire le guide →</em></a><a class="tile eh-g" href="/blog/evjf-evg-sportif-idees-d-activites/" data-a="up"><b>EVJF ou EVG sportif : idées d'activités avec un coach</b><span>Bootcamp, défis par équipes, mini course façon Hyrox : des idées d'activités sportives pour un enterrement de vie de jeune fille ou de garçon réussi.</span><em>Lire le guide →</em></a></div></div></section><section class="sec band" id="sm-contact"><div class="inner"><div class="eq"><div class="eq-head"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Parlons</span></span> <span class="w"><span style="--i: 1;">de</span></span> <span class="w"><span style="--i: 2;">votre</span></span> <span class="w"><span style="--i: 3;">projet</span></span></h2><p class="lead-p" data-a="up">Dites-nous en quelques lignes ce que vous imaginez. Nous revenons vers vous pour un premier échange, sans engagement.</p></div><div class="eq-card" data-a="up"><form class="bform sa-form" data-sm="form" name="sur-mesure" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci-sur-mesure/"><input type="hidden" name="form-name" value="sur-mesure"><p hidden><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label></p><label for="fa9fft8" class="full">Vous êtes<select id="fa9fft8" name="organisation"><option data-cle="hotel" value="Hôtel" selected="">Hôtel</option><option data-cle="camping" value="Camping">Camping</option><option data-cle="collectivite" value="Mairie ou collectivité">Mairie ou collectivité</option><option data-cle="administration" value="Préfecture ou administration">Préfecture ou administration</option><option data-cle="organisme" value="Organisme public (URSSAF, CAF…)">Organisme public (URSSAF, CAF…)</option><option data-cle="maison-sante" value="Maison ou pôle de santé">Maison ou pôle de santé</option><option data-cle="clinique" value="Clinique">Clinique</option><option data-cle="vip" value="Personnalité ou VIP">Personnalité ou VIP</option><option data-cle="scene" value="Artiste : préparation scène (BOOST SCÈNE)">Artiste : préparation scène (BOOST SCÈNE)</option><option data-cle="tournee" value="Artiste en tournée (BOOST TOURNÉE)">Artiste en tournée (BOOST TOURNÉE)</option><option data-cle="bar" value="Bar">Bar</option><option data-cle="restaurant" value="Restaurant">Restaurant</option><option data-cle="gestes-postures" value="Entreprise ou commerce (gestes et postures)">Entreprise ou commerce (gestes et postures)</option><option data-cle="evjf-evg" value="EVJF ou EVG">EVJF ou EVG</option><option data-cle="autre" value="Autre">Autre</option></select></label><label for="f24mcg4">Nom de la structure (facultatif)<input id="f24mcg4" name="structure" type="text" autocomplete="organization"></label><label for="f78etqq">Nom et prénom<input id="f78etqq" name="nom_prenom" type="text" required="" autocomplete="name"></label><label for="faq15k7">Ville<input id="faq15k7" name="ville" type="text" required="" autocomplete="address-level2"></label><label for="f5wdlb0">Email<input id="f5wdlb0" name="email" type="email" required="" autocomplete="email"></label><label for="fm42tn7">Téléphone (facultatif)<input id="fm42tn7" name="telephone" type="tel" autocomplete="tel"></label><label for="ffk14dt" class="full">Votre besoin<select id="ffk14dt" name="besoin"><option value="Des séances régulières" selected="">Des séances régulières</option><option value="Une intervention saisonnière">Une intervention saisonnière</option><option value="Un événement ou une journée">Un événement ou une journée</option><option value="Un coach pour une tournée">Un coach pour une tournée</option><option value="Je ne sais pas encore">Je ne sais pas encore</option></select></label><label for="fg0nb04" class="full">Un mot sur votre projet (facultatif)<textarea id="fg0nb04" name="message" rows="4"></textarea></label><label class="sa-chk full"><input type="checkbox" name="consentement" required><span>J'accepte que GA Coachs utilise ces informations pour me recontacter au sujet de ma demande.</span></label><button type="submit" class="btn btn-primary full">Envoyer ma demande</button><p class="form-ok" hidden=""></p><p class="small-note full" style="margin: 0;">Nous vous répondons sous 48 h ouvrées. Vos informations servent uniquement à répondre à votre demande.</p></form></div></div></div></section><section class="final"><div class="final-bg lightning-bg" data-a="charge" aria-hidden="true"></div><div class="inner"><h2 class="h2" data-a="words"><span class="w"><span style="--i: 0;">Et</span></span> <span class="w"><span style="--i: 1;">si</span></span> <span class="w"><span style="--i: 2;">un</span></span> <span class="w"><span style="--i: 3;">coach</span></span> <span class="w"><span style="--i: 4;">diplômé</span></span> <span class="w"><span style="--i: 5;">intervenait</span></span> <span class="w"><span style="--i: 6;">chez</span></span> <span class="w"><span style="--i: 7;">vous&nbsp;?</span></span></h2><a class="btn-final" href="#sm-contact" data-a="ring" data-plus="350"><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>Nous contacter<span class="shine" aria-hidden="true"></span></a></div></section></div>

