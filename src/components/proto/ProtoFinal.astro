---
const { titre, label, href } = Astro.props;
---
<section class="final"><div class="final-bg lightning-bg" aria-hidden="true"></div><div class="inner"><h2 class="h2">{titre}</h2><a class="btn-final" href={href}><svg class="ic fill" aria-hidden="true" focusable="false"><use href="#i-bolt"></use></svg>{label}<span class="shine" aria-hidden="true"></span></a></div></section>
