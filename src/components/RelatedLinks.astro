---
interface RelLink {
  label: string;
  href: string;
  meta?: string;
}
interface Props {
  title?: string;
  links: RelLink[];
}
const { title = 'Pour aller plus loin', links } = Astro.props;
---
{links.length > 0 && (
  <nav class="related-links" aria-label={title}>
    <h2>{title}</h2>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <span class="related-links__label">{l.label}</span>
            {l.meta && <span class="related-links__meta">{l.meta}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .related-links { margin-top: 8px; }
  .related-links h2 { font-size: 16px; margin-bottom: 16px; }
  .related-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .related-links a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    transition: border-color .2s var(--ease), transform .2s var(--ease);
  }
  .related-links a:hover { border-color: var(--blue); transform: translateY(-2px); }
  .related-links__label { font-size: 14px; font-weight: 600; color: var(--navy); }
  .related-links__meta { font-size: 12px; color: var(--text-muted); }
</style>
