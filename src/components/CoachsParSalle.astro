---
import salles from '../data/salles.json';
const lignes = salles.map((s: any) => ({ nom: s.nom.replace('Basic-Fit ', ''), n: s.coachs.length, href: `/salles/${s.slug}/` })).sort((a: any, b: any) => b.n - a.n);
const total = lignes.reduce((t: number, l: any) => t + l.n, 0);
const max = Math.max(...lignes.map((l: any) => l.n));
---
<figure class="cps" aria-labelledby="cps-t">
  <figcaption id="cps-t"><b>{total} coachs</b> dans <b>{lignes.length} salles Basic-Fit</b></figcaption>
  <ul>
    {lignes.map((l: any) => (
      <li><a href={l.href} aria-label={`${l.nom} : ${l.n} coach${l.n > 1 ? 's' : ''}`}>
        <span class="cps-n">{l.nom}</span>
        <span class="cps-b" aria-hidden="true"><i style={`width:${Math.round((l.n / max) * 100)}%`}></i></span>
        <span class="cps-v">{l.n}</span>
      </a></li>
    ))}
  </ul>
</figure>
<style>
  .cps { margin: 16px 0; padding: 16px; background: #fff; border: 1px solid #DCE6FB; border-radius: 18px; color: #13203B; }
  .cps figcaption { font-size: 15px; color: #3E4A66; margin-bottom: 8px; }
  .cps figcaption b { color: #0B1E3D; }
  .cps ul { list-style: none; margin: 0; padding: 0; }
  .cps a { display: grid; grid-template-columns: 112px minmax(0, 1fr) 24px; gap: 10px; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
  .cps-n { font-weight: 700; font-size: 14px; color: #0B1E3D; }
  .cps-b { height: 12px; border-radius: 99px; background: #E8EFFD; overflow: hidden; }
  .cps-b i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #2F6BF0, #5B9BFF); }
  .cps-v { font-weight: 700; text-align: right; color: #0B1E3D; }
  @media (min-width: 768px) { .cps a { grid-template-columns: 200px minmax(0, 1fr) 28px; } }
</style>
