  .dash-duo { margin-top: 20px; display: grid; gap: 14px; }
  .dash-box { padding: 18px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .dash-box__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .dash-box__title { font-size: 14px; font-weight: 700; color: var(--navy); }
  .dash-link { background: none; border: 0; padding: 0; font-family: inherit; font-size: 13px; font-weight: 700; color: var(--blue); cursor: pointer; }
  .jauge { margin-top: 14px; }
  .jauge__head, .funnel__head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; font-size: 13.5px; color: var(--navy); }
  .jauge__bar, .funnel__bar { margin-top: 6px; height: 10px; background: var(--ice); border-radius: 999px; overflow: hidden; }
  .jauge__bar i, .funnel__bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--blue), var(--sky)); border-radius: 999px; transition: width .6s var(--ease); }
  .jauge__note { margin-top: 4px; font-size: 12px; color: var(--text-muted); }
  .objectif-form { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
  .objectif-form[hidden] { display: none; }
  .objectif-form label { display: flex; flex-direction: column; gap: 4px; font-size: 12.5px; font-weight: 600; color: var(--navy); }
  .objectif-form input { width: 110px; padding: 8px 10px; border: 1px solid var(--line); border-radius: var(--radius-sm); font: inherit; }
  .funnel { margin-top: 12px; }
  .funnel__head small { margin-left: auto; font-size: 11.5px; color: var(--text-muted); }
  .funnel__head b { margin-left: 8px; }

  .dashboard-chart-card { margin-top: 20px; padding: 20px 18px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .dashboard-chart-card__title { font-size: 13.5px; font-weight: 700; color: var(--navy); }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 8px; }
  .chart-legend__item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); }
  .chart-legend__dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .chart-legend__dot--visites { background: var(--sky); opacity: .55; }
  .chart-legend__dot--leads { background: var(--blue); }
