    (SH.querySelector('.pgx-sheet-in') as HTMLElement).scrollTop = 0;
    if (modeRempl) $('pgx-sh-alt').scrollIntoView({ block: 'nearest' });
    ($('pgx-sh-nom') as HTMLElement).focus({ preventScroll: modeRempl });
  }
  function fermerFiche() { SH.hidden = true; if (L.hidden) document.body.classList.remove('pgx-lock'); if (shRetour && document.contains(shRetour)) shRetour.focus(); }
  function remplacer(a: any) {
    const ex: any = etat.prog.seances[shI].exercices[shJ];
    const ancien = { nom: ex.nom, conseil: ex.conseil };
    ex.alt = [ancien].concat((ex.alt || []).filter((x: any) => x.nom !== a.nom));
    ex.nom = a.nom; ex.conseil = a.conseil;
    etat.swaps = (etat.swaps || []).concat([[shI, shJ, a.nom]]).slice(-40);
    ecrire(etat);
    SH.hidden = true; document.body.classList.remove('pgx-lock');
    render(etat.prog, etat.rep, false);
    const cible = document.querySelectorAll('.pgx-seance')[shI]?.querySelectorAll('.pgx-ex-nom')[shJ] as HTMLElement | undefined;
    if (cible) { cible.scrollIntoView({ block: 'center' }); cible.focus({ preventScroll: true }); }
  }
  $('pgx-sh-close').addEventListener('click', fermerFiche);
  $('pgx-sh-swap').addEventListener('click', () => { $('pgx-sh-alt').hidden = false; ($('pgx-sh-swap') as HTMLButtonElement).hidden = true; $('pgx-sh-alt').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
  SH.addEventListener('click', (ev) => { if (ev.target === SH) fermerFiche(); });

  // ---------- mode séance ----------
  const L = $('pgx-live');
  let si = 0, ei = 0, coches: boolean[][] = [], lock: any = null, retour: HTMLElement | null = null;
  let tFin = 0, tTot = 0, tId = 0;
  const secondes = (s: string) => { const m = /(\d+)\s*min(?:\s*(\d+))?/.exec(s); if (m) return +m[1] * 60 + (m[2] ? +m[2] : 0); const x = /(\d+)\s*s/.exec(s); return x ? +x[1] : 60; };
  const fmt = (n: number) => Math.floor(n / 60) + ':' + String(n % 60).padStart(2, '0');
  let audio: AudioContext | null = null;
  function bip() {
    try { navigator.vibrate && navigator.vibrate([180, 90, 180]); } catch (e) { /* rien */ }
    try {
      audio = audio || new (window.AudioContext || (window as any).webkitAudioContext)();
      [0, 0.25].forEach((d) => { const o = audio!.createOscillator(), g = audio!.createGain(); o.frequency.value = 880; o.connect(g); g.connect(audio!.destination); g.gain.setValueAtTime(0.18, audio!.currentTime + d); g.gain.exponentialRampToValueAtTime(0.001, audio!.currentTime + d + 0.2); o.start(audio!.currentTime + d); o.stop(audio!.currentTime + d + 0.22); });
    } catch (e) { /* son indisponible */ }
  }
  function stopTimer() { clearInterval(tId); tId = 0; $('pgx-timer').hidden = true; }
  function tick() {
    const reste = Math.max(0, Math.round((tFin - Date.now()) / 1000));
    $('pgx-timer-txt').textContent = fmt(reste);
    ($('pgx-timer-arc') as unknown as SVGCircleElement).style.strokeDashoffset = String(326.7 * (1 - reste / tTot));
    if (reste <= 0) { stopTimer(); bip(); }
  }
  function lancerRepos(sec: number) { tTot = sec; tFin = Date.now() + sec * 1000; $('pgx-timer').hidden = false; clearInterval(tId); tick(); tId = window.setInterval(tick, 500); $('pgx-timer').scrollIntoView({ behavior: 'smooth', block: 'end' }); }
  $('pgx-timer-plus').addEventListener('click', () => { tFin += 15000; tTot += 15; tick(); });
  $('pgx-timer-skip').addEventListener('click', stopTimer);

  function afficherEx() {
    const s: Seance = etat.prog.seances[si], e = s.exercices[ei];
    $('pgx-live-seance').textContent = 'Séance ' + (si + 1) + ' · ' + s.nom;
    $('pgx-live-pos').textContent = 'Exercice ' + (ei + 1) + ' sur ' + s.exercices.length;
    peindre('pgx-live-pic', e.nom);
    $('pgx-live-nom').textContent = e.nom;
    const nS = seriesDuJour(e);
    $('pgx-live-dose').textContent = nS + (nS > 1 ? ' séries' : ' série') + ' de ' + e.reps + ' · repos ' + e.repos;
    const sem = semaineEnCours(), et = etapeDe(etat.prog, sem), ls = $('pgx-live-sem');
    ls.hidden = !et || sem > 8; if (et && sem <= 8) ls.textContent = 'Semaine ' + sem + ' sur 8 · ' + et.t + (recup() ? ' : une série de moins' : '');
    const rir = (/t'en laisse (\d+)/.exec(e.effort || '') || [])[1];
    const cible = /seconde/.test(e.reps) || !rir ? '' : semaineEnCours() <= 2 ? '3 à 4' : rir;
    $('pgx-live-cue').textContent = e.conseil + (cible ? ' Objectif : finir chaque série avec ' + cible + ' répétitions en réserve. Descends en 2 à 3 secondes.' : '');
    const sansCharge = /seconde/.test(e.reps);
    $('pgx-live-kgw').hidden = sansCharge;
    const kin = $('pgx-live-kg') as HTMLInputElement; kin.value = '';
    const sg = chargeConseillee(e.nom);
    $('pgx-live-last').textContent = sg ? sg.txt : 'Note ta charge : tu la retrouveras à la prochaine séance.';
    kin.placeholder = sg ? String(sg.kg).replace('.', ',') : '0';
    $('pgx-live-rs').hidden = sansCharge; majRessenti();
    const sets = $('pgx-live-sets'); sets.textContent = '';
    for (let k = 0; k < nS; k++) {
      const b = el('button') as HTMLButtonElement; b.type = 'button';
      b.setAttribute('aria-pressed', String(!!coches[ei][k]));
      b.setAttribute('aria-label', 'Série ' + (k + 1) + (coches[ei][k] ? ', terminée' : ''));
      b.appendChild(document.createTextNode(String(k + 1))); b.appendChild(el('small', '', 'série'));
      b.addEventListener('click', () => {
        coches[ei][k] = !coches[ei][k];
        b.setAttribute('aria-pressed', String(coches[ei][k]));
        b.setAttribute('aria-label', 'Série ' + (k + 1) + (coches[ei][k] ? ', terminée' : ''));
        if (coches[ei][k] && k < nS - 1) lancerRepos(secondes(e.repos)); else if (!coches[ei][k]) stopTimer();
        if (coches[ei].filter(Boolean).length === nS) { stopTimer(); const rs = $('pgx-live-rs'); if (!rs.hidden) { rs.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); (rs.querySelector('button') as HTMLButtonElement).focus({ preventScroll: true }); } else ($('pgx-live-next') as HTMLButtonElement).focus(); }
        maj();
      });
      sets.appendChild(b);
    }
    ($('pgx-live-prev') as HTMLButtonElement).disabled = ei === 0;
    $('pgx-live-next').textContent = ei === s.exercices.length - 1 ? 'Terminer la séance ✓' : 'Exercice suivant →';
    maj();
  }
  function maj() {
    const total = coches.reduce((a, c) => a + c.length, 0), faits = coches.reduce((a, c) => a + c.filter(Boolean).length, 0);
    $('pgx-live-bar').style.width = (total ? (faits / total) * 100 : 0) + '%';
  }
  let sessionLive = 0;
  async function live(i: number) {
    si = i; ei = 0; sessionLive = Date.now();
    coches = etat.prog.seances[i].exercices.map((e: Ex) => new Array(seriesDuJour(e)).fill(false));
    retour = document.activeElement as HTMLElement;
    $('pgx-live-body').hidden = false; $('pgx-live-end').hidden = true; $('pgx-live-nav').hidden = false;
    L.hidden = false; document.body.classList.add('pgx-lock');
    stopTimer(); afficherEx(); ($('pgx-live-close') as HTMLButtonElement).focus();
    try { lock = await (navigator as any).wakeLock?.request('screen'); } catch (e) { lock = null; }
  }
  function fermer() {
    stopTimer(); L.hidden = true; document.body.classList.remove('pgx-lock');
    try { lock && lock.release(); } catch (e) { /* rien */ } lock = null;
    if (retour) retour.focus();
  }
  ($('pgx-live-kg') as HTMLInputElement).addEventListener('change', (ev) => {
    const v = parseFloat((ev.target as HTMLInputElement).value.replace(',', '.'));
    if (!(v > 0) || v > 500) return;
    const nom = etat.prog.seances[si].exercices[ei].nom;
    etat.charges = etat.charges || {}; etat.charges[nom] = { kg: Math.round(v * 2) / 2, d: Date.now() };
    etat.charges1 = etat.charges1 || {}; if (!etat.charges1[nom]) etat.charges1[nom] = { kg: Math.round(v * 2) / 2, d: Date.now() };
    ecrire(etat);
  });
  // ressenti après l'exercice
  const RS_TXT: Record<string, string> = { facile: 'Noté : la prochaine fois, on te proposera un peu plus lourd.', parfait: 'Noté : garde cette charge et vise une répétition de plus.', dur: 'Noté : la prochaine fois, on te proposera un peu plus léger.' };
  function majRessenti() {
    const nom = etat.prog.seances[si].exercices[ei].nom;
    const r = etat.ressenti && etat.ressenti[nom] && etat.ressenti[nom].s === sessionLive ? etat.ressenti[nom].r : '';
    $('pgx-live-rs').querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-r') === r)));
    $('pgx-live-rs-m').textContent = r ? RS_TXT[r] : '';
  }
  $('pgx-live-rs').querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
    const nom = etat.prog.seances[si].exercices[ei].nom;
    etat.ressenti = etat.ressenti || {}; etat.ressenti[nom] = { r: b.getAttribute('data-r'), d: Date.now(), s: sessionLive }; ecrire(etat);
    majRessenti();
  }));
  $('pgx-live-close').addEventListener('click', fermer);
  $('pgx-live-prev').addEventListener('click', () => { if (ei > 0) { ei--; stopTimer(); afficherEx(); } });
  $('pgx-live-next').addEventListener('click', () => {
    const s: Seance = etat.prog.seances[si];
    stopTimer();
    if (ei < s.exercices.length - 1) { ei++; afficherEx(); $('pgx-live-body').scrollTop = 0; return; }
    const faits = coches.reduce((a, c) => a + c.filter(Boolean).length, 0), total = coches.reduce((a, c) => a + c.length, 0);
    etat.faites = etat.faites || {}; etat.faites[si] = (etat.faites[si] || 0) + 1;
    etat.historique = (etat.historique || []).concat([{ d: Date.now(), s: si, f: faits }]).slice(-200); ecrire(etat);
    $('pgx-live-bilan').textContent = faits + ' séries cochées sur ' + total + '. Pense à boire et à faire ton retour au calme. Ta charge conseillée pour la prochaine fois est prête dans ton programme.';
    $('pgx-live-body').hidden = true; $('pgx-live-nav').hidden = true; $('pgx-live-end').hidden = false;
    const nS = etat.historique.length;
    suivre('seance_terminee', { numero: nS });
    // le bon moment pour proposer un coach : après 2 ou 3 séances, ou quand plusieurs exercices ont été trop durs
    const durs = s.exercices.filter((x) => etat.ressenti && etat.ressenti[x.nom] && etat.ressenti[x.nom].s === sessionLive && etat.ressenti[x.nom].r === 'dur').length;
    const mc = $('pgx-live-coach');
    mc.hidden = !(durs >= 2 || nS === 2 || nS === 3 || nS % 8 === 0);
    if (!mc.hidden) {
      $('pgx-live-coach-t').textContent = durs >= 2 ? 'Plusieurs exercices t\'ont paru durs aujourd\'hui' : nS + ' séances faites : tu es lancé !';
      $('pgx-live-coach-d').textContent = phraseCoach(salleDe(), durs >= 2 ? 'Pour progresser sans te blesser, ' : 'Pour aller plus loin, ');
      majCoach();
    }
    $('pgx-live-mail').hidden = !!etat.email || !mc.hidden;
    ($('pgx-live-fin') as HTMLButtonElement).focus();
  });
  $('pgx-live-fin').addEventListener('click', () => { fermer(); render(etat.prog, etat.rep, false); });
  $('pgx-live-mailbtn').addEventListener('click', () => {
    fermer(); render(etat.prog, etat.rep, false);
    $('pgx-mail').scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => ($('pgx-prenom') as HTMLInputElement).focus({ preventScroll: true }), 450);
  });

  // ---------- bandeau coach dans le programme ----------
  function renderNudge() {
    const n = (etat && etat.historique || []).length, nd = $('pgx-nudge');
    const vu = etat && etat.nudgeVu ? etat.nudgeVu : 0;
    nd.hidden = !(n >= 2 && n >= vu + 4 || n >= 2 && !vu);
    if (nd.hidden) return;
    $('pgx-nudge-t').textContent = n + ' séances faites, bravo !';
    $('pgx-nudge-d').textContent = phraseCoach(salleDe(), '');
    const d0 = $('pgx-nudge-d'); d0.textContent = d0.textContent.charAt(0).toUpperCase() + d0.textContent.slice(1);
  }
  $('pgx-nudge-x').addEventListener('click', () => { etat.nudgeVu = (etat.historique || []).length; ecrire(etat); $('pgx-nudge').hidden = true; });

  // ---------- progression et bilan des 8 semaines ----------
  function renderBilan() {
    const c1 = (etat && etat.charges1) || {}, c = (etat && etat.charges) || {};
    const noms = Object.keys(c).filter((n) => c1[n]);
    const box = $('pgx-bilan'); box.hidden = !noms.length;
    if (!noms.length) return;
    const fin = semaineEnCours() >= 8, nS = (etat.historique || []).length, prevu = (etat.prog.seances.length || 0) * 8;
    $('pgx-bilan-t').textContent = fin ? 'Ton bilan de 8 semaines' : 'Ta progression';
    $('pgx-bilan-d').textContent = nS + (nS > 1 ? ' séances faites' : ' séance faite') + ' sur ' + prevu + ' prévues. ' + (fin ? 'Compare tes charges de départ à celles d\'aujourd\'hui : c\'est le moment de faire le point.' : 'Tes charges notées depuis le début de ton programme.');
    const l = $('pgx-bilan-l'); l.textContent = '';
    const f = (v: number) => v.toLocaleString('fr-FR') + ' kg';
    noms.forEach((n) => {
      const a = c1[n].kg, b = c[n].kg, r = el('div', 'pgx-bilan-r'); r.setAttribute('role', 'row');
      [n, f(a), f(b)].forEach((t) => { const x = el('span', '', t); x.setAttribute('role', 'cell'); r.appendChild(x); });
      const ev = el('span'); ev.setAttribute('role', 'cell');
      if (b > a) ev.appendChild(el('b', '', '+' + (b - a).toLocaleString('fr-FR') + ' kg' + (a > 0 ? ' (+' + Math.round(((b - a) / a) * 100) + ' %)' : ''))); else ev.textContent = b === a ? '=' : (b - a).toLocaleString('fr-FR') + ' kg';
      r.appendChild(ev); l.appendChild(r);
    });
    $('pgx-bilan-cta').hidden = !fin;
    $('pgx-phase2').textContent = 'Créer ma phase ' + ((etat.rep.phase || 1) + 1);
  }

  // ---------- lien personnel ----------
  $('pgx-lien').addEventListener('click', async () => {
    const b = $('pgx-lien'), lien = lienSuivi();
    try { await navigator.clipboard.writeText(lien); b.textContent = '✓ Lien copié : ouvre-le sur ton autre téléphone'; }
    catch (e) { window.prompt('Copie ce lien et ouvre-le sur ton autre téléphone :', lien); }
    suivre('programme_lien_copie');
    setTimeout(() => (b.textContent = '🔗 Copier mon lien pour un autre téléphone'), 4000);
  });
  (async () => {
    let t = ''; try { t = new URLSearchParams(location.search).get('suivi') || ''; } catch (e) { /* rien */ }
    if (!t || t.length > 6000 || !/^[A-Za-z0-9_-]+$/.test(t)) return;
    try {
      const j = JSON.parse(deb64(t)); if (!j || j.v !== 1 || !j.r) return;
      const r = await fetch('/.netlify/functions/programme', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(j.r) });
      if (!r.ok) return;
      const d = await r.json(), prog = d.programme;
      const now = Date.now();
      const charges: any = {}, charges1: any = {}, ressenti: any = {};
      Object.keys(j.k || {}).forEach((n) => { const v = j.k[n]; if (Array.isArray(v) && v.length === 2 && v.every((x: any) => typeof x === 'number' && x >= 0 && x < 1000)) { charges1[n] = { kg: v[0], d: now }; charges[n] = { kg: v[1], d: now }; } });
      Object.keys(j.s || {}).forEach((n) => { if (['facile', 'parfait', 'dur'].includes(j.s[n])) ressenti[n] = { r: j.s[n], d: now, s: 0 }; });
      const historique = (Array.isArray(j.h) ? j.h : []).filter((x: any) => Array.isArray(x) && x.length === 3).map((x: any) => ({ d: +x[0] * 60000, s: +x[1], f: +x[2] }));
      const faites: any = {}; historique.forEach((x: any) => (faites[x.s] = (faites[x.s] || 0) + 1));
      etat = { rep: j.r, prog, faites, historique, charges, charges1, ressenti, date: +j.d * 60000 || now, swaps: [] };
      // remplacements d'exercices faits sur l'ancien téléphone
      (Array.isArray(j.x) ? j.x : []).forEach((x: any) => {
        const ex = prog.seances[x[0]] && prog.seances[x[0]].exercices[x[1]]; if (!ex) return;
        const a = (ex.alt || []).find((y: any) => y.nom === x[2]); if (!a) return;
        ex.alt = [{ nom: ex.nom, conseil: ex.conseil }].concat(ex.alt.filter((y: any) => y.nom !== a.nom)); ex.nom = a.nom; ex.conseil = a.conseil; etat.swaps.push(x);
      });
      ecrire(etat);
      history.replaceState(null, '', location.pathname);
      suivre('programme_restaure');
      render(prog, j.r);
    } catch (e) { /* lien abîmé : on ignore */ }
  })();
  document.addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; if (!SH.hidden) fermerFiche(); else if (!L.hidden) fermer(); });
</script>
