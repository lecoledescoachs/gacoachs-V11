---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/rb/Crumbs.astro';
import Icones from '../../components/rb/Icones.astro';
import '../../styles/rebrand.css';
import FICHES from '../../data/exercices-fiches.json';
import SALLES from '../../data/salles.json';
import { coachesReseau } from '../../data/coaches.js';
// salles du réseau et leurs coachs, pour présenter le coach de la salle de la personne
const SALLES_PROG = SALLES.filter((s: any) => s.reseauOfficiel !== false).map((s: any) => ({
  slug: s.slug, nom: s.nom, ville: s.ville,
  coachs: s.coachs.map((c: string) => coachesReseau.find((x: any) => x.slug === c)).filter(Boolean).map((c: any) => ({ slug: c.slug, prenom: c.prenom, photo: c.photo, titre: c.slug === 'garry-babaud' ? 'Coach en chef' : 'Coach sportif' })),
})).filter((s: any) => s.coachs.length);

const Q = [
  { id: 'objectif', l: 'Quel est ton objectif principal ?', o: [['perte-poids', 'Perdre du poids', 'Brûler du gras et te sentir plus léger'], ['prise-muscle', 'Prendre du muscle', 'Construire du volume, séance après séance'], ['force', 'Gagner en force', 'Soulever plus lourd, en sécurité'], ['forme', 'Me remettre en forme', 'Retrouver de l\'énergie et une bonne condition']] },
  { id: 'zone', l: 'Une zone à travailler en priorité ?', o: [['equilibre', 'Tout le corps', 'Un développement équilibré'], ['fessiers', 'Fessiers et jambes', 'Galber et renforcer le bas du corps'], ['bras', 'Bras et épaules', 'Plus de tonus et de volume'], ['dos', 'Dos et posture', 'Un dos solide pour te tenir droit'], ['abdos', 'Abdos et gainage', 'Un ventre plus ferme, un tronc solide']] },
  { id: 'niveau', l: 'Quel est ton niveau ?', o: [['debutant', 'Débutant', 'Moins de 6 mois de pratique'], ['intermediaire', 'Intermédiaire', 'Entre 6 mois et 2 ans'], ['avance', 'Avancé', 'Plus de 2 ans, régulier']] },
  { id: 'jours', l: 'Combien de séances par semaine ?', o: [['2', '2 séances', 'Idéal pour démarrer'], ['3', '3 séances', 'Le bon équilibre'], ['4', '4 séances', 'Pour aller plus vite']] },
  { id: 'duree', l: 'Combien de temps par séance ?', o: [['30', '30 minutes', 'Séance express, 4 exercices'], ['45', '45 minutes', '5 exercices'], ['60', '1 heure', '6 exercices'], ['75', '1 h 15', '7 exercices']] },
  { id: 'materiel', l: 'Quel matériel as-tu à disposition ?', o: [['complet', 'Salle complète', 'Barres, haltères, poulies, machines'], ['machines', 'Machines guidées surtout', 'Parfait pour bien débuter'], ['minimal', 'Haltères et poids du corps', 'À la maison ou en petite salle']] },
];
const LIM = [['dos', 'Le dos'], ['genoux', 'Les genoux'], ['epaules', 'Les épaules']];
const ETAPES = Q.length + 1;

const faq = [
  { q: 'Le programme est-il vraiment gratuit ?', r: 'Oui. Tu réponds aux questions, ton programme s\'affiche tout de suite, sans compte et sans carte bancaire. Tu peux aussi le recevoir par email si tu veux le garder.' },
  { q: 'Comment les exercices sont-ils choisis ?', r: 'Chaque exercice est choisi selon ton niveau, ton matériel et les zones qui te gênent. Un débutant ne reçoit pas de mouvements techniques à la barre, et si tu signales ton dos, tes genoux ou tes épaules, les exercices qui les sollicitent le plus sont écartés.' },
  { q: 'Comment fonctionne le mode séance ?', r: 'En salle, ouvre ta séance sur ton téléphone : tu coches chaque série et un minuteur lance ton temps de repos. Tu notes ta charge et ton ressenti, et la séance suivante te propose la charge à prendre. Ton programme reste enregistré sur ton téléphone.' },
  { q: 'Le programme marche-t-il pour perdre du poids ?', r: 'Oui. Choisis « Perdre du poids » comme objectif : les séries et les temps de repos sont adaptés pour brûler du gras tout en préservant tes muscles. Associe-le à de l\'activité au quotidien et à une alimentation régulière.' },
  { q: 'Puis-je m\'entraîner à la maison ?', r: 'Oui. Choisis « Haltères et poids du corps » comme matériel : le programme utilise uniquement des exercices faisables à la maison ou en petite salle.' },
  { q: 'Je débute, par quoi commencer ?', r: 'Choisis le niveau débutant, 2 séances par semaine et des machines guidées si tu es en salle. Tu apprends les mouvements en sécurité, puis tu augmentes progressivement.' },
  { q: 'Combien de séances par semaine choisir ?', r: 'Deux séances suffisent pour démarrer, trois offrent un bon équilibre, quatre permettent d\'aller plus vite si tu récupères bien. Mieux vaut un rythme que tu tiens qu\'un rythme trop ambitieux.' },
  { q: 'Puis-je refaire un programme plus tard ?', r: 'Oui. Quand ton objectif ou ton niveau change, réponds de nouveau aux questions pour obtenir un nouveau programme adapté.' },
  { q: 'Comment aller plus loin avec un coach ?', r: 'Fais ton Score Santé en 2 minutes, puis réserve ton bilan avec un coach GA en salle Basic-Fit à Orléans. Il corrige ta technique et ajuste ton programme semaine après semaine.' },
  { q: 'Ce programme remplace-t-il un coach sportif ?', r: 'Non. C\'est un point de départ général. Un coach sportif te montre les mouvements, corrige ta technique et ajuste les charges et la progression selon tes résultats.' },
  { q: 'Que faire si j\'ai une douleur ou un problème de santé ?', r: 'En cas de douleur, de malaise ou de doute, arrête et demande l\'avis d\'un médecin avant de reprendre. Si tu as une contre-indication connue, consulte avant de commencer.' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://gacoachs.fr/' },
      { '@type': 'ListItem', position: 2, name: 'Programme de musculation personnalisé', item: 'https://gacoachs.fr/mon-programme/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  },
];
---
<BaseLayout
  title="Programme musculation gratuit personnalisé · coach sportif"
  description="Crée ton programme de musculation gratuit en 2 minutes : adapté à ton objectif, ton niveau et ton matériel, avec un mode séance et un minuteur de repos."
  path="/mon-programme/"
  jsonLd={[jsonLd].flat().filter((x) => x?.['@type'] !== 'BreadcrumbList')}
  stickyCtaHref={false}
>
<div class="rb pgx">
  <Icones />
  <script type="application/json" id="pgx-fiches" set:html={JSON.stringify(FICHES)}></script>
  <script type="application/json" id="pgx-salles" set:html={JSON.stringify(SALLES_PROG)}></script>

  <!-- haut de page -->
  <section class="phero no-print" data-hero>
    <div class="lightning-bg" aria-hidden="true"></div>
    <div class="inner">
      <Crumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Programme personnalisé', href: '/mon-programme/' }]} />
      <div class="pgx-hero">
        <div>
          <span class="eyebrow eyebrow-dark" data-a="pop">Outil gratuit</span>
          <h1 data-a="up">Ton programme de musculation, <span class="hl-text">fait pour toi.</span></h1>
          <p class="phero-lead" data-a="up">Sept questions, deux minutes. Tu reçois un programme construit selon ton objectif, ta zone prioritaire, ton niveau, ton matériel et les zones qui te gênent. En salle, ouvre-le sur ton téléphone : tu coches tes séries et le minuteur gère tes temps de repos.</p>
          <ul class="pgx-chips" data-a="up">
            <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>2 minutes</li>
            <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"/></svg>Gratuit, sans compte</li>
            <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></svg>Mode séance sur téléphone</li>
          </ul>
          <div class="pgx-ctas" data-a="up">
            <a class="btn btn-primary" href="#pgx-quiz">Créer mon programme</a>
            <button type="button" class="btn btn-glass" id="pgx-reprendre" hidden>Reprendre mon programme</button>
          </div>
          <p class="pgx-asso" id="pgx-asso" hidden></p>
        </div>
        <div class="pgx-phone" aria-hidden="true" data-a="zoom">
          <div class="pgx-phone-top"><span>Séance 1 · Corps entier A</span><b>Exemple</b></div>
          <svg class="pgx-pic pgx-phone-pic" id="pgx-phone-pic"></svg>
          <div class="pgx-phone-ex">
            <small>Exercice 2 sur 6</small>
            <strong>Développé machine convergente</strong>
            <span class="pgx-phone-dose">3 x 10 à 12 · repos 1 min</span>
            <div class="pgx-phone-sets"><i class="ok">1</i><i class="ok">2</i><i>3</i></div>
          </div>
          <div class="pgx-phone-timer">
            <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="t-bg"/><circle cx="60" cy="60" r="52" class="t-fg"/></svg>
            <div><b>0:42</b><small>repos</small></div>
          </div>
          <div class="pgx-phone-bar"><i></i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- questionnaire -->
  <section class="sec" id="pgx-quiz">
    <div class="inner pgx-wrap">
      <div class="pgx-progress no-print" aria-hidden="true"><span class="pgx-progress-txt" id="pgx-etape">Question 1 sur {ETAPES}</span><div class="pgx-progress-bar"><i id="pgx-bar"></i></div></div>
      <form class="pgx-form" id="pgx-form" novalidate>
        {Q.map((q, n) => (
          <fieldset class="pgx-q" data-step={n}>
            <legend>{q.l}</legend>
            <div class="pgx-opts">
              {q.o.map((o) => (
                <label class="pgx-opt">
                  <input type="radio" name={q.id} value={o[0]} required />
                  <span><b>{o[1]}</b><small>{o[2]}</small></span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <fieldset class="pgx-q" data-step={Q.length}>
          <legend>Une zone te gêne parfois ? <small>Facultatif : les exercices qui la sollicitent le plus seront écartés.</small></legend>
          <div class="pgx-opts">
            {LIM.map((o) => (
              <label class="pgx-opt pgx-opt-sm">
                <input type="checkbox" name="limites" value={o[0]} />
                <span><b>{o[1]}</b></span>
              </label>
            ))}
          </div>
          <label class="pgx-salle" for="pgx-salle-q">
            <span>Ta salle Basic-Fit <small>(facultatif)</small></span>
            <select id="pgx-salle-q" name="salle">
              <option value="">Je ne sais pas encore, ou une autre salle</option>
              {SALLES_PROG.map((s: any) => (<option value={s.slug}>{s.nom}</option>))}
            </select>
            <small>Pour te présenter le coach GA de ta salle.</small>
          </label>
          <label class="pgx-consent">
            <input type="checkbox" id="pgx-ok" />
            <span>Je confirme n'avoir aucune contre-indication connue à la pratique sportive. Si j'ai un doute, je demande l'avis de mon médecin avant de commencer.</span>
          </label>
          <p class="pgx-err" id="pgx-err" role="alert" hidden></p>
          <button type="submit" class="btn btn-primary" id="pgx-go">Créer mon programme</button>
          <p class="pgx-note">Tes réponses servent uniquement à construire ton programme. Elles ne sont pas enregistrées avec ton nom.</p>
        </fieldset>
        <div class="pgx-nav no-print">
          <button type="button" class="pgx-back" id="pgx-prev" hidden>← Question précédente</button>
        </div>
      </form>
    </div>
  </section>

  <!-- résultat -->
  <section class="sec pgx-res" id="pgx-res" hidden>
    <div class="inner pgx-wrap">
      <div class="pgx-res-head">
        <span class="eyebrow" id="pgx-badge" data-wow="off">Ton programme</span>
        <h2 class="h2" id="pgx-titre" tabindex="-1"></h2>
        <p class="pgx-asso" id="pgx-asso2" hidden></p>
        <p class="lead-p" id="pgx-resume"></p>
        <ul class="pgx-tags" id="pgx-tags"></ul>
      </div>
      <div class="pgx-nudge no-print" id="pgx-nudge" hidden>
        <div class="pgx-faces" data-faces></div>
        <p><b id="pgx-nudge-t"></b> <span id="pgx-nudge-d"></span></p>
        <div class="pgx-nudge-b">
          <a class="btn btn-primary" href="/score-sante/" data-cta="bandeau" data-score>Faire mon Score Santé</a>
          <button type="button" class="pgx-nudge-x" id="pgx-nudge-x">Plus tard</button>
        </div>
      </div>
      <div class="pgx-stats" id="pgx-stats" hidden>
        <div><b id="pgx-st-s">0</b><span id="pgx-st-sl">séances terminées</span></div>
        <div><b id="pgx-st-r">0</b><span id="pgx-st-rl">séries cochées</span></div>
        <div><b id="pgx-st-d">-</b><span>dernière séance</span></div>
      </div>

      <div class="pgx-now" id="pgx-now" hidden>
        <div class="pgx-now-h"><b id="pgx-now-t"></b><small id="pgx-now-s"></small></div>
        <ol class="pgx-now-bar" id="pgx-now-bar" aria-hidden="true"></ol>
        <p id="pgx-now-d"></p>
        <button type="button" class="btn btn-primary no-print" id="pgx-phase" hidden>Passer à la phase suivante</button>
      </div>

      <div class="pgx-week">
        <p class="pgx-week-t">Exemple d'organisation de ta semaine</p>
        <ol class="pgx-days" id="pgx-days"></ol>
        <button type="button" class="pgx-ics no-print" id="pgx-ics">📅 Ajouter mes 8 semaines à mon agenda</button>
      </div>

      <div class="pgx-box pgx-avant" id="pgx-avant" hidden>
        <h3>Avant ta première séance</h3>
        <ul id="pgx-avant-l"></ul>
      </div>

      <div id="pgx-seances"></div>

      <div class="pgx-bilan" id="pgx-bilan" hidden>
        <h3 id="pgx-bilan-t">Ta progression</h3>
        <p id="pgx-bilan-d"></p>
        <div class="pgx-bilan-tab" role="table" aria-label="Évolution de tes charges">
          <div class="pgx-bilan-h" role="row"><span role="columnheader">Exercice</span><span role="columnheader">Début</span><span role="columnheader">Actuel</span><span role="columnheader">Écart</span></div>
          <div id="pgx-bilan-l"></div>
        </div>
        <div class="pgx-bilan-b no-print" id="pgx-bilan-cta" hidden><a class="btn btn-primary" href="/score-sante/" data-cta="bilan" data-score id="pgx-bilan-coach">Faire le point avec un coach GA</a><button type="button" class="btn-out" id="pgx-phase2">Créer ma phase 2</button></div>
      </div>

      <div class="pgx-plan" id="pgx-plan" hidden>
        <h3>Ton plan sur 8 semaines</h3>
        <p>Les mêmes séances pendant 8 semaines : c'est la répétition qui te fait progresser. Seule l'intensité évolue.</p>
        <ol class="pgx-plan-l" id="pgx-plan-l"></ol>
      </div>

      <div class="pgx-mail no-print" id="pgx-mail">
        <div>
          <h3>Reçois ton programme par email</h3>
          <p>Garde-le dans ta boîte mail, avec ton lien personnel : il te permet de retrouver ton programme et tes charges sur n'importe quel téléphone.</p>
        </div>
        <form name="programme-email" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="pgx-mailform" action="/mon-programme/">
          <input type="hidden" name="form-name" value="programme-email" />
          <p hidden><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <input type="hidden" name="objectif" /><input type="hidden" name="niveau" /><input type="hidden" name="jours" /><input type="hidden" name="duree" /><input type="hidden" name="materiel" /><input type="hidden" name="limites" /><input type="hidden" name="zone" /><input type="hidden" name="suivi" /><input type="hidden" name="salle" />
          <div class="pgx-mail-f">
            <label for="pgx-prenom">Prénom<input id="pgx-prenom" name="prenom" type="text" autocomplete="given-name" required /></label>
            <label for="pgx-email">Email<input id="pgx-email" name="email" type="email" autocomplete="email" required /></label>
          </div>
          <label class="pgx-mail-opt"><input type="checkbox" name="recontact" value="oui" /> <span>J'aimerais qu'un coach GA me recontacte pour m'aider à démarrer.</span></label>
          <button type="submit" class="btn btn-primary">Recevoir mon programme</button>
          <p class="pgx-err" id="pgx-mailerr" role="alert" hidden></p>
          <p class="pgx-mail-ok" id="pgx-mailok" tabindex="-1" hidden></p>
          <p class="pgx-note">Ton email sert uniquement à t'envoyer ce programme{' '}(et à te recontacter si tu as coché la case). Voir notre <a href="/confidentialite/">politique de confidentialité</a>.</p>
        </form>
      </div>

      <div class="pgx-box">
        <h3>Conseils pour bien démarrer</h3>
        <ul id="pgx-conseils"></ul>
        <h3>Pour progresser</h3>
        <p id="pgx-prog"></p>
        <div id="pgx-lex" hidden>
          <h3>Les mots à connaître</h3>
          <dl class="pgx-lex" id="pgx-lex-l"></dl>
        </div>
      </div>
      <div class="pgx-coach no-print">
        <div>
          <div class="pgx-faces" data-faces></div>
          <h3 id="pgx-coach-t">Tu veux être sûr de bien faire ?</h3>
          <p id="pgx-coach-d">Un coach GA te montre chaque mouvement dans ta salle Basic-Fit, corrige ta technique et ajuste tes charges. Commence par ton Score Santé : 2 minutes pour faire le point.</p>
          <label class="pgx-coach-salle" for="pgx-salle-r">
            <span>Ta salle Basic-Fit</span>
            <select id="pgx-salle-r">
              <option value="">Choisis ta salle pour voir ton coach</option>
              {SALLES_PROG.map((s: any) => (<option value={s.slug}>{s.nom}</option>))}
            </select>
          </label>
        </div>
        <div class="pgx-coach-b">
          <a class="btn btn-primary" href="/score-sante/" data-cta="bloc" data-score>Faire mon Score Santé</a>
          <a class="btn-out" href="/trouver-un-coach/" data-cta="bloc-coach" id="pgx-coach-fiche">Trouver un coach GA</a>
        </div>
      </div>
      <p class="pgx-warn" id="pgx-warn"></p>
      <div class="pgx-actions no-print">
        <button type="button" class="btn-out" id="pgx-print">Imprimer ou enregistrer en PDF</button>
        <button type="button" class="btn-out" id="pgx-redo">Refaire le questionnaire</button>
        <button type="button" class="btn-out" id="pgx-lien">🔗 Copier mon lien pour un autre téléphone</button>
        <a class="btn-out" href="/trouver-un-coach/">Trouver un coach GA près de chez moi</a>
      </div>
    </div>
  </section>

  <!-- contenu -->
  <section class="sec band no-print" id="pgx-infos">
    <div class="inner">
      <span class="eyebrow">Comment c'est construit</span>
      <h2 class="h2">Un programme sérieux, pas une liste d'exercices au hasard.</h2>
      <div class="pgx-how">
        <div><b>Des exercices adaptés à ton niveau</b><p>Machines guidées et mouvements simples pour démarrer, exercices plus techniques quand tu as de l'expérience.</p></div>
        <div><b>Des séries et des repos selon ton objectif</b><p>Perte de poids, prise de muscle, force ou remise en forme : le nombre de répétitions et les temps de repos changent avec ton but.</p></div>
        <div><b>Chaque mouvement montré en animation</b><p>Un personnage animé montre chaque exercice, et sa fiche détaille les muscles travaillés et les étapes du geste.</p></div>
        <div><b>Ta zone prioritaire mise en avant</b><p>Fessiers, bras, dos ou abdos : la zone que tu veux travailler passe en début de séance, avec un peu plus de volume.</p></div>
        <div><b>Tes zones sensibles respectées</b><p>Si ton dos, tes genoux ou tes épaules te gênent, les exercices qui les sollicitent le plus sont écartés.</p></div>
        <div><b>Un plan qui avance avec toi</b><p>Le programme sait où tu en es sur tes 8 semaines. Après chaque exercice, dis comment c'était : la charge à prendre la fois suivante t'est proposée.</p></div>
        <div><b>Une organisation sur la semaine</b><p>Corps entier quand tu t'entraînes 2 ou 3 fois, haut et bas du corps quand tu passes à 4 séances.</p></div>
      </div>
      <h2 class="h2 pgx-faq-t">Questions fréquentes</h2>
      <div class="faq-list">
        {faq.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.r}</p></details>))}
      </div>
    </div>
  </section>

  <!-- fiche exercice -->
  <div class="pgx-sheet" id="pgx-sheet" role="dialog" aria-modal="true" aria-labelledby="pgx-sh-nom" hidden>
    <div class="pgx-sheet-in">
      <button type="button" class="pgx-sheet-x" id="pgx-sh-close" aria-label="Fermer la fiche">✕</button>
      <svg class="pgx-pic pgx-sh-pic" id="pgx-sh-pic"></svg>
      <h2 id="pgx-sh-nom" tabindex="-1"></h2>
      <p class="pgx-sh-dose" id="pgx-sh-dose"></p>
      <div class="pgx-sh-mus" id="pgx-sh-mus"></div>
      <h3>Comment faire</h3>
      <ol class="pgx-sh-steps" id="pgx-sh-steps"></ol>
      <p class="pgx-sh-cue" id="pgx-sh-cue"></p>
      <p class="pgx-sh-eff" id="pgx-sh-eff" hidden></p>
      <p class="pgx-kg" id="pgx-sh-kg" hidden></p>
      <div class="pgx-sh-alt" id="pgx-sh-alt" hidden>
        <h3>Remplacer par</h3>
        <div class="pgx-sh-altlist" id="pgx-sh-altlist"></div>
        <p class="pgx-note">Mêmes séries, mêmes répétitions, mêmes repos. Seuls les exercices compatibles avec ton matériel, ton niveau et tes zones sensibles sont proposés.</p>
      </div>
      <div class="pgx-sh-btns"><button type="button" class="btn-out" id="pgx-sh-swap">Remplacer cet exercice</button></div>
    </div>
  </div>

  <!-- mode séance -->
  <div class="pgx-live" id="pgx-live" role="dialog" aria-modal="true" aria-labelledby="pgx-live-nom" hidden>
    <div class="pgx-live-top">
      <div><small id="pgx-live-seance"></small><b id="pgx-live-pos"></b></div>
      <button type="button" class="pgx-live-x" id="pgx-live-close" aria-label="Quitter la séance">✕</button>
    </div>
    <div class="pgx-live-bar"><i id="pgx-live-bar"></i></div>
    <div class="pgx-live-body" id="pgx-live-body">
