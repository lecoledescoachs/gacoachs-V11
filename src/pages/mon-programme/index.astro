<script>
  import { animer } from '../../scripts/bonhomme.js';
  type Ex = { nom: string; series: number; reps: string; repos: string; conseil: string; effort?: string };
  type Seance = { nom: string; duree?: number; echauffement: string; echauffementEtapes?: string[]; exercices: Ex[]; finisher?: string; retourAuCalme: string; retourEtapes?: string[] };
  type Prog = { titre: string; resume: string; seances: Seance[]; conseils: string[]; progression: string; avertissement: string; source?: string; semaines?: { s: string; t: string; d: string }[]; avant?: string[]; lexique?: [string, string][] };

  const CLE = 'ga_programme_v1';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const lire = () => { try { const v = localStorage.getItem(CLE); return v ? JSON.parse(v) : null; } catch (e) { return null; } };
  const ecrire = (v: any) => { try { localStorage.setItem(CLE, JSON.stringify(v)); } catch (e) { /* stockage indisponible */ } };
  const SVGNS = 'http://www.w3.org/2000/svg';
  // pictogramme animé de l'exercice (rien n'est affiché si l'exercice n'a pas de pictogramme)
  function picto(nom: string, cls = 'pgx-pic') { const s = document.createElementNS(SVGNS, 'svg'); s.setAttribute('class', cls); return animer(s, nom) ? s : null; }
  function peindre(id: string, nom: string) { const s = document.getElementById(id) as unknown as SVGSVGElement; const ok = animer(s, nom); (s as any).style.display = ok ? '' : 'none'; }
  const el = (tag: string, cls?: string, txt?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (txt != null) n.textContent = txt; return n; };

  let FICHE: Record<string, { m: string[]; s: string[]; e: string[] }> = {};
  try { FICHE = JSON.parse(($('pgx-fiches') as HTMLElement).textContent || '{}'); } catch (e) { FICHE = {}; }
  // bloc titre + liste d'étapes (repli sur le texte pour les anciens programmes enregistrés)
  function bloc(parent: HTMLElement, titre: string, etapes: string[] | undefined, texte: string) {
    const w = el('div', 'pgx-bloc'); w.appendChild(el('b', '', titre));
    if (etapes && etapes.length) { const u = el('ul'); etapes.forEach((t) => u.appendChild(el('li', '', t))); w.appendChild(u); }
    else w.appendChild(el('p', '', texte));
    parent.appendChild(w);
  }
  // ---------- où en est la personne sur ses 8 semaines ----------
  const JOUR_MS = 86400000;
  function semaineEnCours(): number { const d = etat && etat.date ? etat.date : Date.now(); return Math.floor((Date.now() - d) / (7 * JOUR_MS)) + 1; }
  function etapeDe(p: Prog, n: number) {
    const S = p.semaines || []; if (!S.length) return null;
    const k = n <= 2 ? 0 : n <= 4 ? 1 : n <= 6 ? 2 : n === 7 ? 3 : 4;
    return S[Math.min(k, S.length - 1)];
  }
  const recup = () => semaineEnCours() === 8;
  const seriesDuJour = (e: Ex) => (recup() ? Math.max(1, e.series - 1) : e.series);
  // ---------- charge conseillée selon la charge notée et le ressenti ----------
  const arrondi = (v: number) => Math.round(v * 2) / 2;
  function chargeConseillee(nom: string): { kg: number; txt: string } | null {
    const c = etat && etat.charges && etat.charges[nom]; if (!c) return null;
    const r = etat.ressenti && etat.ressenti[nom] ? etat.ressenti[nom].r : null;
    const pas = c.kg < 20 ? 1 : 2.5;
    const f = (v: number) => v.toLocaleString('fr-FR');
    if (recup()) return { kg: c.kg, txt: 'Semaine de récupération : garde ' + f(c.kg) + ' kg, avec une série de moins.' };
    if (semaineEnCours() <= 2) return { kg: c.kg, txt: 'Semaines d\'apprentissage : garde ' + f(c.kg) + ' kg et soigne ta technique.' };
    if (r === 'facile') return { kg: arrondi(c.kg + pas), txt: 'C\'était trop facile : essaie ' + f(arrondi(c.kg + pas)) + ' kg aujourd\'hui.' };
    if (r === 'dur') return { kg: Math.max(0, arrondi(c.kg - pas)), txt: 'C\'était trop dur : reprends à ' + f(Math.max(0, arrondi(c.kg - pas))) + ' kg et fais toutes tes répétitions.' };
    if (r === 'parfait') return { kg: c.kg, txt: 'Garde ' + f(c.kg) + ' kg et vise une répétition de plus par série. Si tu fais le haut de la fourchette partout, ajoute ' + f(pas) + ' kg la prochaine fois.' };
    return { kg: c.kg, txt: 'La dernière fois : ' + f(c.kg) + ' kg.' };
  }
  // ---------- mesure (Google Analytics, uniquement après accord des cookies) ----------
  const suivre = (nom: string, d?: Record<string, any>) => { try { (window as any).trackConversion && (window as any).trackConversion(nom, d); } catch (e) { /* rien */ } };
  document.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest && (e.target as HTMLElement).closest('[data-cta]'); if (a) suivre('programme_cta_coach', { source: a.getAttribute('data-cta') }); });

  // ---------- le coach GA de la salle de la personne ----------
  let SAL: any[] = [];
  try { SAL = JSON.parse(($('pgx-salles') as HTMLElement).textContent || '[]'); } catch (e) { SAL = []; }
  const salleDe = () => (etat && etat.rep && etat.rep.salle ? SAL.find((x) => x.slug === etat.rep.salle) || null : null);
  const liste = (a: string[]) => (a.length > 1 ? a.slice(0, -1).join(', ') + ' et ' + a[a.length - 1] : a[0] || '');
  const ville = (sa: any) => sa.nom.replace(/^Basic-Fit\s+/, '');
  function phraseCoach(sa: any, debut: string) {
    if (!sa) return debut + 'un coach GA de ta salle Basic-Fit peut vérifier ta technique et ajuster tes charges. Commence par ton Score Santé : 2 minutes, gratuit.';
    const p = sa.coachs.map((c: any) => c.prenom), plus = p.length > 1;
    return debut + liste(p) + (plus ? ', tes coachs GA à ' : ', ton coach GA à ') + ville(sa) + (plus ? ', peuvent' : ', peut') + ' vérifier ta technique et ajuster tes charges. Commence par ton Score Santé : 2 minutes, gratuit.';
  }
  function majCoach() {
    const sa = salleDe();
    document.querySelectorAll<HTMLElement>('[data-faces]').forEach((f) => {
      f.textContent = '';
      (sa ? sa.coachs : []).slice(0, 3).forEach((c: any) => { const im = document.createElement('img'); im.src = c.photo; im.alt = ''; im.width = 52; im.height = 52; im.decoding = 'async'; f.appendChild(im); });
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-score]').forEach((a) => (a.href = '/score-sante/' + (sa ? '?coach=' + encodeURIComponent(sa.coachs[0].slug) : '')));
    const fi = $('pgx-coach-fiche') as HTMLAnchorElement;
    if (sa && sa.coachs.length === 1) { fi.href = '/coachs/' + sa.coachs[0].slug + '/'; fi.textContent = 'Voir le profil de ' + sa.coachs[0].prenom; }
    else if (sa) { fi.href = '/salles/' + sa.slug + '/'; fi.textContent = 'Voir les coachs de ta salle'; }
    else { fi.href = '/trouver-un-coach/'; fi.textContent = 'Trouver un coach GA'; }
    if (sa) {
      const p = sa.coachs.map((c: any) => c.prenom);
