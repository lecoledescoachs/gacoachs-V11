    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${expertise.nom} à Orléans`,
    serviceType: expertise.nom,
    url: `https://gacoachs.fr/${expertise.slug}/`,
    provider: { '@type': 'Organization', name: 'GA Coachs', url: 'https://gacoachs.fr/' },
    areaServed: villesHorsQ.map((v) => ({ '@type': 'City', name: v.nom })),
    audience: { '@type': 'Audience', audienceType: expertise.publics.join(', ') },
    description: expertise.resume,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqTout.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.r } })),
  },
];
---
<BaseLayout
  title={`${expertise.nom} à Orléans avec un coach sportif GA`}
  description={descExpertise}
  path={`/${expertise.slug}/`}
  jsonLd={jsonLd}
  image={expertise.slug === 'preparation-physique' ? '/images/og-boost-club.jpg' : undefined}
>
<div class="rb rb-legacy">
  <Icones />
  <section class="phero">
    <div class="lightning-bg" aria-hidden="true"></div>
    <div class="inner">
      <Crumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Nos expertises', href: '/#expertises' }, { label: expertise.nom, href: `/${expertise.slug}/` }]} />
      <div class="ex-hero">
        <div>
          <div class="ex-tags">
            <span class="eyebrow eyebrow-dark">Nos expertises</span>
            {programme && <span class="eyebrow eyebrow-dark">{programme}</span>}
          </div>
          <h1>{nomDebut} <span class="hl-text">{nomFin}</span>.</h1>
          <p class="phero-lead">{expertise.resume}</p>
          {expertise.slug === 'mal-de-dos' && <p class="ex-disc">Cet accompagnement ne remplace pas un avis médical et ne constitue pas une promesse de guérison.</p>}
          <div class="ctas">
            <a class="btn btn-primary" href="/score-sante/">Réserver mon bilan santé</a>
            <a class="btn btn-glass" href="/score-sante/">Faire mon Score Santé</a>
          </div>
        </div>
        <div role="note" class="ex-pq">
          <span class="bt-k"><svg class="ic" aria-hidden="true"><use href="#i-users"></use></svg>Pour qui ?</span>
          <ul class="bt-list">{expertise.publics.map((p: string) => <li>{p}</li>)}</ul>
          <span class="bt-k" style="margin-top: 18px;"><svg class="ic" aria-hidden="true"><use href="#i-target"></use></svg>Thèmes travaillés</span>
          <div class="ex-chips">{expertise.sousThemes.map((t: string) => <span>{t}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <div class="facts">
    <div class="inner">
      <div class="facts-in">
        <div class="fact"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-users"></use></svg></span><div><b>{coachsBase.length}</b><span>{coachsSpecialises.length ? 'coachs spécialisés' : 'coachs du réseau'}</span></div></div>
        <div class="fact"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-pin"></use></svg></span><div><b>{sallesConcernees.size}</b><span>salles Basic-Fit</span></div></div>
        <div class="fact"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-home"></use></svg></span><div><b>{villesConcernees.length}</b><span>villes autour d'Orléans</span></div></div>
        <div class="fact"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-clock"></use></svg></span><div><b>1 h</b><span>de bilan santé pour démarrer</span></div></div>
      </div>
    </div>
  </div>

  <section class="sec">
    <div class="inner vb2">
      <div>
        <span class="eyebrow">En bref</span>
        <h2 class="h2">{expertise.nom} à Orléans en 30 secondes.</h2>
      </div>
      <ul class="vb-list">{enBref.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>

  {expertise.slug === 'preparation-physique' && (
    <section class="sec band" id="courses">
      <div class="inner">
        <span class="eyebrow">Préparation course et endurance</span>
        <h2 class="h2">Tu prépares une course ? Choisis ton épreuve.</h2>
        <div class="ex-course">
          {courseData.epreuves.map((c) => <a href={`/preparation-course/${c.slug}/`}><span aria-hidden="true">{c.emoji}</span><b>{c.nom}</b><svg class="ic" aria-hidden="true"><use href="#i-arrow"></use></svg></a>)}
        </div>
        <a class="btn-out" style="margin-top: 22px;" href="/preparation-course/">Toute la préparation course <svg class="ic" aria-hidden="true"><use href="#i-arrow"></use></svg></a>
      </div>
    </section>
  )}

  {expertise.concours && (
    <section class="sec band" id="concours">
      <div class="inner">
        <span class="eyebrow">Concours préparés</span>
        <h2 class="h2">Les concours que nous préparons.</h2>
        <p class="lead-p">{expertise.concoursIntro}</p>
        <div class="ex-conc">
          {expertise.concours.map((c: any) => (
            <article class="tile">
              <h3><span aria-hidden="true">{c.emoji}</span> {c.nom}</h3>
              <p class="ex-sous">{c.sous}</p>
              <span class="bt-k">Épreuves physiques</span>
              <ul class="bt-list">{c.epreuves.map((x: string) => <li>{x}</li>)}</ul>
              <p class="ex-point">{c.point}</p>
              <span class="bt-k">Notre préparation</span>
              <p>{c.prepa}</p>
              {c.source && <p class="src">Source : <a href={c.source.url} target="_blank" rel="noopener noreferrer">{c.source.nom}</a></p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {methodeExpertise && (
    <section class="sec navy">
      <div class="lightning-bg" aria-hidden="true"></div>
      <div class="inner">
        <span class="eyebrow">Comment ça se passe</span>
        <h2 class="h2">{expertise.slug === 'mal-de-dos' ? 'La méthode Renforcement Dos, étape par étape.' : 'Notre méthode, étape par étape.'}</h2>
        <ol class="ex-tl">
          {methodeExpertise.map((m, i) => <li><span class="ex-n">{i + 1}</span><div><h3>{m.titre}</h3><p>{m.texte}</p></div></li>)}
        </ol>
      </div>
    </section>
  )}

  {expertise.slug === 'mal-de-dos' && (
    <section class="sec band">
      <div class="inner">
        <span class="eyebrow">Concrètement, dans le geste</span>
        <h2 class="h2">Ce qui ne va pas, ce qu'il faut faire à la place.</h2>
        <p class="lead-p">Deux gestes du quotidien qui reviennent le plus souvent parmi les causes du mal de dos, montrés simplement : ce qui abîme le dos, et le bon réflexe à prendre à la place.</p>
        <div class="ex-sch">
          <div class="tile">
            <h3>Rester assis toute la journée</h3>
            <div class="ex-pair">
              <div class="ex-mv"><svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mauvaise posture : dos courbé, écran trop bas">
                <line x1="60" y1="220" x2="60" y2="180" stroke="#8A96B2" stroke-width="4" stroke-linecap="round"/>
                <line x1="60" y1="180" x2="150" y2="180" stroke="#8A96B2" stroke-width="4" stroke-linecap="round"/>
                <path d="M 90 180 Q 100 140 130 110 Q 145 95 160 85" stroke="#8A96B2" stroke-width="6" fill="none" stroke-linecap="round"/>
                <path d="M 115 130 Q 130 145 145 150" stroke="#8A96B2" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="168" cy="78" r="15" fill="#8A96B2"/>
                <line x1="90" y1="180" x2="88" y2="230" stroke="#8A96B2" stroke-width="6" stroke-linecap="round"/>
                <line x1="90" y1="180" x2="80" y2="230" stroke="#8A96B2" stroke-width="6" stroke-linecap="round"/>
                <line x1="150" y1="150" x2="210" y2="150" stroke="#5A6785" stroke-width="4" stroke-linecap="round"/>
              </svg><span>✕ Dos courbé, écran trop bas</span></div>
              <div class="ex-ok"><svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bonne posture : dos droit, écran à hauteur des yeux">
                <line x1="60" y1="220" x2="60" y2="180" stroke="#2F6FED" stroke-width="4" stroke-linecap="round"/>
                <line x1="60" y1="180" x2="150" y2="180" stroke="#2F6FED" stroke-width="4" stroke-linecap="round"/>
                <line x1="90" y1="180" x2="90" y2="90" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <path d="M 90 120 L 65 140" stroke="#2F6FED" stroke-width="4" fill="none" stroke-linecap="round"/>
                <path d="M 90 120 L 115 140" stroke="#2F6FED" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="90" cy="74" r="15" fill="#2F6FED"/>
                <line x1="90" y1="180" x2="88" y2="230" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <line x1="90" y1="180" x2="80" y2="230" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <line x1="150" y1="115" x2="210" y2="115" stroke="#1F55C9" stroke-width="4" stroke-linecap="round"/>
              </svg><span>✓ Dos droit, écran à hauteur des yeux</span></div>
            </div>
          </div>
          <div class="tile">
            <h3>Se baisser pour porter une charge</h3>
            <div class="ex-pair">
              <div class="ex-mv"><svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mauvaise posture : dos courbé pour porter une charge">
                <line x1="120" y1="230" x2="122" y2="180" stroke="#8A96B2" stroke-width="6" stroke-linecap="round"/>
                <line x1="120" y1="230" x2="130" y2="180" stroke="#8A96B2" stroke-width="6" stroke-linecap="round"/>
                <path d="M 122 180 Q 100 150 75 120 Q 65 108 55 100" stroke="#8A96B2" stroke-width="6" fill="none" stroke-linecap="round"/>
                <path d="M 90 140 L 55 150" stroke="#8A96B2" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="46" cy="94" r="15" fill="#8A96B2"/>
                <rect x="30" y="150" width="34" height="24" rx="3" fill="#5A6785"/>
              </svg><span>✕ Dos courbé pour porter</span></div>
              <div class="ex-ok"><svg viewBox="0 0 220 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bonne posture : jambes fléchies, dos droit pour porter une charge">
                <line x1="120" y1="230" x2="100" y2="195" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <line x1="120" y1="230" x2="140" y2="195" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <line x1="100" y1="195" x2="105" y2="150" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <line x1="140" y1="195" x2="115" y2="150" stroke="#2F6FED" stroke-width="6" stroke-linecap="round"/>
                <path d="M 110 150 L 100 105" stroke="#2F6FED" stroke-width="6" fill="none" stroke-linecap="round"/>
                <path d="M 108 130 L 70 150" stroke="#2F6FED" stroke-width="4" fill="none" stroke-linecap="round"/>
                <circle cx="96" cy="90" r="15" fill="#2F6FED"/>
                <rect x="46" y="150" width="34" height="24" rx="3" fill="#1F55C9"/>
              </svg><span>✓ Jambes fléchies, dos droit</span></div>
            </div>
          </div>
        </div>
        <p class="small-note">Ces schémas illustrent des principes généraux de bonne posture, pas un traitement adapté à ta situation précise. En cas de doute, ton médecin ou ton kinésithérapeute reste le mieux placé pour te conseiller.</p>
      </div>
    </section>
  )}

  {causesExpertise && (
    <section class="sec">
      <div class="inner">
        <span class="eyebrow">D'où ça vient</span>
        <h2 class="h2">{expertise.slug === 'mal-de-dos' ? 'Les causes les plus fréquentes du mal de dos.' : 'Pourquoi on en arrive là.'}</h2>
        <p class="lead-p">Il n'y a presque jamais une seule cause : le plus souvent, plusieurs facteurs s'accumulent avec le temps. En voici les plus fréquents, rencontrés chez les personnes que nous accompagnons.</p>
        <ul class="ex-causes">{causesExpertise.map((c) => { const [e, t] = emo(c); return <li><span aria-hidden="true">{e}</span>{t}</li>; })}</ul>
      </div>
    </section>
  )}

  {consequencesExpertise && (
    <section class="sec navy">
      <div class="lightning-bg" aria-hidden="true"></div>
      <div class="inner">
        <span class="eyebrow">Si rien ne change</span>
        <h2 class="h2">{expertise.slug === 'mal-de-dos' ? 'Ce que peut entraîner un mal de dos négligé.' : "Ce qu'entraîne l'inaction dans la durée."}</h2>
        <p class="lead-p ex-lead-d">On ne cherche pas à te faire peur, juste à être honnête. C'est pour éviter ou limiter ces effets qu'un accompagnement a du sens.</p>
        <div class="ex-cons">{consequencesExpertise.map((c) => { const [e, t] = emo(c); return <div><span aria-hidden="true">{e}</span><p>{t}</p></div>; })}</div>
        <a href="/score-sante/" class="sp-score">
          <span class="sp-score-ic" aria-hidden="true">🎯</span>
          <span>Tu te reconnais dans ces situations ? Fais ton Score Santé gratuit en 2 minutes pour faire le point, avant même de réserver un bilan.</span>
          <span class="sp-go" aria-hidden="true"><svg class="ic"><use href="#i-arrow"></use></svg></span>
        </a>
      </div>
    </section>
  )}

  {changementsExpertise && (
    <section class="sec">
      <div class="inner">
        <span class="eyebrow">Ce que le coaching change concrètement</span>
        <h2 class="h2">Ce que tu peux vraiment attendre d'un accompagnement.</h2>
        <div class="ex-chg">{changementsExpertise.map((c) => { const [e, t] = emo(c.titre); return <div class="tile"><span class="ex-emo" aria-hidden="true">{e}</span><h3>{t}</h3><p>{c.texte}</p></div>; })}</div>
      </div>
    </section>
  )}

  <section class="sec band">
    <div class="inner ex-two">
      {capacitesExpertise && (
        <div>
          <span class="eyebrow">Concrètement, dans ta vie</span>
          <h2 class="h2">Ce que tu vas pouvoir faire.</h2>
          <p class="lead-p">{expertise.slug === 'mal-de-dos' ? "Ce ne sont pas des promesses, mais ce que retrouvent le plus souvent les personnes qu'on accompagne, une fois le travail de fond engagé." : "Ce ne sont pas des promesses universelles, mais ce que retrouvent le plus souvent les personnes qu'on accompagne, à leur rythme."}</p>
          <ul class="bt-list ex-cap">{capacitesExpertise.map((c) => <li>Tu vas pouvoir {c.charAt(0).toLowerCase() + c.slice(1)}</li>)}</ul>
        </div>
      )}
      <div class="tile ex-ben">
        <span class="bt-k"><svg class="ic" aria-hidden="true"><use href="#i-check"></use></svg>Les bénéfices</span>
        <ul class="bt-list">{expertise.benefices.map((b: string) => <li>{b}</li>)}</ul>
        <a class="btn btn-primary" href="/score-sante/" style="margin-top: 22px;">Réserver mon bilan santé</a>
      </div>
    </div>
  </section>

  {statsExpertise && (
    <section class="sec">
      <div class="inner">
        <span class="eyebrow">{expertise.slug === 'sport-sante' ? 'Chez nous, en Centre-Val de Loire' : 'Pourquoi ce sujet compte'}</span>
        <h2 class="h2">Ce que montrent les chiffres.</h2>
        <div class="ex-stats">{statsExpertise.map((s) => <div class="tile"><b>{s.chiffre}</b><p>{s.description}</p><a class="src" href={s.url} target="_blank" rel="noopener noreferrer">Source : {s.source}</a></div>)}</div>
      </div>
    </section>
  )}

  {pathologiesExpertise && (
    <section class="sec band">
      <div class="inner">
        <span class="eyebrow">Ce qu'on rencontre souvent</span>
        <h2 class="h2">Les situations les plus fréquentes que nous accompagnons.</h2>
        <p class="lead-p">Ce n'est pas une liste de diagnostics : c'est un aperçu honnête des situations les plus courantes chez les personnes qui viennent nous voir. Le coach n'établit jamais de diagnostic, c'est le rôle exclusif d'un médecin. Notre travail porte sur le mouvement au quotidien, en complément du suivi médical, jamais à la place.</p>
        <div class="ex-path">{pathologiesExpertise.map((p) => { const [e, t] = emo(p.nom); return <div class="tile"><h3><span aria-hidden="true">{e}</span> {t}</h3><p>{p.description}</p><p class="ex-role"><b>Le rôle du coach :</b> {p.roleCoach}</p></div>; })}</div>
        <p class="small-note">En cas de doute, de douleur inhabituelle ou de pathologie diagnostiquée, la première étape est toujours d'en parler à un médecin. Le bilan avec un coach GA intervient en complément, jamais à la place, d'un avis médical.</p>
      </div>
    </section>
  )}

  {expertise.slug === 'sport-sante' && (
    <section class="sec" id="ehpad">
      <div class="inner">
        <div class="ex-ehpad">
          <div class="lightning-bg" aria-hidden="true"></div>
          <div>
            <span class="eyebrow eyebrow-dark">Pour les établissements</span>
            <h2 class="h2">Nous intervenons aussi en EHPAD et en maison de retraite.</h2>
            <p class="lead-p">Bouger aide à rester autonome à tout âge. Nos coachs animent des séances adaptées auprès des résidents d'EHPAD et de maisons de retraite : prévention des chutes, maintien de l'autonomie, bien-être, en lien avec votre équipe.</p>
          </div>
          <a href="/sport-sante/ehpad-maisons-de-retraite/" class="btn btn-primary">Découvrir l'offre EHPAD</a>
        </div>
      </div>
    </section>
  )}

  <section class={`sec ${expertise.slug === 'sport-sante' ? 'band' : ''}`} id="ex-coachs">
    <div class="inner">
      <span class="eyebrow">L'équipe</span>
      <h2 class="h2">{coachsSpecialises.length ? `Coachs spécialisés en ${expertise.nom.toLowerCase()}.` : 'Nos coachs.'}</h2>
      {coachsSpecialises.length > 0 ? (
        <div class="sp-coachs">
          {coachsSpecialises.map((c) => <CoachCard slug={c.slug} prenom={c.prenom} nom={c.nom} salleNom={salleParSlug[c.salleSlug]?.nom ?? ''} tags={c.tags} photo={c.photo} avisGoogle={c.avisGoogle} role={c.role} />)}
        </div>
      ) : (<><p class="lead-p">Les profils spécialisés dans ce domaine seront présentés ici prochainement. En attendant, le bilan santé permet de t'orienter vers le coach du réseau le plus adapté à ta situation.</p><div class="ctas" style="margin-top: 22px;"><a class="btn btn-primary" href="/score-sante/">Réserver mon bilan santé</a><a class="btn-out" href="/trouver-un-coach/">Voir les coachs du réseau <svg class="ic" aria-hidden="true"><use href="#i-arrow"></use></svg></a></div></>)}
    </div>
  </section>

  {expertise.slug === 'preparation-physique' && (
    <section class="sec navy">
      <div class="lightning-bg" aria-hidden="true"></div>
      <div class="inner">
        <span class="eyebrow">Un pôle GA Coachs dédié</span>
        <h2 class="h2">La préparation physique pour les clubs sportifs, tous sports confondus.</h2>
        <p class="lead-p ex-lead-d">Dans beaucoup de clubs, les athlètes s'entraînent à leur sport, mais personne ne suit réellement leur préparation physique : pas de programme structuré, pas de suivi individuel, pas d'adaptation aux exigences réelles de la discipline. GA Coachs développe un pôle dédié à ce sujet, ouvert à tous les clubs sportifs d'Orléans et sa métropole, pas seulement aux salles Basic-Fit du réseau.</p>
        <div class="ex-cl2">
          <div><b>Le constat</b><p>De nombreux clubs n'ont ni le temps ni les moyens d'assurer un suivi physique structuré de leurs athlètes, en dehors des entraînements techniques habituels.</p></div>
          <div><b>Notre réponse</b><p>Un programme de préparation physique construit avec le club, adapté aux exigences réelles du sport pratiqué, et suivi dans la durée par un coach du réseau.</p></div>
        </div>
        <span class="bt-k ex-k-d">Tous sports, tous niveaux</span>
        <div class="ex-sports">{sports.map((s) => <span>{s}</span>)}</div>
        <p class="ex-note-d">Et bien d'autres disciplines. Le programme s'adapte au sport, pas l'inverse.</p>
        <div class="ex-cl2" style="grid-template-columns: 1fr;">
          <div><b>Ce que nous observons</b><p>Au-delà des clubs, nous voyons de plus en plus de particuliers venir chercher une vraie préparation physique pour eux-mêmes, notamment à l'approche de l'été. Nous voyons aussi de plus en plus de parents investis dans le parcours sportif de leur enfant, parfois dans une logique qu'on surnomme familièrement le « mode projet Mbappé » : préparer sérieusement un jeune qui vise un niveau plus élevé dans son sport. Ce n'est pas une statistique nationale, seulement un constat de terrain chez GA Coachs.</p></div>
        </div>
        {clubsClients.length > 0 && (
          <div class="ex-proof"><span class="bt-k ex-k-d">Ils nous font déjà confiance</span><LogoMarquee items={clubsClients} /></div>
        )}
        <a href="/preparation-physique/clubs/" class="btn btn-primary" style="margin-top: 26px;">Découvrir le pôle clubs sportifs</a>
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="sec band">
      <div class="inner">
        <span class="eyebrow">Nos guides</span>
        <h2 class="h2">Pour aller plus loin sur le sujet.</h2>
        <div class="guides">
          {guides.map((a: any) => <a class="guide" href={`/blog/${a.slug}/`}><small>Guide{a.tempsLecture ? ` · ${a.tempsLecture} min` : ''}</small><b>{a.titre}</b><p>{a.extrait}</p><em>Lire le guide →</em></a>)}
        </div>
        {guidesPlus.length > 0 && <ul class="guides-plus">{guidesPlus.map((a: any) => <li><a href={`/blog/${a.slug}/`}>{a.titre}</a></li>)}</ul>}
      </div>
    </section>
  )}

  <BoostPCQ id={expertise.slug} />
  <section class="sec">
    <div class="inner">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2">Questions fréquentes.</h2>
      <div class="faq-list">{faqTout.map((f) => <details class="faq-item"><summary>{f.q}</summary><p>{f.r}</p></details>)}</div>
    </div>
  </section>

  <section class="sec band">
    <div class="inner">
      <h2 class="h2" style="font-size: 24px;">Disponible près de chez toi</h2>
      <div class="chips-row">
