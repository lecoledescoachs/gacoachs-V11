---
import SanteChiffres from '../../components/SanteChiffres.astro';
import BoostPCQ from '../../components/BoostPCQ.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/rb/Crumbs.astro';
import Icones from '../../components/rb/Icones.astro';
import articles from '../../data/articles.json';
import '../../styles/rebrand.css';
import CoachCard from '../../components/CoachCard.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import expertisesData from '../../data/expertises.json';
import { coachesReseau as coaches } from '../../data/coaches.js';
import salles from '../../data/salles.json';
import villes from '../../data/villes.json';
import objectifsData from '../../data/objectifs.json';
import clubsClients from '../../data/clubs-clients.json';
import courseData from '../../data/course.json';

export function getStaticPaths() {
  return expertisesData.map((e) => ({ params: { expertise: e.slug }, props: { expertise: e } }));
}

const { expertise } = Astro.props;
const salleParSlug = Object.fromEntries(salles.map((s) => [s.slug, s]));
const coachsSpecialises = coaches.filter((c) =>
  c.specialites.some((s: string) => expertise.sousThemes.includes(s)) || c.tags.some((t: string) => expertise.sousThemes.includes(t))
);

// Villes où cette expertise est réellement disponible (au moins un coach spécialisé rattaché)
const coachsBase = coachsSpecialises.length ? coachsSpecialises : coaches;
const sallesConcernees = new Set(coachsBase.map((c) => c.salleSlug));
const villesConcernees = villes.filter((v) => v.salleSlugs.some((s: string) => sallesConcernees.has(s)));

// Objectifs enfants de cette expertise, uniquement ceux réellement générés (au moins un coach rattaché)
const objectifsEnfants = objectifsData.filter(
  (o) => o.expertiseParente === expertise.slug && coaches.some((c) => c.tags.includes(o.sousTheme) || c.specialites.includes(o.sousTheme))
);

const relatedLinks = [
  ...objectifsEnfants.map((o) => ({ label: o.nom, href: `/objectifs/${o.slug}/`, meta: 'Objectif' })),
  ...villesConcernees.map((v) => ({ label: `${expertise.nom} à ${v.nom}`, href: `/coach-sportif-${v.slug}/`, meta: 'Disponible dans cette zone' })),
  { label: 'Toutes les expertises', href: '/#expertises', meta: 'Vue d\'ensemble' },
];

const methodeParExpertise: Record<string, { titre: string; texte: string }[]> = {
  'mal-de-dos': [
    { titre: 'Un premier échange sur ta situation', texte: "Ton historique, ta douleur actuelle, ce que ton médecin ou ton kiné a déjà indiqué : le point de départ, pas un questionnaire générique." },
