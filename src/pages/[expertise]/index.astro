  'coaching-sportif': [
    { titre: 'Le bilan santé, point de départ', texte: "Ton objectif réel, ton niveau actuel, tes contraintes de temps et d'emploi du temps : le programme part de ta situation, jamais d'un modèle standard." },
    { titre: 'Un programme construit pour toi', texte: "Perte de poids, prise de muscle, remise en forme : chaque objectif appelle une méthode différente. Ton coach construit une progression qui te ressemble." },
    { titre: 'Des séances en salle, avec un vrai suivi', texte: "Chaque séance s'appuie sur ce qui a fonctionné, ou pas, la fois précédente. Le programme évolue avec toi, pas l'inverse." },
    { titre: 'Des ajustements réguliers', texte: "Ton coach observe tes progrès, corrige ta technique, et adapte l'intensité selon ta forme du jour et ton évolution dans le temps." },
    { titre: 'Un objectif qui reste réaliste', texte: "Pas de promesse de résultat en un temps record : une progression mesurée, pensée pour durer au-delà des premières semaines." },
  ],
  'preparation-physique': [
    { titre: 'Un bilan de tes qualités physiques actuelles', texte: "Force, vitesse, endurance, mobilité : un point de départ précis, propre à ton sport et à ton niveau, pas un standard générique." },
    { titre: 'Une programmation adaptée à ta discipline', texte: "Les qualités à travailler pour un sportif de combat ne sont pas celles d'un coureur de fond. Le programme cible ce qui compte vraiment pour ta pratique." },
    { titre: 'Un travail calé sur ton calendrier sportif', texte: "Pré-saison, période de compétition, trêve : l'intensité et les objectifs s'ajustent selon le moment de la saison où tu te trouves." },
    { titre: 'Une prévention intégrée dès le départ', texte: "Le renforcement et la mobilité ne sont pas des options : ils font partie du programme pour réduire le risque de blessure, pas juste la performance pure." },
