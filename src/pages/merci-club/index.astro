---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MerciProto from '../../components/proto/MerciProto.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://gacoachs.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Demande envoyée', item: 'https://gacoachs.fr/merci-club/' },
  ],
};
---
<BaseLayout
  noindex={true}
  title="Demande envoyée · GA Coachs"
  description="Ta demande de préparation physique pour ton club a bien été envoyée à GA Coachs."
  path="/merci-club/"
  stickyCtaHref={false}
  jsonLd={jsonLd}
  image="/images/og-boost-club.jpg"
>
  <MerciProto v="club" />
</BaseLayout>


<script define:vars={{ evenement: 'boost_club_lead_envoye' }}>
  if (window.trackConversion) window.trackConversion(evenement);
</script>



