---
<BaseLayout
  title="BOOST CLUB : coach sportif et préparateur physique, clubs"
  description="BOOST CLUB : préparation physique externalisée pour les clubs sportifs à Orléans. Tests, programmation et suivi, diagnostic offert."
  path="/preparation-physique/clubs/"
  jsonLd={jsonLd}
  image="/images/og-boost-club.jpg"
  stickyCtaHref="#k-form"
  stickyCtaLabel="Demander mon diagnostic offert"
>
<div class="proto proto-club">
  <Contenu />
</div>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fr = (v: number, d: number) => v.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });
  const FORMS = [
    { label: 'Essentiel', prix: 390, f: 1 },
    { label: 'Performance', prix: 690, f: 2 },
    { label: 'Haute Performance', prix: 990, f: 3 },
  ];
  // Simulateur BOOST CLUB
  const host = document.getElementById('simClubPage');
  if (host) {
    const st = { n: 20, f: 1, c: 10 }, min = 8, max = 60, shown: any = { a: 0, b: 0, c: 0 };
    let raf = 0;
    const range = host.querySelector<HTMLInputElement>('.bsim-range')!, nOut = host.querySelector<HTMLElement>('[data-o="n"]')!;
    const people = host.querySelectorAll<SVGElement>('.crowd svg');
    const oa = host.querySelector<HTMLElement>('[data-o="a"]')!, ob = host.querySelector<HTMLElement>('[data-o="b"]')!, oc = host.querySelector<HTMLElement>('[data-o="c"]')!, ol = host.querySelector<HTMLElement>('[data-o="live"]')!;
    const ofin = host.querySelector<HTMLElement>('[data-o="fin"]')!, bar = host.querySelector<HTMLElement>('.fin-bar i')!;
    const paint = () => { oa.textContent = ol.textContent = fr(shown.a, 2); ob.textContent = fr(shown.b, 2) + ' €'; oc.textContent = fr(shown.c, 2) + ' €'; };
    function update(instant: boolean) {
      const F = FORMS[st.f], per = F.prix / (F.f * 4.33), got = st.c * st.n, pct = Math.min(100, Math.round((got / F.prix) * 100)), rest = Math.max(0, F.prix - got);
      const tgt: any = { a: F.prix / st.n, b: per, c: per / st.n }, from = { ...shown };
      cancelAnimationFrame(raf);
      if (instant || reduce) { Object.assign(shown, tgt); paint(); }
      else { let t0 = 0; const step = (now: number) => { if (!t0) t0 = now; const p = Math.min(1, (now - t0) / 450), e = 1 - Math.pow(1 - p, 3); for (const k in tgt) shown[k] = from[k] + (tgt[k] - from[k]) * e; paint(); if (p < 1) raf = requestAnimationFrame(step); }; raf = requestAnimationFrame(step); }
      bar.style.width = pct + '%';
      if (!st.c) ofin.innerHTML = 'Sans participation des licenciés, le club peut aussi s\'appuyer sur un partenaire local : « La préparation physique de l\'équipe, soutenue par [nom du partenaire] ».';
      else if (got >= F.prix) ofin.innerHTML = `Avec ${st.c} € par mois et par sportif, vos ${st.n} sportifs financent toute la formule : <b>${got} € réunis chaque mois</b>.`;
      else ofin.innerHTML = `Avec ${st.c} € par mois et par sportif, vos ${st.n} sportifs réunissent déjà <b>${got} € par mois</b>, soit ${pct} % de la formule. Il reste ${rest} € à financer par le club ou un partenaire local.`;
    }
    function setN(n: number, init = false) {
      n = Math.max(min, Math.min(max, Math.round(n)));
      st.n = n; range.value = String(n); range.style.setProperty('--p', (((n - min) / (max - min)) * 100).toFixed(1) + '%'); nOut.textContent = String(n);
      if (!init && !reduce) { nOut.classList.remove('bump'); void nOut.offsetWidth; nOut.classList.add('bump'); }
      people.forEach((p, i) => p.classList.toggle('on', i < n));
      update(init);
    }
    const radio = (b: Element) => b.parentElement!.querySelectorAll(':scope > *').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    range.addEventListener('input', () => setN(parseInt(range.value, 10)));
    host.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const s = t.closest<HTMLElement>('.bsim-step'); if (s) { setN(st.n + parseInt(s.dataset.d || '0', 10)); return; }
      const f = t.closest<HTMLElement>('.bsim-form'); if (f) { radio(f); st.f = parseInt(f.dataset.i || '0', 10); update(false); return; }
      const c = t.closest<HTMLElement>('.contrib button'); if (c) { radio(c); st.c = parseInt(c.dataset.c || '0', 10); update(false); }
    });
    setN(st.n, true);
    // demande de diagnostic depuis le simulateur : envoyée dans le formulaire Netlify « club-lead »
    const lb = host.querySelector<HTMLFormElement>('form.lead-box');
    lb?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = lb.querySelector<HTMLElement>('.lb-err')!, ok = lb.querySelector<HTMLElement>('.lb-ok')!;
      const club = (lb.elements.namedItem('club') as HTMLInputElement).value.trim(), contact = (lb.elements.namedItem('contact') as HTMLInputElement).value.trim();
      if (!club || !contact) { err.hidden = false; err.textContent = 'À compléter : le nom du club et un email ou un téléphone.'; return; }
      err.hidden = true;
      const mail = /@/.test(contact);
      const body = new URLSearchParams({ 'form-name': 'club-lead', club, nom_prenom: '-', discipline: '-', ville: '-', email: mail ? contact : '', telephone: mail ? '' : contact, nombre_sportifs: String(st.n), message: `Simulateur : ${st.n} sportifs, formule ${FORMS[st.f].label}, participation ${st.c} € par sportif` });
      try { await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() }); } catch (_) { /* rien */ }
      lb.querySelector<HTMLElement>('.lb-fields')!.hidden = true;
      ok.hidden = false; ok.textContent = `Merci ! Nous revenons vers vous rapidement pour préparer le diagnostic de ${club} (${st.n} sportifs, formule ${FORMS[st.f].label}).`; ok.focus();
    });
  }
  // Avant / avec BOOST CLUB
  let autoFam = true;
  const setFam = (f: Element, side: string) => { f.querySelector('.fam-ba')!.setAttribute('data-s', side); f.querySelectorAll('.fam-tabs button').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.s === side))); };
  document.getElementById('k-sports')?.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('.fam-tabs button'); if (b) { autoFam = false; setFam(b.closest('.fam')!, b.dataset.s!); } });
  if ('IntersectionObserver' in window && !reduce) {
    const fio = new IntersectionObserver((es) => es.forEach((en) => { if (!en.isIntersecting || !autoFam) return; fio.unobserve(en.target); setTimeout(() => { if (autoFam) setFam(en.target, 'avec'); }, 1600); }), { threshold: 0.6 });
    document.querySelectorAll('.proto-club .fam').forEach((f) => fio.observe(f));
  }
  // Image qui suit la souris
  document.querySelectorAll<HTMLElement>('.proto-club [data-tilt]').forEach((t) => {
    if (reduce) return;
    t.addEventListener('pointermove', (e) => { if (e.pointerType !== 'mouse') return; const r = t.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5; t.style.setProperty('--ry', (x * 10).toFixed(2) + 'deg'); t.style.setProperty('--rx', (-y * 8).toFixed(2) + 'deg'); });
    t.addEventListener('pointerleave', () => { t.style.setProperty('--ry', '0deg'); t.style.setProperty('--rx', '0deg'); });
  });
  // Sous-menu qui suit la lecture
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.proto-club .subnav a[href^="#k-"]:not(.subnav-cta)'));
  if ('IntersectionObserver' in window) {
    const spy = new IntersectionObserver((es) => es.forEach((en) => { if (!en.isIntersecting) return; links.forEach((a) => a.classList.toggle('is-on', a.getAttribute('href') === '#' + en.target.id)); }), { rootMargin: '-35% 0px -60% 0px' });
    links.forEach((a) => { const t = document.getElementById(a.getAttribute('href')!.slice(1)); if (t) spy.observe(t); });
  }
</script>
