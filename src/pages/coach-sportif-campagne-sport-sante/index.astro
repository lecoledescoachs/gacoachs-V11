<script>
  // Le lecteur TikTok ne se charge qu'au clic (pas de cookies TikTok avant)
  document.querySelectorAll<HTMLElement>('.bc-v[data-id]').forEach((li) => {
    const id = li.dataset.id; const bt = li.querySelector('button.bc-lire');
    if (!id || !bt) return;
    bt.addEventListener('click', () => {
      const f = li.querySelector('.bc-frame'); if (!f) return;
      f.innerHTML = `<iframe src="https://www.tiktok.com/player/v1/${id}?autoplay=1&music_info=0&description=0" title="Vidéo TikTok" allow="autoplay; fullscreen" allowfullscreen loading="lazy"></iframe>`;
    });
  });
</script>

