---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MerciProto from '../../components/proto/MerciProto.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://gacoachs.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Demande envoyée', item: 'https://gacoachs.fr/merci-bilan-demande/' },
  ],
};
---
<BaseLayout
  noindex={true}
  title="Demande envoyée · GA Coachs"
  description="Ta demande de bilan santé a bien été envoyée à GA Coachs."
  path="/merci-bilan-demande/"
  stickyCtaHref={false}
  jsonLd={jsonLd}
>
  <MerciProto v="bilan-demande" />
</BaseLayout>


<script>
  // le coach choisi sur la carte (?coach=Prénom) est nommé dans le message
  const c = (new URLSearchParams(location.search).get('coach') || '').trim().slice(0, 40);
  const p = document.querySelector('[data-merci-p]');
  if (c && p) p.textContent = c + " te recontacte très vite pour fixer l'horaire de ton bilan santé, dans ta salle Basic-Fit.";
</script>
<script define:vars={{ evenement: 'bilan_demande_envoyee' }}>
  if (window.trackConversion) window.trackConversion(evenement);
</script>



