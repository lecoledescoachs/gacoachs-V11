---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MerciProto from '../../components/proto/MerciProto.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://gacoachs.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Demande envoyée', item: 'https://gacoachs.fr/merci-entreprise/' },
  ],
};
---
<BaseLayout
  noindex={true}
  title="Demande envoyée · GA Coachs"
  description="Votre demande BOOST ENTREPRISE™ a bien été envoyée à GA Coachs."
  path="/merci-entreprise/"
  stickyCtaHref={false}
  jsonLd={jsonLd}
>
  <MerciProto v="entreprise" />
</BaseLayout>


<script define:vars={{ evenement: 'entreprise_lead_envoye' }}>
  if (window.trackConversion) window.trackConversion(evenement);
</script>



